msgstr[1] "papierowe gilzy"
msgstr[2] "papierowych gilz"
msgstr[3] "papierowej gilzy"

#. ~ Description for paper cartridge
#: lang/json/AMMO_from_json.py
msgid ""
"A paper cartridge containing black powder and a metallic projectile.  "
"Historically used to reload muzzleloaders in a more reasonable time."
msgstr ""
"Pocisk z papierową 'łuską' czyli gilzą właściwą, metalowym pociskiem i "
"czarnym prochem strzelniczym. Historycznie używany do przyspieszania "
"ładowania broni odprzodowej."

#: lang/json/AMMO_from_json.py
msgid "paper shot cartridge"
msgid_plural "paper shot cartridges"
msgstr[0] "papierowa gilza ze śrutem"
msgstr[1] "papierowe gilzy ze śrutem"
msgstr[2] "papierowych gilz ze śrutem"
msgstr[3] "papierowej gilzy ze śrutem"

#. ~ Description for paper shot cartridge
#: lang/json/AMMO_from_json.py
