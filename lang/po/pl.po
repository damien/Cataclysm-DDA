" dodatkowych"

#: lang/json/SPELL_from_json.py
msgid "Conjure Magical Throwing Blade I"
msgstr "Wyczaruj Magiczne Ostrze do Rzutów I"

#. ~ Description for Conjure Magical Throwing Blade I
#. ~ Description for Conjure Magical Throwing Blade Fire
#. ~ Description for Conjure Magical Throwing Blade Cold
#. ~ Description for Conjure Magical Throwing Blade Cut
