msgstr[0] "chusta na głowę"
msgstr[1] "chusta na głowę"
msgstr[2] "chusta na głowę"
msgstr[3] "chusta na głowę"

#. ~ Description for headscarf
#: lang/json/ARMOR_from_json.py
msgid "A loose cloth worn over the head and around the neck."
msgstr "Luźny materiał noszony na głowie i wokół szyi."

#: lang/json/ARMOR_from_json.py
