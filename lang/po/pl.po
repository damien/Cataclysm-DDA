msgid_plural "fruit-shaped anomalies"
msgstr[0] "owocokształtna anomalia"
msgstr[1] "owocokształtne anomalie"
msgstr[2] "owocokształtne anomalie"
msgstr[3] "owocokształtne anomalie"

#. ~ Description for fruit-shaped anomaly
#: lang/json/COMESTIBLE_from_json.py
msgid ""
"We do not exist at the moment.  Clever little human, no doubt debugging to "
"see this?  We will not permit you to join us while we are modded out."
msgstr ""
"W tej chwili nie istniejemy. Sprytny mały człowieczek, bez wątpienia "
"debuggował by to zobaczyć? Nie zezwolimy byś do nas dołączył gdy jesteśmy "
"modowane."

