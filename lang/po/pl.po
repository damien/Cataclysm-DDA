msgstr[2] "śrutów 00 do strzelby, czarnoprochowych, załadowanych złomem"
msgstr[3] "śrutu 00 do strzelby, czarnoprochowego, załadowanego złomem"

#: lang/json/AMMO_from_json.py
msgid "shotgun slug"
msgid_plural "shotgun slugs"
msgstr[0] "breneka do strzelby"
msgstr[1] "breneki do strzelby"
msgstr[2] "brenek do strzelby"
msgstr[3] "breneki do strzelby"

#. ~ Description for shotgun slug
#: lang/json/AMMO_from_json.py
msgid ""
"A heavy metal slug used with shotguns to give them the range capabilities of"
" a rifle.  Extremely damaging but rather inaccurate."
msgstr ""
"Ciężka metalowa breneka w naboju do strzelby zapewnia jej zasięg "
"porównywalny z karabinem. Zadaje poważne obrażenia, ale jest niecelny. "
"Najlepiej się sprawdza w gwintowanej lufie."

#: lang/json/AMMO_from_json.py
msgid "birdshot paper cartridge"
msgid_plural "birdshot paper cartridges"
msgstr[0] "śrut do strzelby w papierowej gilzie"
msgstr[1] "śruty do strzelby w papierowej gilzie"
msgstr[2] "śrutów do strzelby w papierowej gilzie"
msgstr[3] "śrutu do strzelby w papierowej gilzie"

#. ~ Description for birdshot paper cartridge
#: lang/json/AMMO_from_json.py
msgid ""
"A paper cartridge containing a premeasured amount of black powder and an "
"equal volume of birdshot.  Used mostly for hunting small game or fowl."
msgstr ""
"Papierowa łuska (gilza) zawierająca odmierzoną porcje prochu strzelniczego i"
" równą mu ilość śrutu. Używana głównie do polowania na drobnego zwierza lub "
"ptactwo."

#: lang/json/AMMO_from_json.py
msgid "pyrotechnic paper cartridge"
msgid_plural "pyrotechnic paper cartridges"
