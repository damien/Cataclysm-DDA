msgid ""
"This survivor has some formal training in psychology, but not much "
"experience."
msgstr ""
"Ten ocalony posiada nieco formalnego wykształcenia w psychologii, ale "
"niewiele doświadczenia."

#: lang/json/mutation_from_json.py
msgid "Psychology Expert"
msgstr "Ekspert w psychologii"

#. ~ Description for {'str': 'Psychology Expert'}
#: lang/json/mutation_from_json.py
msgid ""
"This survivor has extensive experience in psychology, a PhD or equivalent."
msgstr ""
"Ten ocalony posiada znaczne doświadczenie w psychologii, stopień doktora lub"
" jego ekwiwalent."

#: lang/json/mutation_from_json.py
msgid "Sanitation Training"
msgstr "Wyszkolenie w sanitaryzacji."

#. ~ Description for {'str': 'Sanitation Training'}
#: lang/json/mutation_from_json.py
msgid ""
"This survivor has some formal training in sanitation, but not much "
"experience."
msgstr ""
"Ten ocalony posiada nieco formalnego wykształcenia w sanitaryzacji, ale "
"niewiele doświadczenia."

#: lang/json/mutation_from_json.py
msgid "Sanitation Expert"
msgstr "Ekspert w sanitaryzacji"

#. ~ Description for {'str': 'Sanitation Expert'}
#: lang/json/mutation_from_json.py
msgid "This survivor has extensive experience in sanitation."
msgstr "Ten ocalony posiada znaczne doświadczenie w sanitaryzacji."

#: lang/json/mutation_from_json.py
msgid "Teaching Training"
msgstr "Wyszkolenie w nauczaniu"

#. ~ Description for {'str': 'Teaching Training'}
#: lang/json/mutation_from_json.py
msgid ""
"This survivor has some formal training in teaching, but not much experience."
msgstr ""
"Ten ocalony posiada nieco formalnego wykształcenia w nauczaniu, ale niewiele"
" doświadczenia."

#: lang/json/mutation_from_json.py
msgid "Teaching Expert"
msgstr "Ekspert w nauczaniu"

#. ~ Description for {'str': 'Teaching Expert'}
#: lang/json/mutation_from_json.py
msgid ""
"This survivor has extensive experience in teaching, a PhD or equivalent."
msgstr ""
"Ten ocalony posiada znaczne doświadczenie w nauczaniu, stopień doktora lub "
"jego ekwiwalent."

#: lang/json/mutation_from_json.py
msgid "Veterinary Training"
msgstr "Wyszkolenie w weterynarii"

#. ~ Description for {'str': 'Veterinary Training'}
#: lang/json/mutation_from_json.py
msgid ""
"This survivor has some formal training in veterinary medicine, but not much "
"experience."
msgstr ""
"Ten ocalony posiada nieco formalnego wykształcenia w weterynarii, ale "
"niewiele doświadczenia."

#: lang/json/mutation_from_json.py
msgid "Veterinary Expert"
msgstr "Ekspert w weterynarii"

#. ~ Description for {'str': 'Veterinary Expert'}
#: lang/json/mutation_from_json.py
msgid ""
"This survivor has extensive experience in veterinary medicine, a DVM or "
"equivalent."
msgstr ""
"Ten ocalony posiada znaczne doświadczenie w weterynarii; doktor weterynarii "
"lub jego ekwiwalent."

#: lang/json/mutation_from_json.py
msgid "Mark of the Seer"
msgstr "Znak widzącego"

#. ~ Description for {'str': 'Mark of the Seer'}
#: lang/json/mutation_from_json.py
msgid "A strange occult symbol carved into your hand by Brigitte LaCroix."
msgstr ""
"Dziwny okultystyczny symbol wyrzeźbiony w twojej dłoni przez Brigitte "
"LaCroix."

#: lang/json/mutation_from_json.py
msgid "PrepNet Tag"
msgstr "Tag PrepNet"

#. ~ Description for {'str': 'PrepNet Tag'}
#: lang/json/mutation_from_json.py
msgid ""
"NPC trait that makes monsters see it as a Prepnet.  It is a bug if you have "
"it."
msgstr ""
"Cecha NPC która sprawia, że potwory widzą to jako Prepnet. To bug, jeśli to "
"masz."

#: lang/json/mutation_from_json.py
msgid "Killophant"
msgstr "Killofant"

#. ~ Description for {'str': 'Killophant'}
#: lang/json/mutation_from_json.py
msgid ""
"Your species was created as the ultimate shock troop.  Inherit the earth, "
"pedigree your ancestors, crush the foe."
msgstr ""
"Twój gatunek został stworzony jako ostateczny oddział uderzeniowy. "
"Odziedzicz ziemię, kontynuuj dzieło swoich przodków, zmiażdż wroga."

#: lang/json/mutation_from_json.py
msgid "Mi-go acclimatization"
msgstr "Aklimatyzacja mi-go"

#. ~ Description for Mi-go acclimatization
#: lang/json/mutation_from_json.py
msgid ""
"Fleshy fronds grown from your scalp function like organic heat sinks.  They "
"allow you to live comfortably within the mi-go atmosphere."
msgstr ""
"Mięsiste liście wyrastające z twojej skóry głowy działają jak organiczne "
"radiatory. Pozwalają wygodnie żyć w atmosferze mi-go."

#: lang/json/mutation_from_json.py
msgid "Facial Tentacles"
msgstr "Macki na twarzy"

#: lang/json/mutation_from_json.py
msgid "Mouth Tendrils"
msgstr "Wicie w ustach"

#: lang/json/mutation_from_json.py
msgid "Warm Natured"
msgstr "Ciepłolubność"

#. ~ Description for Warm Natured
#: lang/json/mutation_from_json.py
msgid ""
"Your body becomes much more efficient at distributing heat from itself."
msgstr ""
"Twoje ciało staje się znacznie wydajniejsze w rozprowadzaniu ciepła z "
"siebie."

#: lang/json/mutation_from_json.py
msgid "Neural Improvement"
msgstr "Naturalne usprawnienia"

#. ~ Description for Neural Improvement
#: lang/json/mutation_from_json.py
msgid "You see the world a little differently today.  Intelligence + 1"
msgstr "Dziś widzisz świat trochę inaczej. Inteligencja +1"

#: lang/json/mutation_from_json.py
msgid "Expanded Consciousness"
msgstr "Rozszerzona świadomość"

#. ~ Description for Expanded Consciousness
#: lang/json/mutation_from_json.py
msgid "You are beginning to see a way off this planet.  Intelligence + 2"
msgstr "Zaczynasz widzieć wyjście z tej planety. Inteligencja +2"

#. ~ Description for Extremely Smart
#: lang/json/mutation_from_json.py
msgid ""
"As humans uplifted our pets in the final years this process is lifting you "
"to a new level of intelligence.  Intelligence + 4"
msgstr ""
"Ponieważ ludzie unieśli nasze zwierzęta w ostatnich latach, ten proces "
"wznosi was na nowy poziom inteligencji. Inteligencja +4"

#: lang/json/mutation_from_json.py
msgid "Alien Intelligence"
msgstr "Kosmiczna inteligencja"

#. ~ Description for Alien Intelligence
#: lang/json/mutation_from_json.py
msgid ""
"You can see the connections from A to B to C to D.  You look at fellow "
"survivors like you are imagining taking them apart.  Intelligence + 5"
msgstr ""
"Możesz zobaczyć połączenia od A do B do C do D. Patrzysz na innych ocalałych"
" tak jak wyobrażasz sobie rozkładanie ich na części. Inteligencja +5"

#: lang/json/mutation_from_json.py
msgid "Enhanced Reactions"
msgstr "Rozszerzone reakcje"

#. ~ Description for Enhanced Reactions
#: lang/json/mutation_from_json.py
msgid "Today is the day to start juggling.  Dexterity + 1"
msgstr "Dziś jest dzień, w którym trzeba zacząć żonglować. Zręczność +1"

#: lang/json/mutation_from_json.py
msgid "Quickening"
msgstr "Przyspieszenie"

#. ~ Description for Quickening
#: lang/json/mutation_from_json.py
msgid "You are starting to move like they do.  Dexterity + 2"
msgstr "Zaczynasz się poruszać tak jak oni. Zręczność +2"

#: lang/json/mutation_from_json.py
msgid "Otherworldly Grace"
msgstr "Gracja z innego świata"

#. ~ Description for Otherworldly Grace
#: lang/json/mutation_from_json.py
msgid ""
"You no longer move like a human, others find it disconcerting.  Dexterity + "
"4"
msgstr ""
"Nie poruszasz się już jak człowiek, inni uważają to za niepokojące. "
"Zręczność +4"

#: lang/json/mutation_from_json.py
msgid "New Muscles"
msgstr "Nowe mięśnie"

#. ~ Description for New Muscles
#: lang/json/mutation_from_json.py
msgid ""
"You see some new muscles that you aren't sure you've seen on humans before."
"  Strength + 1"
msgstr ""
"Widzisz nowe mięśnie, których wcześniej nie widziałeś u ludzi. Siła +1"

#: lang/json/mutation_from_json.py
msgid "Muscle Fiber"
msgstr "Włókno mięśniowe"

#. ~ Description for Muscle Fiber
#: lang/json/mutation_from_json.py
msgid "Fibrous tissue seems to be spreading through your body.  Strength + 2"
msgstr ""
"Wydaje się, że tkanka włóknista rozprzestrzenia się po twoim ciele. Siła +2"

#: lang/json/mutation_from_json.py
msgid "Mi-go Ears"
msgstr "Uszy mi-go"

#. ~ Description for Mi-go Ears
#: lang/json/mutation_from_json.py
msgid ""
"Your ears have split into a series of tuberous projections.  They waggle "
"towards far away sounds."
msgstr ""
"Twoje uszy podzieliły się na serię bulwiastych projekcji. Kiwają się w "
"stronę odległych dźwięków."

#: lang/json/mutation_from_json.py
msgid "Detachment"
msgstr "Oderwanie"

#. ~ Description for Detachment
#: lang/json/mutation_from_json.py
msgid ""
"When were you ever like these creatures, helpless before the changes "
"ravaging this world."
msgstr ""
"Kiedy byłeś jak te stworzenia, bezradny wobec zmian niszczących ten świat."

#: lang/json/mutation_from_json.py
msgid "Eldritch"
msgstr "Złowrogość"

#. ~ Description for Eldritch
#: lang/json/mutation_from_json.py
msgid ""
"You have a sinister aspect to your demeanor, no longer part of this world.  "
"You feel no sorrow at the deaths of humans and your brain now processes "
"combat skills more efficiently as you mentally dissect your opponents."
msgstr ""
"Masz złowieszczy aspekt twojego zachowania, który nie jest już częścią tego "
"świata. Nie odczuwasz smutku z powodu śmierci ludzi, a twój mózg efektywniej"
" przetwarza teraz umiejętności bojowe, gdy mentalnie robisz sekcję swoich "
"przeciwników."

#. ~ Description for YUGGOTH
#: lang/json/mutation_from_json.py
msgid "This death throes of this world are the birthing pangs of yours."
msgstr "Te drgawki śmierci tego świata są twoimi bólami porodowymi."

#: lang/json/mutation_from_json.py
msgid "Fetid scent"
msgstr "Cuchnący zapach"

#. ~ Description for Fetid scent
#: lang/json/mutation_from_json.py
msgid ""
"Your sweat now smells otherworldly, and not in a good way.  The mi-go still "
"hate you but at least they aren't offended by your smell."
msgstr ""
"Twój pot teraz pachnie jak nie z tego świata i to nie w dobrym tego słowa "
"znaczeniu. Mi-go nadal cię nienawidzą, ale przynajmniej nie są zdegustowani "
"twoim zapachem."

#: lang/json/mutation_from_json.py
msgid "Eerie"
msgstr "Straszliwość"

#. ~ Description for Eerie
#: lang/json/mutation_from_json.py
msgid ""
"You are off-putting to others.  Your mannerisms have changed as if human "
"interaction is becoming foreign."
msgstr ""
"Zrażasz innych. Twoje maniery zmieniły się, jakby interakcje międzyludzkie "
"stały się obce."

#: lang/json/mutation_from_json.py
msgid "Mi-go Wings"
msgstr "Skrzydła mi-go"

#. ~ Description for Mi-go Wings
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of large, veiny wings.  They don't appear to be made for "
"this atmosphere but they grant a powerful buffeting attack."
msgstr ""
"Masz parę dużych, żylastych skrzydeł. Nie wydają się być stworzone dla tej "
"atmosfery, ale zapewniają potężny sponiewierający atak."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You buffet %s with your wings"
msgstr "Poniewierasz %s swoimi skrzydłami"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s buffets %2$s with their wings"
msgstr "%1$s sponiewiera %2$s swoimi skrzydłami"

#: lang/json/mutation_from_json.py
msgid "Mi-go breathe"
msgstr "Oddech mi-go"

#. ~ Description for Mi-go breathe
#: lang/json/mutation_from_json.py
msgid "You can now breathe the gasses the mi-go thrive in."
msgstr "Możesz teraz wdychać gazy, z których korzystają mi-go."

#: lang/json/mutation_from_json.py
msgid "Uplifted"
msgstr "Wzniesienie"

#. ~ Description for Uplifted
#: lang/json/mutation_from_json.py
msgid ""
"You come from uplifted animal stock.  This decreases morale penalties for "
"being wet."
msgstr "Pochodzisz z wzniesionego bydła. Redukuje to kary za przemoczenie."

#: lang/json/mutation_from_json.py
msgid "Hauler"
msgstr "Dźwigacz"

#. ~ Description for Hauler
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You are capable of carrying far more than someone with similar strength "
"could.  Your maximum weight carried is increased by 60%."
msgstr ""
"Jesteś w stanie unieść znacznie więcej niż ktoś o podobnej sile. Twój "
"maksymalny udźwig jest większy o 60%."

#: lang/json/mutation_from_json.py
msgid "Patched Fur"
msgstr "Połatane futro"

#. ~ Description for Patched Fur
#: lang/json/mutation_from_json.py
msgid ""
"Your skin has patches of light fur.  This has no impact on your life except "
"marking you as not fully human."
msgstr ""
"Twoja skóra ma łatki lekkiego futra. Nie ma to wpływu na twoje życie, z "
"wyjątkiem oznaczenia cię jako nie w pełni człowieka."

#: lang/json/mutation_from_json.py
msgid "Crushing Feet"
msgstr "Miażdżące stopy"

#. ~ Description for Crushing Feet
#: lang/json/mutation_from_json.py
msgid ""
"Your feet have grown massive and ready to support huge weight.  This allows "
"kicking attacks to do much more damage, provides natural armor, and removes "
"the need to wear shoes; however, you cannot wear normal size shoes.  Reduces"
" wet effects."
msgstr ""
"Twoje stopy urosły do masywnych rozmiarów, gotowe utrzymać ogromny ciężar. "
"Pozwala to by kopnięcia zadawały znacznie więcej obrażeń, zapewniają "
"naturalną zbroję i usuwają potrzebę noszenia butów; jednakże nie możesz już "
"nosić obuwia w normalnych rozmiarach. Redukuje efekty przemoczenia."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You kick %s with your massive feet"
msgstr "Kopiesz %s swoimi masywnymi stopami"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s kicks %2$s with their massive feet"
msgstr "%1$s kopie %2$s swoimi masywnymi stopami"

#: lang/json/mutation_from_json.py
msgid "Face Bumps"
msgstr "Guzy na twarzy"

#. ~ Description for Face Bumps
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of bumps on your face above your mouth and beside your nose."
msgstr "Masz parę guzków na twarzy nad ustami i obok nosa."

#: lang/json/mutation_from_json.py
msgid "Tusks"
msgstr "Kły"

#. ~ Description for Tusks
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of small tusks on your face.  They allow you to make a weak "
"piercing goring attack."
msgstr ""
"Masz parę małych kłów na twarzy. Pozwalają na wykonanie słabego, "
"przeszywającego ataku."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You gore %s with your tusks"
msgstr "Przeszywasz %s swoimi kłami"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s gores %2$s with their tusks"
msgstr "%1$s przeszywa %2$s jego kłami"

#: lang/json/mutation_from_json.py
msgid "Pointed Tusks"
msgstr "Spiczaste kły"

#. ~ Description for Pointed Tusks
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of long, pointed tusks, like someone weaponized an elephant."
"  They allow you to make a strong piercing headbutt attack, but prevent "
"wearing mouthgear that is not made of fabric."
msgstr ""
"Masz parę długich, spiczastych kłów, jakby ktoś uzbroił słonia. Pozwalają ci"
" na mocny, przebijający atak z główki, ale uniemożliwiają noszenie na ustach"
" sprzętów, które nie są wykonane z materiału."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You stab %s with your pointed tusks"
msgstr "Kłujesz %s swoimi spiczastymi kłami"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s stabs %2$s with their pointed tusks"
msgstr "%1$s kłuje %2$s jego spiczastymi kłami"

#: lang/json/mutation_from_json.py
msgid "Elephant Trunk"
msgstr "Trąba słonia"

#. ~ Description for {'str': 'Elephant Trunk'}
#: lang/json/mutation_from_json.py
msgid ""
"Your face resembles that of an elephant, with a significant trunk.  It looks"
" fierce but prevents wearing mouthgear.  Prehensile and able to perform some"
" fine detail work."
msgstr ""
"Twoja twarz przypomina twarz słonia ze znaczną trąbą. Wygląda groźnie, ale "
"uniemożliwia noszenie sprzętu na ustach. Chwytne i zdolne do wykonywania "
"drobnych szczegółowych prac."

#: lang/json/mutation_from_json.py
msgid "Three Fingered"
msgstr "Trójpalczastość"

#. ~ Description for Three Fingered
#: lang/json/mutation_from_json.py
msgid ""
"Your hands have fused into three fingered paws.  Fine manipulation is a "
"challenge: permanent hand encumbrance of 10, difficulty with delicate "
"craftwork, and your gloves don't fit.  But they handle water better."
msgstr ""
"Twoje ręce przekształciły się w trzy-palczaste łapy. Drobiazgowa manipulacja"
" to wyzwanie: stałe skrępowanie rąk 10, trudności z delikatnymi robótkami i "
"twoje rękawice nie pasują. Za to lepiej radzą sobie z wodą."

#: lang/json/mutation_from_json.py
msgid "Trumpeting Voice"
msgstr "Trąbiący głos"

#. ~ Description for Trumpeting Voice
#: lang/json/mutation_from_json.py
msgid ""
"You have a trumpeting, elephantine voice.  Threatening NPCs will be easier, "
"but lying will be very hard."
msgstr ""
"Masz trąbiący, słoniowaty głos. Zastraszanie NPC będzie łatwiejsze, ale "
"kłamstwo będzie bardzo trudne."

#: lang/json/mutation_from_json.py
msgid "Brutal Strength"
msgstr "Brutalna siła"

#. ~ Description for {'str': 'Brutal Strength'}
#: lang/json/mutation_from_json.py
msgid "Genetic tampering made your body incredibly strong.  Strength + 7."
msgstr ""
"Manipulacje genetyczne zrobiły twoje ciało niesamowicie silne. Siła +7."

#: lang/json/mutation_from_json.py
msgid "Cryoadaptation"
msgstr "Krioadaptacja"

#. ~ Description for {'str': 'Cryoadaptation'}
#: lang/json/mutation_from_json.py
msgid ""
"An experimental cryosleep procedure has permanently altered your body, "
"allowing you to better tolerate cold temperatures."
msgstr ""
"Eksperymentalna procedura snu kriogenicznego trwale zmieniła twoje ciało, "
"pozwalając ci lepiej tolerować niskie temperatury."

#: lang/json/mutation_from_json.py
msgid "Alpine Conditioning"
msgstr "Alpinistyczne chłodzenie"

#. ~ Description for {'str': 'Alpine Conditioning'}
#: lang/json/mutation_from_json.py
msgid ""
"Time spent in high altitudes and low temperatures have adapted you to them, "
"and you're slightly better at resisting the cold."
msgstr ""
"Czas spędzony na dużych wysokościach i w niskich temperaturach przystosował "
"cię do nich i nieco lepiej radzisz sobie z zimnem."

#. ~ Description for {'str': 'Brutal Strength'}
#: lang/json/mutation_from_json.py
msgid "Genetic defects have made your body incredibly strong.  Strength + 7."
msgstr ""
"Wady genetyczne sprawiły, że twoje ciało jest niesamowicie silne. Siła +7."

#: lang/json/mutation_from_json.py
msgid "Leathered Feet"
msgstr "Skórzane stopy"

#. ~ Description for Leathered Feet
#: lang/json/mutation_from_json.py
msgid ""
"The bottoms of your feet are tough like an animals.  You receive no movement"
" penalty for not wearing shoes."
msgstr ""
"Podeszwy twoich stóp są twarde jak u zwierząt. Nie otrzymujesz żadnej kary "
"ruchu za nie noszenie butów."

#: lang/json/mutation_from_json.py
msgid "Skinfolds"
msgstr "Płaty skórne"

#. ~ Description for Skinfolds
#: lang/json/mutation_from_json.py
msgid ""
"Your skin is tough.  Cutting damage is slightly reduced for you.  Slightly "
"decreases wet penalties."
msgstr ""
"Twoja skóra jest twarda. Obrażenia cięte są u ciebie zredukowane. "
"Nieznacznie redukuje kary za bycie mokrym."

#: lang/json/mutation_from_json.py
msgid "Weak Joints"
msgstr "Słabe stawy"

#. ~ Description for {'str': 'Weak Joints'}
#: lang/json/mutation_from_json.py
msgid ""
"A common flaw in your genemod, brought on by increased muscle mass and bone "
"density.  Moving over rough terrain will slow you down more than normal."
msgstr ""
"Częsta wada w twoim genie, spowodowana wzrostem masy mięśniowej i gęstości "
"kości. Poruszanie się po trudnym terenie zabiera ci więcej czasu niż zwykle."

#: lang/json/mutation_from_json.py
msgid "Herbivorous Ancestry"
msgstr "Roślinożerne korzenie"

#. ~ Description for Strong Scent
#: lang/json/mutation_from_json.py
msgid ""
"Your scent is particularly strong.  It's vaguely offensive to humans, and "
"animals that track your scent will do so more easily."
msgstr ""
"Twój zapach jest szczególnie silny. Jest nieco drażniący dla ludzi i "
"zwierzęta, które śledzą twój zapach, będą mogły zrobić to z łatwością."

#: lang/json/mutation_from_json.py
msgid "Giant Step"
msgstr "Ogromny krok"

#: lang/json/mutation_from_json.py
msgid "Slow and Steady"
msgstr "Powolnie i spokojnie"

#. ~ Description for Slow and Steady
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You can't move as fast as most, resulting in a 10% speed penalty on flat "
"ground."
msgstr ""
"Nie możesz chodzić tak szybko jak inni, w skutek czego twoja prędkość jest o"
" 10% niższa na równej powierzchni."

#: lang/json/mutation_from_json.py
msgid "Short Fur Coat"
msgstr "Krótki futrzany płaszcz"

#. ~ Description for {'str': 'Short Fur Coat'}
#: lang/json/mutation_from_json.py
msgid ""
"Short fur has grown to cover your entire body, providing slight protection "
"from cold."
msgstr ""
"Krótkie futro porasta całe twoje ciało, zapewniając lekką ochronę przed "
"chłodem."

#. ~ Description for {'str': 'Furry'}
#: lang/json/mutation_from_json.py
msgid ""
"Thick brown fur has grown to cover your entire body, providing a slight "
"protection against attacks, and some protection from cold."
msgstr ""
"Gęsto brązowe futro porasta całe twoje ciało, zapewniając lekką ochronę "
"przed atakami i trochę ochrony przed chłodem."

#: lang/json/mutation_from_json.py
msgid "Immovable"
msgstr "Nieprzesuwalność"

#: lang/json/mutation_from_json.py
msgid "Unstoppable"
msgstr "Nie do zatrzymania"

#: lang/json/mutation_from_json.py
msgid "Meatshield"
msgstr "Żywa tarcza"

#: lang/json/mutation_from_json.py
msgid "Elephantine"
msgstr "Słoniowatość"

#: lang/json/mutation_from_json.py
msgid "Freakishly Gigantic"
msgstr "Dziwaczna gigantyczność"

#: lang/json/mutation_from_json.py
msgid "Gigantic"
msgstr "Gigantyczność"

#: lang/json/mutation_from_json.py
msgid "Terrible Odor"
msgstr "Okropny odór"

#. ~ Description for Terrible Odor
#: lang/json/mutation_from_json.py
msgid ""
"You smell exactly like a shaggy elephant would, assuming it sweated, which "
"you do.  Monsters that track scent will find you very easily, and humans "
"will react poorly."
msgstr ""
"Cuchniesz dokładnie jak cuchnąłby kudłaty słoń, zakładając, że spocił by się"
" tak jak ty. Potwory, które podążają za zapachem bardzo łatwo cię znajdują, "
"a ludzie źle na ciebie reagują."

#: lang/json/mutation_from_json.py
msgid "Constant Eater"
msgstr "Nieustające jedzenie"

#: lang/json/mutation_from_json.py
msgid "Large Diet"
msgstr "Duża dieta"

#. ~ Description for Large Diet
#: lang/json/mutation_from_json.py
msgid ""
"You require more food than others but your ability to go the distance in "
"both combat and athleticism is expanded."
msgstr ""
"Potrzebujesz więcej jedzenia niż inni, ale twoja zdolność do pokonywania "
"dystansu zarówno w walce, jak i atletyce jest rozszerzona."

#. ~ Description for High Thirst
#: lang/json/mutation_from_json.py
msgid ""
"Your body needs more water than usual to flush the denser waste products."
msgstr ""
"Twoje ciało potrzebuje więcej wody niż zwykle, aby zużyć bardziej gęste "
"produkty przemiany materii."

#: lang/json/mutation_from_json.py
msgid "Giant Thirst"
msgstr "Olbrzymie pragnienie"

#. ~ Description for Ponderous
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your weight must be delicately placed lest the ground give way.  You move "
"10% slower."
msgstr ""
"Twoja waga musi być delikatnie rozłożona, aby ziemia nie ustąpiła. Poruszasz"
" się o 10% wolniej."

#: lang/json/mutation_from_json.py
msgid "Very Deliberate"
msgstr "Bardzo przemyślane"

#. ~ Description for Very Deliberate
#: lang/json/mutation_from_json.py
#, no-python-format
msgid "Your muscles are quite slow to move.  You move 25% slower."
msgstr "Twoje mięśnie ruszają się wolniej. Poruszasz się 25% wolniej."

#: lang/json/mutation_from_json.py
msgid "Whately Story"
msgstr "Historia Whately"

#: lang/json/mutation_from_json.py
msgid "Sadie Story"
msgstr "Historia Sadie"

#: lang/json/mutation_from_json.py
msgid "CRIT Melee Training"
msgstr "Szkolenie walki wręcz CRIT"

#. ~ Description for CRIT Melee Training
#: lang/json/mutation_from_json.py
msgid ""
"You have received CQB training.  For every hit you land, gain themed combat "
"bonuses."
msgstr ""
"Ukończyłeś szkolenie walki na bliskim dystansie. Za każde trafienie "
"otrzymasz tematyczne premie do walki."

#: lang/json/mutation_from_json.py
msgid "Shadow Meld"
msgstr "Wtapianie się w cień"

#. ~ Description for Shadow Meld
#: lang/json/mutation_from_json.py
msgid ""
"The light around you bends strangely, making it harder for enemies to notice"
" you."
msgstr ""
"Światło wokół ciebie dziwnie się ugina, utrudniając wrogom zauważenie "
"ciebie."

#: lang/json/mutation_from_json.py
msgid "Moon-lit Grace"
msgstr "Księżycowa gracja"

#. ~ Description for Moon-lit Grace
#: lang/json/mutation_from_json.py
msgid ""
"Aside from your appearances, your movements are incredibly graceful and "
"allow you to seemingly glide through every task."
msgstr ""
"Poza twoim wyglądem, twoje ruchy są niezwykle wdzięczne i pozwalają ci lekko"
" prześliznąć się przez każde zadanie."

#: lang/json/mutation_from_json.py
msgid "Red Iris"
msgstr "Czerwone tęczówki"

#. ~ Description for Red Iris
#: lang/json/mutation_from_json.py
msgid ""
"You eyes are a pleasant shade of hypnotic scarlet.  People feel mildly "
"persuaded by you."
msgstr ""
"Twoje oczy mają przyjemny odcień hipnotycznego szkarłatu. Ludzie czują się "
"lekko przez ciebie nagabywani."

#: lang/json/mutation_from_json.py
msgid "Night Walker"
msgstr "Kroczący w ciemności"

#. ~ Description for Night Walker
#: lang/json/mutation_from_json.py
msgid ""
"Emerge from the grave of the old world, and become the night once again."
msgstr "Wstań z grobu starego świata i ponownie stań się nocą."

#: lang/json/mutation_from_json.py
msgid "Forest Guardian"
msgstr "Strażnik lasu"

#. ~ Description for Forest Guardian
#: lang/json/mutation_from_json.py
msgid ""
"The forests have longed for your help, and this last cry shook the world."
msgstr "Lasy prosiły o twoją pomoc a ten ostatni krzyk wstrząsnął światem."

#: lang/json/mutation_from_json.py
msgid "Nature's Boon"
msgstr "Łaska natury"

#. ~ Description for Nature's Boon
#: lang/json/mutation_from_json.py
msgid ""
"Your very presence is masked by nature itself.  You are slightly harder to "
"detect."
msgstr ""
"Twoja obecność jest maskowana przez samą naturę. Jesteś nieco trudniejszy do"
" wykrycia."

#: lang/json/mutation_from_json.py
msgid "Slashers"
msgstr "Kończyny do cięcia"

#. ~ Description for Slashers
#: lang/json/mutation_from_json.py
msgid ""
"Your torso has an extra set of appendages that have burst out of your back, "
"they are tipped with massive bone blades at the end, and look like they can "
"do some serious damage with the thick acid that they secrete."
msgstr ""
"Twój tułów ma dodatkowy zestaw wyrostków, które wyskoczyły z twoich pleców, "
"są zakończone masywnymi kościanymi ostrzami i wyglądają, jakby mogły "
"wyrządzić poważne obrażenia gęstym kwasem, który wydzielają."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You tear into %s with your blades"
msgstr "Przeszywasz %s swoimi ostrzami."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s tears into %2$s with their blades"
msgstr "%1$s przeszywa %2$s swoimi ostrzami."

#: lang/json/mutation_from_json.py
msgid "Spurs"
msgstr "Ostrogi"

#. ~ Description for Spurs
#: lang/json/mutation_from_json.py
msgid ""
"Spurs of bone have erupted all across your arms.  A thick, biological "
"secretion oozes out of them promising extra harm to enemies."
msgstr ""
"Ostrogi kości wyrosły na całych twoich rękach. Wycieka z nich gęsta, "
"biologiczna wydzielina, mogąca zadawać dodatkowe szkody wrogom."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You ravage %s with your arms"
msgstr "Dewastujesz %s swoimi rękami."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s ravages %2$s with their arm spurs"
msgstr "%1$s dewastuje %2$s swoimi ostrogami na rękach"

#: lang/json/mutation_from_json.py
msgid "Persistent Body"
msgstr "Wytrzymałe ciało"

#. ~ Description for Persistent Body
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"As you move, the world seems to breath life and energy into your limbs.  You"
" simply rarely tire less readily than others.  Your maximum stamina is 50% "
"higher than usual."
msgstr ""
"Kiedy się poruszasz, świat wydaje się tchnąć życie i energię w twoje "
"kończyny. Po prostu rzadko męczysz się wolniej niż inni. Twoja maksymalna "
"wytrzymałość jest o 50% wyższa niż zwykle."

#: lang/json/mutation_from_json.py
msgid "RP: Combatant"
msgstr "RP: kombatant"

#. ~ Description for RP: Combatant
#: lang/json/mutation_from_json.py
msgid ""
"You've seen your fair share of scruffs and scrapes, and when the Cataclysm "
"hit, you fought the Occupiers and managed to survive to tell the tale.  Has "
"no direct skill benefit, but allows you to present yourself as a fighter to "
"certain NPCs.  Some might even recognize you."
msgstr ""
"Widziałeś dużo odrapań i zadrapań, a kiedy uderzył Kataklizm, walczyłeś z "
"okupantami i udało ci się przeżyć, aby opowiedzieć tę historię. Nie ma "
"bezpośrednich korzyści umiejętności, ale pozwala zaprezentować się niektórym"
" NPC jako wojownik. Niektórzy mogą nawet cię rozpoznać."

#: lang/json/mutation_from_json.py
msgid "RP: Medic"
msgstr "RP: medyk"

#. ~ Description for RP: Medic
#: lang/json/mutation_from_json.py
msgid ""
"Your job or experiences had you seeing all sorts of trauma, both physical "
"and mental, and you were trusted during the Cataclysm to provide life-saving"
" care.  Has no direct skill benefit, but allows you to present yourself as a"
" healer to certain NPCs.  Some might even recognize you."
msgstr ""
"Twoja praca lub doświadczenia sprawiły, że widziałeś wszelkiego rodzaju "
"urazy, zarówno fizyczne, jak i psychiczne, a podczas Kataklizmu ufano ci, że"
" zapewnisz opiekę ratującą życie. Nie ma bezpośrednich korzyści "
"umiejętności, ale pozwala zaprezentować się niektórym NPC jako uzdrowiciel. "
"Niektórzy mogą nawet cię rozpoznać."

#: lang/json/mutation_from_json.py
msgid "RP: Leader"
msgstr "RP: lider"

#. ~ Description for RP: Leader
#: lang/json/mutation_from_json.py
msgid ""
"Whether or not you like it, you've always had a knack for managing people "
"and have some hard-won skill in doing so.  During the arrival and the "
"ensuing chaos, you helped lead people around you to safety.  Has no direct "
"skill benefit, but allows you to present yourself as a leader to certain "
"NPCs.  Some might even recognize you."
msgstr ""
"Czy lubisz to, czy nie, zawsze miałeś smykałkę do zarządzania ludźmi i masz "
"w tym pewne z trudem zdobyte umiejętności. Podczas przybycia i związanego z "
"nim chaosu pomogłeś doprowadzić ludzi przy tobie w bezpieczne miejsce. Nie "
"ma bezpośrednich korzyści umiejętności, ale pozwala zaprezentować się "
"niektórym NPC jako przywódca. Niektórzy mogą nawet cię rozpoznać."

#: lang/json/mutation_from_json.py
msgid "Tyrano Sapien"
msgstr "Tyrano sapiens"

#. ~ Description for {'str': 'Tyrano Sapien'}
#: lang/json/mutation_from_json.py
msgid ""
"Thunder lizard, dragon, tyrant.  All these names pale before your majesty."
msgstr ""
"Jaszczur burz, smok, tyran. Wszystkie te imiona bledną przed waszą "
"wysokością."

#. ~ Description for {'str': 'Stego'}
#: lang/json/mutation_from_json.py
msgid "Slow, methodical, heavily armored.  A walking tank."
msgstr "Powolny, metodyczny, mocno opancerzony. Chodzący czołg."

#: lang/json/mutation_from_json.py
msgid "Tough-Skinned"
msgstr "Silnoskóry"

#. ~ Description for {'str': 'Tough-Skinned'}
#: lang/json/mutation_from_json.py
msgid ""
"Your skin is getting tougher.  Cutting and bash damage are more reduced for "
"you.  Makes you less dextrous though."
msgstr ""
"Twoja skóra staje się twardsza. Obrażenia od cięć i uderzeń są bardziej "
"zredukowane dla ciebie. Sprawia za to, że jesteś mniej zręczny."

#: lang/json/mutation_from_json.py
msgid "Diamond-Skinned"
msgstr "Dimanetoskóry"

#. ~ Description for {'str': 'Diamond-Skinned'}
#: lang/json/mutation_from_json.py
msgid ""
"Your skin is developing kevlar-like qualities.  Makes you slower though."
msgstr ""
"Twoja skóra nabiera cech podobnych do kevlaru. Sprawia za to, że jesteś "
"wolniejszy."

#: lang/json/mutation_from_json.py
msgid "Apatosaurus Back"
msgstr "Plecy apatozaura"

#. ~ Description for {'str': 'Apatosaurus Back'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You are capable of carrying inhuman amounts - more than others with similar "
"strength could.  Your maximum weight carried is increased by 70%."
msgstr ""
"Jesteś w stanie dźwigać nieludzkie ilości - więcej niż ktoś o podobnej sile."
" Twój maksymalny udźwig jest większy o 70%."

#: lang/json/mutation_from_json.py
msgid "Serrated Teeth"
msgstr "Ząbkowane zęby"

#. ~ Description for {'str': 'Serrated Teeth'}
#: lang/json/mutation_from_json.py
msgid ""
"Your mouth has reshaped to accomodate many serrated teeth.  They make it "
"impossible to wear mouthgear and difficult to eat… but tear giant wounds in "
"your prey."
msgstr ""
"Twoje usta zmieniły kształt, aby pomieścić wiele ząbkowanych zębów. "
"Uniemożliwiają noszenie sprzętu na ustach i utrudniają jedzenie… ale "
"zostawiają ogromne rany na twojej ofierze."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You tear into %s with your serrated teeth"
msgstr "Rozszarpujesz %s swoimi ząbkowanymi zębami"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s tears into %2$s with their serrated teeth"
msgstr "%1$s rozszarpuje%2$s swoimi ząbkowatymi zębami"

#: lang/json/mutation_from_json.py
msgid "Horned Tail"
msgstr "Rogaty ogon"

#. ~ Description for {'str': 'Horned Tail'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a long, thick, tail with sharp pointed horns.  It helps you balance"
" a bit but also makes a heavy bludgeon.  Prevents wearing non-fabric pants."
msgstr ""
"Masz długi, gruby ogon z ostrymi, spiczastymi rogami. Odrobinę poprawia "
"równowagę, ale także jest ciężką pałką. Uniemożliwia noszenie spodni nie "
"zrobionych z materiału."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You smash %s with your tail"
msgstr "Uderzasz %s swoim ogonem"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s smashes %2$s with their tail"
msgstr "%1$s uderza %2$s swoim ogonem"

#: lang/json/mutation_from_json.py
msgid "Künstler"
msgstr "Künstler"

#. ~ Description for {'str': 'Künstler'}
#: lang/json/mutation_from_json.py
msgid ""
"You have lingering memories of training to fight cyborgs and war machines in"
" zero gravity using the obscure Panzer Kunst."
msgstr ""
"Masz wspomnienia z treningu do walki z cyborgami i machinami wojennymi w "
"stanie nieważkości przy użyciu obskurnego Panzer Kunst."

#: lang/json/mutation_from_json.py
msgid "Drunken Master"
msgstr "Pijany mistrz"

#. ~ Description for {'str': 'Drunken Master'}
#: lang/json/mutation_from_json.py
msgid ""
"The ancient arts of drunken brawling come naturally to you!  While under the"
" influence of alcohol, your melee skill will rise considerably, especially "
"unarmed combat."
msgstr ""
"Starożytne sztuki walk po pijaku przyszły do ciebie z natury. Gdy jesteś pod"
" wpływem alkoholu, twoja zdolność walka wręcz zauważalnie rośnie, w "
"szczególności umiejętność walki nieuzbrojonym."

#: lang/json/mutation_from_json.py
msgid "Hero's Spirit"
msgstr "Bohaterska dusza"

#. ~ Description for {'str': "Hero's Spirit"}
#: lang/json/mutation_from_json.py
msgid ""
"You have studied the deeds and legends of ancient heroes.  From your "
"research, you have learned an ancient form of combat called Hylian "
"Swordsmanship."
msgstr ""
"Studiowałeś czyny i legendy starożytnych bohaterów. Dzięki swoim badaniom "
"nauczyłeś się starożytnej formy walki zwanej hyliańska walka mieczem."

#: lang/json/mutation_from_json.py
msgid "Ki Strike"
msgstr "Uderzenie Ki"

#. ~ Description for {'str': 'Ki Strike'}
#: lang/json/mutation_from_json.py
msgid ""
"Who needs weapons?  You deal more melee damage while unarmed.  This damage "
"improves as your unarmed skill increases."
msgstr ""
"Kto potrzebuje broni? Zadajesz więcej obrażeń w walce wręcz, będąc "
"nieuzbrojonym. Te obrażenia zwiększają się wraz ze wzrostem umiejętności "
"walki wręcz."

#: lang/json/mutation_from_json.py
msgid "Jedi Training"
msgstr "Trening Jedi"

#. ~ Description for {'str': 'Jedi Training'}
#: lang/json/mutation_from_json.py
msgid ""
"You are trained in the ways of the Jedi.  Your knowledge allows you to "
"utilize a form of lightsaber combat."
msgstr ""
"Posiadasz wyszkolonie w ścieżce Jedi. Twoja wiedza pozwala na wykorzystanie "
"formy walki na miecze świetlne."

#: lang/json/mutation_from_json.py
msgid "Pokken Master"
msgstr "Mistrz Pokken"

#. ~ Description for {'str': 'Pokken Master'}
#: lang/json/mutation_from_json.py
msgid ""
"You are well versed in the monsterous Pocket Fist martial art.  Train well, "
"because it is your destiny to be a master."
msgstr ""
"Dobrze orientujesz się w potwornej sztuce walki Pocket Fist. Trenuj dobrze, "
"ponieważ twoim przeznaczeniem jest być mistrzem."

#: lang/json/mutation_from_json.py
msgid "Martial Adept"
msgstr "Adept sztuk walki"

#. ~ Description for {'str': 'Martial Adept'}
#: lang/json/mutation_from_json.py
msgid ""
"You are a martial adept and learned one of the martial disciplines of the "
"Sublime Way.  You start with your choice of Desert Wind, Diamond Mind, Iron "
"Heart, Setting Sun, Stone Dragon, or Tiger Claw."
msgstr ""
"Jesteś adeptem sztuk walki i znasz jedną z dyscyplin walki Wzniosłej Drogi. "
"Zaczynasz, według wyboru z: Pustynny Wiatr, Diamentowy Umysł, Żelazne Serce,"
" Zachodzące Słońce, Kamienny Smok lub Pazur Tygrysa."

#. ~ Description for {'str': 'Black Dragon'}
#: lang/json/mutation_from_json.py
msgid ""
"You sometimes think back about the world you left behind.  You're glad you "
"burned it in your wake."
msgstr ""
"Czasami wracasz myślami do świata, który zostawiłeś za sobą. Cieszysz się, "
"że go spaliłeś."

#: lang/json/mutation_from_json.py
msgid "Mirror Displacement"
msgstr "Zniekształcenie lustra"

#. ~ Description for {'str': 'Mirror Displacement'}
#: lang/json/mutation_from_json.py
msgid "You aren't where you seem to be."
msgstr "Nie ma cię tam, gdzie wydajesz się być."

#: lang/json/mutation_from_json.py
msgid "Black Dragon Scales"
msgstr "Łuski czarnego smoka"

#. ~ Description for {'str': 'Black Dragon Scales'}
#: lang/json/mutation_from_json.py
msgid ""
"A set of heavy black scales has grown to cover your body, acting as natural "
"armor.  While difficult to penetrate, it also greatly limits your "
"flexibility, resulting in a -4 penalty to Dexterity.  Greatly reduces wet "
"effects."
msgstr ""
"Zestaw grubych czarnych łusek pokrywa twe ciało i działa jak naturalna "
"zbroja. Choć trudne do przebicia, ograniczają znacząco twoją elastyczność "
"skutkując karą -4 do zręczności. Znacznie redukuje efekty przemoczenia."

#: lang/json/mutation_from_json.py
msgid "Clawed Feet"
msgstr "Pazurzaste stopy"

#. ~ Description for {'str': 'Clawed Feet'}
#: lang/json/mutation_from_json.py
msgid ""
"Your toenails have grown long and sharp, preventing you from wearing shoes, "
"but providing you with a set of powerful claws on your feet.  Fortunately "
"they don't impede your movement."
msgstr ""
"Twoje paznokcie urosły długie i ostre, uniemożliwiając noszenie butów, ale "
"dając ci zestaw potężnych pazurów na stopach. Na szczęście nie utrudniają "
"poruszania się."

#: lang/json/mutation_from_json.py
msgid "Dragon Clawed Feet"
msgstr "Stopy z pazurami smoka"

#. ~ Description for {'str': 'Dragon Clawed Feet'}
#: lang/json/mutation_from_json.py
msgid ""
"The claws on your toes have developed in to incredibly tough talons.  These "
"are fearsome and powerful, but still prevent you from wearing shoes and "
"slighly impede your movement."
msgstr ""
"Pazury na twoich palcach u stóp przekształciły się w niesamowicie twarde "
"szpony. Są przerażające i potężne, ale nadal uniemożliwiają noszenie butów i"
" nieznacznie utrudniają poruszania się."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You slash %s with your clawed feet"
msgstr "Siekasz %s swoją pazurzastą stopą"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s slashes %2$s with their clawed feet"
msgstr "%1$s sieka %s jego pazurzastą stopą"

#: lang/json/mutation_from_json.py
msgid "Inconvenient Draconic Growth"
msgstr "Niewygodny smoczy rozrost"

#. ~ Description for {'str': 'Inconvenient Draconic Growth'}
#: lang/json/mutation_from_json.py
msgid ""
"You have grown noticeably taller, broader, and menacing.  Much of it is "
"useful muscle mass (Strength +2), but you find it throws off your balance "
"and you get in your own way (+10 torso and arm encumbrance), and you notice "
"people are starting to treat you differently."
msgstr ""
"Wyrosłeś i jesteś zauważalnie wyższy, szerszy i groźny. Większość z tego to "
"użyteczna masa mięśniowa (siła +2), ale zauważasz, że jesteś mniej stabilny "
"i sam sobie wchodzisz w drogę (+10 do skrępowania tułowia i ramion) oraz "
"zauważasz, że ludzie zaczynają cię inaczej traktować."

#: lang/json/mutation_from_json.py
msgid "Draconic Growth"
msgstr "Smoczy rozrost"

#. ~ Description for {'str': 'Draconic Growth'}
#: lang/json/mutation_from_json.py
msgid ""
"You carry your rugged body with the dignity you deserve, but are all the "
"more menacing for it.  Strength +2."
msgstr ""
"Nosisz swoje silne ciało z szacunkiem na jaki zasługuje, ale jest przy tym "
"bardziej niebezpieczny. Siła +2."

#: lang/json/mutation_from_json.py
msgid "Freakish Draconic Maturity"
msgstr "Ogromna smocza dorosłość"

#: lang/json/mutation_from_json.py
msgid "Wyrmling Strength"
msgstr "Smoczęcia siła"

#. ~ Description for {'str': 'Wyrmling Strength'}
#: lang/json/mutation_from_json.py
msgid ""
"Your muscles are enhanced by some growing innate magic.  You are slightly "
"stronger.  Strength + 1"
msgstr ""
"Twoje mięśnie są wzmocnione odrobiną rosnącej wrodzonej magii. Jesteś nieco "
"silniejszy. Siła +1."

#: lang/json/mutation_from_json.py
msgid "Young Dragon Strength"
msgstr "Siła młodego smoka"

#. ~ Description for {'str': 'Young Dragon Strength'}
#: lang/json/mutation_from_json.py
msgid ""
"The connection to your inner magic is growing and your muscles are stronger,"
" but you're a little more clumsy.  Strength + 3, Dexterity - 1"
msgstr ""
"Połączenie z twoją wewnętrzną magią rośnie, a twoje mięśnie są silniejsze, "
"ale jesteś trochę bardziej niezdarny. Siła +3, zręczność -1."

#: lang/json/mutation_from_json.py
msgid "Draconic Strength"
msgstr "Smocza siła"

#. ~ Description for {'str': 'Draconic Strength'}
#: lang/json/mutation_from_json.py
msgid ""
"The magic within you courses through your muscles, greatly empowering them."
"  This costs you valuable flexibility and coordination, however.  Strength +"
" 5, Dexterity - 2"
msgstr ""
"Magia w tobie przepływa przez twoje mięśnie, znacznie je wzmacniając. "
"Kosztuje to jednak cenną elastyczność i koordynację. Siła +5, Zręczność -2."

#: lang/json/mutation_from_json.py
msgid "Ancient Draconic Strength"
msgstr "Smocza starożytnego smoka"

#. ~ Description for {'str': 'Ancient Draconic Strength'}
#: lang/json/mutation_from_json.py
msgid ""
"Your internal magic has filled you with unimaginable strength, but you can't"
" move as freely as your form once could.  This is no problem.  Strength + 8,"
" Dexterity - 3"
msgstr ""
"Twoja wewnętrzna magia napełniła cię niewyobrażalną siłą, ale nie możesz "
"poruszać się tak swobodnie, jak kiedyś. To żaden problem. Siła +8, zręczność"
" -3."

#: lang/json/mutation_from_json.py
msgid "Draconic Maturity"
msgstr "Smocza dorosłość"

#: lang/json/mutation_from_json.py
msgid "Black Dragon Wings"
msgstr "Ciemne smocze skrzydła"

#. ~ Description for {'str': 'Black Dragon Wings'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of large, black scaled dragon wings.  While you have control"
" of them and can make attacks with them, they are not large enough nor "
"strong enough to allow you to fly and they throw your off balance, greatly "
"reducing your ability to dodge.  They can be used to cast a protective spell"
" on yourself however."
msgstr ""
"Masz parę dużych, czarnych smoczych skrzydeł. Chociaż masz nad nimi kontrolę"
" i możesz nimi atakować, nie są one wystarczająco duże ani wystarczająco "
"silne, aby umożliwić ci latanie i wytrącają cię z równowagi, znacznie "
"zmniejszając twoją zdolność do uników. Można ich jednak użyć do rzucenia na "
"siebie zaklęcia ochronnego."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You bash %s with your powerful wings"
msgstr "Uderzasz %s swoimi silnymi skrzydłami"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s bashes %2$s with their powerful wings"
msgstr "%1%s uderza %s jego silnymi skrzydłami"

#: lang/json/mutation_from_json.py
msgid "Overly Acidic Digestion"
msgstr "Zbytnio kwasowe trawienie"

#. ~ Description for {'str': 'Overly Acidic Digestion'}
#: lang/json/mutation_from_json.py
msgid ""
"Your digestive issues have developed to become overly acidic which greatly "
"impacts your ability to normally digest food, resulting in getting far less "
"nutrition from the food you eat and making your need to eat more often."
msgstr ""
"Twoje problemy trawienne rozwinęły się i stały się nadmiernie kwaśne, co "
"znacznie wpływa na zdolność normalnego trawienia pokarmów, skutkujące "
"znacznie mniejszą ilością składników odżywczych z jedzenia, które spożywasz "
"oraz sprawia, że musisz jeść częściej."

#. ~ Description for {'str': 'Black Dragon Breath'}
#: lang/json/mutation_from_json.py
msgid ""
"Your digestive issues may not have settled entirely, but you can somewhat "
"control them and now you have the ability to spit acid!"
msgstr ""
"Twoje problemy trawienne mogą nie zostać całkowicie rozwiązane, ale możesz "
"je nieco kontrolować, a teraz masz zdolność plucia kwasem!"

#: lang/json/mutation_from_json.py
msgid "Draconic Heat Dependence"
msgstr "Smocza zależność od ciepła"

#. ~ Description for {'str': 'Draconic Heat Dependence'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your muscle response is dependent on ambient temperatures.  You lose 1% of "
"your speed for every 5 (2.8) degrees below 65 F (18.3 C).  Unfortunately, "
"this doesn't seem to help you conserve any energy."
msgstr ""
"Twoje reakcje mięśniowe są zależne od otaczającej temperatury. Tracisz 1% "
"szybkości na każde 5 stopni Fahrenheita (2,8 stopnia Celsjusza) poniżej 65 F"
" (18,3 C). Niestety, nie pozwala ci to na zachowanie jakiejkolwiek energii."

#: lang/json/mutation_from_json.py
msgid "High Draconic Heat Dependence"
msgstr "Wysoka smocza zależność od ciepła"

#. ~ Description for {'str': 'High Draconic Heat Dependence'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your muscle response is highly dependent on ambient temperatures.  You lose "
"1% of your speed for every 3 (1.7) degrees below 65 F (18.3 C).  "
"Unfortunately, it seems you have to exert more energy to keep moving."
msgstr ""
"Twoje reakcje mięśniowe są bardzo zależne od otaczającej temperatury. "
"Tracisz 1% szybkości na każde 3 stopnie Fahrenheita (1,7 stopni Celsjusza) "
"poniżej 65 F (18,3 C). Niestety, wygląda na to, że musisz poświęcić więcej "
"energii do poruszania się."

#: lang/json/mutation_from_json.py
msgid "Draconic Ectothermia"
msgstr "Smocza ekotermia"

#. ~ Description for {'str': 'Draconic Ectothermia'}
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your body has become permanently cold-blooded.  Your speed lowers or raises "
"1% for every 2 (1.1) degrees below or above 65 F (18.3 C).  All this and you"
" need even more food to maintain your energy."
msgstr ""
"Twoje ciało jest na stałe zimnokrwiste. Twoja szybkość maleje, bądź rośnie "
"na każde 2 stopnie Fahrenheita (1,1 stopnia Celsjusza) poniżej. lub powyżej "
"65 F (18,3 C). Wszystko to i jeszcze musisz spożywać jeszcze więcej "
"pożywienia, by zachować swój poziom energii."

#: lang/json/mutation_from_json.py
msgid "Draconic Magic"
msgstr "Smocza magia"

#. ~ Description for {'str': 'Draconic Magic'}
#: lang/json/mutation_from_json.py
msgid ""
"You are imbued with with the ancient magic powers of black dragons, "
"improving your mana reserves and opening your mind to amazing feats of "
"magic."
msgstr ""
"Jesteś nasycony starożytnymi magicznymi mocami czarnych smoków, zwiększając "
"swoje rezerwy many i otwierając swój umysł na niesamowite wyczyny magii."

#: lang/json/mutation_from_json.py
msgid "Draconic Spellcasting"
msgstr "Smocze rzucanie czarów"

#. ~ Description for {'str': 'Draconic Spellcasting'}
#: lang/json/mutation_from_json.py
msgid ""
"Your mind has fully opened to the power and ancient heritage of dragons.  "
"You can access even greater quantities of mana and you have access to more "
"dragon spells."
msgstr ""
"Twój umysł jest w pełni otwarty na moc i starożytne dziedzictwo smoków. Masz"
" dostęp do jeszcze większych ilości many i masz dostęp do większej liczby "
"smoczych zaklęć."

#: lang/json/mutation_from_json.py
msgid "Scaled Mouth"
msgstr "Usta z łuskami"

#. ~ Description for {'str': 'Scaled Mouth'}
#: lang/json/mutation_from_json.py
msgid ""
"Your scales have grown up and around your mouth, digging into your gums and "
"retracting your lips.  On the down side, it makes speaking difficult.  On "
"the positive side, it makes it very easy to bite things, though what's "
"driving you to do that?"
msgstr ""
"Twoje łuski urosły na i wokół twoich ust, wbijając się w dziąsła i chowając "
"twoje wargi. Minusem jest, że utrudnia to mówienie. Plusem jest to, że "
"bardzo łatwo jest gryźć różne rzeczy, ale co cię do tego skłania?"

#: lang/json/mutation_from_json.py
msgid "Black Dragon Maw"
msgstr "Szczęka czarnego smoka"

#. ~ Description for {'str': 'Black Dragon Maw'}
#: lang/json/mutation_from_json.py
msgid ""
"Your face and jaws have extended to a long, toothy dragon maw.  It's "
"fearsome and causes grievous wounds, but prevents wearing mouth gear."
msgstr ""
"Twoja twarz i szczęki rozszerzyły się do długiej, zębatej smoczej paszczy. "
"Jest przerażająca i powoduje poważne rany, ale uniemożliwia  noszenie "
"sprzętu na ustach."

#: lang/json/mutation_from_json.py
msgid "Stubby Reptile Tail"
msgstr "Krótki gadzi ogon"

#. ~ Description for {'str': 'Stubby Reptile Tail'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a short, stubby tail that has strange bumps and ridges.  You can "
"wiggle it, but it serves no purpose."
msgstr ""
"Masz krótki, przysadzisty ogon z dziwnymi wybrzuszeniami i fałdami. Możesz "
"nim poruszać, ale nic to nie daje."

#: lang/json/mutation_from_json.py
msgid "Scaled Reptile Tail"
msgstr "Łuskowy gadzi ogon"

#. ~ Description for {'str': 'Scaled Reptile Tail'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a long, thick, reptile tail.  You can use it decently as a club of "
"sorts, but it's not doing anything to help you balance.  Prevents wearing "
"non-fabric pants."
msgstr ""
"Masz długi, gruby ogon gada. Możesz używać go przyzwoicie jako swego rodzaju"
" pałkę, ale nie polepsza zdolności zachowania równowagi. Uniemożliwia "
"noszenie spodni nie zrobionych z materiału."

#: lang/json/mutation_from_json.py lang/json/technique_from_json.py
msgid "Dragon Tail"
msgstr "Smoczy ogon"

#. ~ Description for {'str': 'Dragon Tail'}
#: lang/json/mutation_from_json.py
msgid ""
"You have a long, thick, dragonlike tail.  It doesn't help you balance or "
"dodge any better, but it is a powerful bashing weapon.  Prevents wearing "
"non-fabric pants."
msgstr ""
"Masz długi, gruby ogon jak u smoka. Nie polepsza zdolności zachowania "
"równowagi ani uników, ale jest potężną miażdżącą bronią. Uniemożliwia "
"noszenie spodni nie zrobionych z materiału."

#: lang/json/mutation_from_json.py
msgid "Scaled Hands"
msgstr "Łuskowe dłonie"

#. ~ Description for {'str': 'Scaled Hands'}
#: lang/json/mutation_from_json.py
msgid ""
"Your scales have grown to cover your hands and elongate the tips in to "
"jagged claws that can be servicable as cutting and piercing weapons in "
"unarmed combat.  You can still use them normally, but you can't wear gloves."
msgstr ""
"Twoje łuski urosły, zakrywając twoje dłonie i wydłużając koniuszki stając "
"się postrzępionymi pazurami, które mogą służyć jako broń tnąca i "
"przebijająca w walce bez broni. Nadal możesz ich normalnie używać, ale nie "
"możesz nosić rękawic."

#: lang/json/mutation_from_json.py
msgid "Black Dragon Talons"
msgstr "Szpony czarnego smoka"

#. ~ Description for {'str': 'Black Dragon Talons'}
#: lang/json/mutation_from_json.py
msgid ""
"All of your fingers have developed into huge scaled talons.  They prevent "
"wearing gloves, but you can use them to powerful effect in melee combat and "
"you appear to have uncovered some secrets about black dragons."
msgstr ""
"Wszystkie twoje palce rozwinęły się w ogromne, łuskowate szpony. "
"Uniemożliwiają noszenie rękawiczek, ale możesz ich używać z potężnym efektem"
" w walce wręcz i wydaje się, że odkryłeś pewne tajemnice dotyczące czarnych "
"smoków."

#: lang/json/mutation_from_json.py
msgid "Artificer"
msgstr "Atrefakciarz"

#. ~ Description for {'str': 'Artificer'}
#: lang/json/mutation_from_json.py
msgid ""
"With the mechanically-minded Technomancer and the sheer power of lightning "
"from a Stormshaper, the Artificer has a unique confluence of skills and "
"spells to be perfect for invention.  While modern inventions and machines "
"have won out in a modern society, after a cataclysm one has a chance to go "
"back to roots of things.  To make weird gadgets that are just as likely to "
"explode as explode the thing you're pointing at."
msgstr ""
"Dzięki mechanicznie nastawionemu technomancie i czystej mocy błyskawic z "
"kształtującego sztormy, artefakciarz ma wyjątkową mieszankę umiejętności i "
"zaklęć, które idealnie nadają się do wynalazków. Podczas gdy nowoczesne "
"wynalazki i maszyny zwyciężyły we współczesnym społeczeństwie, po "
"Kataklizmie można wrócić do korzeni. Tworząc dziwne gadżety, mogą one "
"eksplodować tak samo jak przedmiot, na który wskazujesz."

#: lang/json/mutation_from_json.py
msgid "Alchemist"
msgstr "Alchemiczka"

#. ~ Description for {'str': 'Alchemist'}
#: lang/json/mutation_from_json.py
msgid ""
"The alchemist comes from the technomancer's skills with unliving matter "
"combined with the animist's grasp on the ambient ley lines.  It requires "
"magical talent and lots of time, but is invaluable for creating powerful "
"magical effects in a storable, accessible form."
msgstr ""
"Alchemik wywodzi się z umiejętności technomanty w zakresie materii "
"nieożywionej w połączeniu z umiejętnościami animisty w zakresie ley linii "
"otoczenia. Wymaga talentu magicznego i mnóstwa czasu, ale jest nieoceniony "
"przy tworzeniu potężnych efektów magicznych w łatwej do przechowywania, "
"dostępnej formie."

#: lang/json/mutation_from_json.py
msgid "Biotek"
msgstr "Biotek"

#. ~ Description for {'str': 'Biotek'}
#: lang/json/mutation_from_json.py
msgid ""
"The Biotek is quite simply the marriage of technology and flesh.  It was not"
" even discovered as an attunement until recent times due to the great "
"advancements in technology in the last 50 years.  The Biotek is unique as it"
" is the only known attunement that warps the Aethereum in such a way as to "
"allow cybernetics to coincide with magical abilities, to an extent."
msgstr ""
"Biotek to po prostu mariaż technologii i ciała. Do niedawna nie została "
"nawet odkryta jako dostrojenie ze względu na wielki postęp technologiczny w "
"ciągu ostatnich 50 lat. Biotek jest wyjątkowy, ponieważ jest jedynym znanym "
"dostrojeniem, które wypacza Aethereum w taki sposób, że pozwala cybernetyce "
"pokrywać się do pewnego stopnia z magicznymi zdolnościami."

#: lang/json/mutation_from_json.py
msgid "Blood Mage"
msgstr "Czarodziej krwi"

#. ~ Description for {'str': 'Blood Mage'}
#: lang/json/mutation_from_json.py
msgid ""
"Animists are known for their blood magic, and being a Biomancer you are able"
" to take it another step further by strengthening your blood.  The dark arts"
" have opened to you, and while dangerous, are incredible to behold."
msgstr ""
"Animiści są znani ze swojej magii krwi, a będąc biomantkykiem możesz pójść o"
" krok dalej, wzmacniając swoją krew. Mroczne sztuki otworzyły się przed tobą"
" i chociaż są niebezpieczne, są niewiarygodnym widokiem."

#: lang/json/mutation_from_json.py
msgid "Boreal Mage"
msgstr "Północny czarodziej"

#. ~ Description for {'str': 'Boreal Mage'}
#: lang/json/mutation_from_json.py
msgid ""
"Named for the auroras that grace the poles of the earth, the Boreal mage "
"specializes in auras that protect ethereally.  Boreal mages definitely know "
"their way around cold spells, but their real strength is protection."
msgstr ""
"Nazwany na cześć zórz, które zdobią bieguny ziemi, północny czarodziej "
"specjalizuje się w aurach, które chronią eterycznie. Czarodzieje północy z "
"pewnością znają się na radzeniu sobie z zaklęciami zimna, ale ich prawdziwą "
"siłą jest ochrona."

#: lang/json/mutation_from_json.py
msgid "Cleansing Flame"
msgstr "Oczyszczający płomień"

#. ~ Description for {'str': 'Cleansing Flame'}
#: lang/json/mutation_from_json.py
msgid ""
"The Cleansing Flame is the fire that burns away the chaff, in preparation "
"for the regrowth of new life."
msgstr ""
"Oczyszczający Płomień to ogień, który wypala plewy, przygotowując się na "
"odrodzenie nowego życia."

#: lang/json/mutation_from_json.py
msgid "Crusader"
msgstr "Krzyżowiec"

#. ~ Description for {'str': 'Crusader'}
#: lang/json/mutation_from_json.py
msgid ""
"The Crusader attunement is a clashing dichotomy of Man and Nature.  "
"Utilizing man's propensity for tools and nature's resilience, the Crusader "
"is a juggernaut in armed combat."
msgstr ""
"Dostrojenie krzyżowca to ścierająca się dychotomia człowieka i natury. "
"Wykorzystując ludzką skłonność do narzędzi i odporność natury, krzyżowiec "
"jest molochem w walce zbrojnej."

#: lang/json/mutation_from_json.py
msgid "Earth Elemental"
msgstr "Ziemny elemental"

#. ~ Description for {'str': 'Earth Elemental'}
#: lang/json/mutation_from_json.py
msgid ""
"Stone is superior to flesh.  You have allowed this axiom into your life, and"
" work to correct your own weakness with biomancy.  The strength of the Earth"
" rushed up to meet you with open arms."
msgstr ""
"Kamień jest lepszy od ciała. Wpuściłeś ten aksjomat do swojego życia i "
"pracujesz nad naprawieniem własnej słabości za pomocą biomancji. Siła ziemi "
"rzuciła się na ciebie z otwartymi ramionami."

#: lang/json/mutation_from_json.py
msgid "Fire Elemental"
msgstr "Ognisty elemental"

#. ~ Description for {'str': 'Fire Elemental'}
#: lang/json/mutation_from_json.py
msgid ""
"You have used your expertise in Biomancy to change your body more toward "
"your affinity for fire as a Kelvinist.  Fire doesn't bother you as much "
"anymore, and your blood is flammable when it touches the air, resulting in a"
" gout of flame when something hurts you.  You are also starting to study "
"more spells that focus on using your own body's affinity for fire."
msgstr ""
"Wykorzystałeś swoje doświadczenie w biomancji, aby zmienić swoje ciało "
"bardziej w kierunku powinowactwa do ognia jako kelwinista. Ogień nie "
"przeszkadza ci już tak bardzo, a twoja krew jest łatwopalna, gdy dotknie "
"powietrza, powodując gaszenie ognia, gdy coś cię rani. Zaczynasz też "
"studiować więcej zaklęć, które koncentrują się na używaniu powinowactwa "
"własnego ciała do ognia."

#: lang/json/mutation_from_json.py
msgid "Force Mage"
msgstr "Mag mocy"

#. ~ Description for {'str': 'Force Mage'}
#: lang/json/mutation_from_json.py
msgid ""
"Force = Mass x Acceleration.  This is the typical thing that people think of"
" nowadays when the word is used, but Force Mages have a different meaning, "
"coming from traditional roots: untyped magical damage appears to be a "
"ghostly \"force.\"  This might be the effect of the attunement, but the "
"cause is even more intriguing: they appear to turn Newton's Third Law on its"
" head.  Magical scholars of the 21st century have theorized that this isn't "
"really the case; instead of the opposite reaction happening on this plane of"
" existence, a Force Mage uses the Aetherium's alternate Laws to rebound the "
"force back upon itself, effectively doubling the force in the same direction"
" instead.  However this ability comes with limitations, as the Force Mage "
"can only do this for melee damage."
msgstr ""
"Siła = masa x przyspieszenie. Jest to typowa rzecz, o której ludzie myślą w "
"dzisiejszych czasach, gdy używa się tego słowa, ale magowie mocy znają inne "
"znaczenie, wywodzące się z tradycyjnych korzeni: nieopisane magiczne "
"obrażenia wydają się być upiorną „mocą”. Może to być efekt dostrojenia, ale "
"przyczyna jest jeszcze bardziej intrygująca: wydaje się, że wywracają one do"
" góry nogami trzecie prawo Newtona. Badacze magii XXI wieku wysnuli teorię, "
"że nie ma ona racji; zamiast odwrotnej reakcji zachodzącej na tej "
"płaszczyźnie egzystencji, mag mocy używa alternatywnych praw Aetherium, aby "
"skierować moc z powrotem na siebie, skutecznie podwajając moc w tym samym "
"kierunku. Jednak ta umiejętność ma pewne ograniczenia, ponieważ mag mocy "
"może to zrobić tylko w przypadku obrażeń w walce wręcz."

#: lang/json/mutation_from_json.py
msgid "Gaia's Chosen"
msgstr "Wybraniec Gai"

#. ~ Description for {'str': "Gaia's Chosen"}
#: lang/json/mutation_from_json.py
msgid ""
"The Champion of the Earth, Gaia's Chosen is blessed on all things nature, "
"animate and inanimate."
msgstr ""
"Czempion Ziemi, Wybraniec Gai, jest pobłogosławiony wszystkimi rzeczami "
"natury, ożywionymi i nieożywionymi."

#: lang/json/mutation_from_json.py
msgid "Glacier Mage"
msgstr "Mag lodu"

#. ~ Description for {'str': 'Glacier Mage'}
#: lang/json/mutation_from_json.py
msgid ""
"The power of a Glacier Mage is backed by a thousand tons of ice and snow, "
"with a brutal might in their spells.  While they are skilled with cold "
"spells, their greatest strength is in offense."
msgstr ""
"Moc maga lodu jest wspierana przez tysiąc ton lodu i śniegu, z brutalną mocą"
" w swoich zaklęciach. Choć są wykwalifikowani w rzucaniu zaklęć zimna, ich "
"największą siłą jest ofensywa."

#: lang/json/mutation_from_json.py
msgid "Golemancer"
msgstr "Golemanta"

#. ~ Description for {'str': 'Golemancer'}
#: lang/json/mutation_from_json.py
msgid ""
"The Golemancer is the ancient myth of the clay golem, made reality from "
"constant use of Animist summons and Earthshaper self-strengthening spells.  "
"Takes some traits from the golems they create, such as immunity to slowing "
"effects."
msgstr ""
"Golemancer to starożytny mit glinianego golema, urzeczywistniony dzięki "
"nieustannemu używaniu przywołań animistów i samowzmacniających zaklęć "
"kształtującego ziemię. Bierze pewne cechy z golemów, które tworzą, takie jak"
" odporność na efekty spowolnienia."

#: lang/json/mutation_from_json.py
msgid "Gravity Mage"
msgstr "Mag grawitacji"

#. ~ Description for {'str': 'Gravity Mage'}
#: lang/json/mutation_from_json.py
msgid ""
"The fundamental Laws of the universe are thought of as the end-all-be-all in"
" magical circles, and the Gravity Mage is a result of mages mucking around "
"with those laws.  Unfortunately, this attunement does not give supreme "
"control over gravity as a fundamental force, though the affinity is "
"prominent and comes with some non-negligible benefits."
msgstr ""
"Podstawowe prawa Wszechświata są uważane za koniec ostateczny w magicznych "
"kręgach, a mag grawitacji jest wynikiem grzebania w tych prawach przez "
"magów. Niestety, to dostrojenie nie daje najwyższej kontroli nad grawitacją "
"jako podstawową siłą, chociaż powinowactwo jest znaczące i przynosi pewne "
"nie bez znaczenia korzyści."

#: lang/json/mutation_from_json.py
msgid "Overclocker"
msgstr "Overclocker"

#. ~ Description for {'str': 'Overclocker'}
#: lang/json/mutation_from_json.py
msgid ""
"The Technomancer specializes in augmenting humans without actually modifying"
" them; and the Overclocker takes the heat aptitude of a Kelvinist and puts "
"that to work.  You are able to think significantly faster, and are able to "
"align your leylines for spellcasting faster as a result."
msgstr ""
"Technomanta specjalizuje się w ulepszaniu ludzi bez faktycznego ich "
"modyfikowania; a overclocker wykorzystuje upodobanie do ognia kelwinisty i "
"wykorzystuje to do pracy. Jesteś w stanie myśleć znacznie szybciej i jesteś "
"w stanie dostosować swoje ley linie do szybszego rzucania zaklęć."

#: lang/json/mutation_from_json.py
msgid "Ice Elemental"
msgstr "Lodowy elemental"

#. ~ Description for {'str': 'Ice Elemental'}
#: lang/json/mutation_from_json.py
msgid ""
"Through your power in Biomancy, you have changed your body towards your "
"Kelvinist affinity for ice.  Extreme cold has less effect on you, and your "
"superchilled skin causes frostbite when touching others.  You're also "
"starting to research more magic that focuses on your body's inherent ice "
"affinity."
msgstr ""
"Poprzez swoją moc w biomancji zmieniasz swoje ciało w kierunku "
"kelwinistycznego powinowactwa do lodu. Ekstremalne zimno ma na ciebie "
"mniejszy wpływ, a twoja super schłodzona skóra powoduje odmrożenia podczas "
"dotykania innych. Zaczynasz również badać więcej magii, która koncentruje "
"się na wrodzonym powinowactwie lodowym twojego ciała."

#: lang/json/mutation_from_json.py
msgid "Illusionist"
msgstr "Iluzjonista"

#. ~ Description for {'str': 'Illusionist'}
#: lang/json/mutation_from_json.py
msgid ""
"Through the fine manipulation of light, an Illusionist might craft "
"deceptively convincing and dangerous illusions.  An Illusionist excels at "
"avoiding direct confrontation, instead relying on decoys and traps to slip "
"by undetected."
msgstr ""
"Poprzez delikatną manipulację światłem iluzjonista może stworzyć zwodniczo "
"przekonujące i niebezpieczne iluzje. Iluzjonista celuje w unikaniu "
"bezpośredniej konfrontacji, zamiast tego polega na wabikach i pułapkach, aby"
" prześlizgnąć się niepostrzeżenie."

#: lang/json/mutation_from_json.py
msgid "Magnetism Mage"
msgstr "Mag magnetyzmu"

#: lang/json/mutation_from_json.py
msgid "Permafrost Mage"
msgstr "Mag permanentnego zimna"

#: lang/json/mutation_from_json.py
msgid "Radiation Mage"
msgstr "Mag radiacji"

#. ~ Description for {'str': 'Radiation Mage'}
#: lang/json/mutation_from_json.py
msgid ""
"The Radiation mage was discovered as an attunement in the 20th century, "
"closely guarded as a military secret in close relation to the Manhatten "
"Project.  It was declassified in 1989 as a part of the attunement awareness "
"movement, but it is still poorly understood even by the very few researchers"
" that wrote books on attunements."
msgstr ""
"Mag radiacji został odkryty jako dostrojenie w XX wieku, ściśle strzeżony "
"jako tajemnica wojskowa w bliskim związku z Projektem Manhattan. Został "
"odtajniony w 1989 roku w ramach ruchu świadomości o nastawieniu, ale wciąż "
"jest słabo rozumiany nawet przez nielicznych badaczy, którzy pisali książki "
"o dostrojeniach."

#: lang/json/mutation_from_json.py
msgid "Shaman"
msgstr "Szaman"

#. ~ Description for {'str': 'Shaman'}
#: lang/json/mutation_from_json.py
msgid ""
"Deeply attuned to the spiritual fabric that shapes and nurtures the natural "
"world.  Shamans call upon the primeval spirits of nature for aid and advice."
"  Be careful however, for ancient spirits are fickle and unknowable things."
msgstr ""
"Głęboko dostrojoni do duchowej tkanki, która kształtuje i pielęgnuje świat "
"przyrody. Szamani proszą o pomoc i radę pradawne duchy natury. Zachowaj "
"jednak ostrożność, ponieważ starożytne duchy są zmiennymi i niepoznawalnymi "
"rzeczami."

#: lang/json/mutation_from_json.py
msgid "Shapeshifter"
msgstr "Zmiennokształtny"

#. ~ Description for {'str': 'Shapeshifter'}
#: lang/json/mutation_from_json.py
msgid ""
"The shapeshifter is the Biomancer refined - able to use a flicker of mana to"
" change shape at the drop of a hat to make yourself more inviting or shape "
"others into desired shapes."
msgstr ""
"Zmiennokształtny to udoskonalony bionamta - potrafi użyć migotania many, aby"
" zmienić kształt w mgnieniu oka, aby stać się bardziej zachęcającym lub "
"nadać innym pożądane kształty."

#: lang/json/mutation_from_json.py
msgid "Soulfire"
msgstr "Ogień z duszy"

#. ~ Description for {'str': 'Soulfire'}
#: lang/json/mutation_from_json.py
msgid ""
"The Soulfire is a phenomena of the caster's spirit binding to a fragment of "
"a spirit of flame.  This makes it possible for the Soulfire to use its "
"namesake as an element - much like fire, it does burn, but it burns away at "
"the soul instead of the flesh."
msgstr ""
"Ogień z duszy jest zjawiskiem, w którym duch rzucającego wiąże się z "
"fragmentem ducha płomienia. To sprawia, że ogień z duszy może używać swojego"
" imiennika jako żywiołu - podobnie jak ogień, pali się, ale spala duszę "
"zamiast ciała."

#: lang/json/mutation_from_json.py
msgid "Storm Elemental"
msgstr "Elemental lodu"

#. ~ Description for {'str': 'Storm Elemental'}
#: lang/json/mutation_from_json.py
msgid ""
"You've used your knowledge of Biomancy to change your body into a form "
"befitting a Stormshaper.  You can better withstand the power of electricity,"
" and sparks leap from your skin when something hits you.  You're beginning "
"to study spells that utilize your body's affinity for the electric."
msgstr ""
"Wykorzystałeś swoją wiedzę o biomancji, aby zmienić swoje ciało w formę "
"odpowiednią dla kształtującego sztormy. Możesz lepiej wytrzymać moc "
"elektryczności, a iskry wyskakują z twojej skóry, gdy coś cię uderzy. "
"Zaczynasz uczyć się zaklęć, które wykorzystują powinowactwo twojego ciała do"
" elektryczności."

#: lang/json/mutation_from_json.py
msgid "Stormcaller"
msgstr "Przywoływacz sztormów"

#. ~ Description for {'str': 'Stormcaller'}
#: lang/json/mutation_from_json.py
msgid ""
"A stormcaller is a stormshaper with an additional affinity toward the "
"weather in a localized area.  Historians agree that the druid requirement "
"has something to do with the Druid's affinity for nature, just like their "
"ability to summon animals.  You will know a stormcaller is in the room if "
"your ears pop and your hair stands straight on end.  Stormcallers are not "
"known for their subtlety."
msgstr ""
"Przywoływacz sztormów to kształtujący sztormy z dodatkowym powinowactwem do "
"pogody na określonym obszarze. Historycy zgadzają się, że wymóg druidów ma "
"coś wspólnego z powinowactwem druidów do natury, podobnie jak ich zdolność "
"do przyzywania zwierząt. Będziesz wiedzieć, że burza jest w pokoju, jeśli "
"twoje uszy pękają, a włosy stoją prosto. Przywoływacze sztormów nie są znani"
" ze swojej subtelności."

#: lang/json/mutation_from_json.py
msgid "Sun Mage"
msgstr "Mag Słońca"

#. ~ Description for {'str': 'Sun Mage'}
#: lang/json/mutation_from_json.py
msgid ""
"The Sun Mage has been studying the Laws governing heat, and has attained a "
"special relationship with that life-giving yellow orb in the sky.  Glimpses "
"of the Sun meet its foes, and its own burning light pierces the darkness."
msgstr ""
"Mag Słońca studiował pawa rządzące ciepłem i osiągnął szczególny związek z "
"tą życiodajną żółtą kulą na niebie. Przebłyski Słońca spotykają jego wrogów,"
" a jego własne płonące światło przenika ciemność."

#: lang/json/mutation_from_json.py
msgid "Tundra Mage"
msgstr "Mag tundry"

#. ~ Description for {'str': 'Tundra Mage'}
#: lang/json/mutation_from_json.py
msgid ""
"The barren cold of the world's far reaches flows through the Tundra Mage.  "
"They find power in the all-pervasive frost of the North and in the creatures"
" that defy its deathly chill."
msgstr ""
"Przez maga tundry przepływa jałowy chłód najdalszych zakątków świata. "
"Znajdują moc we wszechobecnym mrozie północy i w stworzeniach, które "
"przeciwstawiają się jego śmiertelnemu chłodowi."

#: lang/json/mutation_from_json.py
msgid "Void Mage"
msgstr "Mag pustki"

#. ~ Description for {'str': 'Void Mage'}
#: lang/json/mutation_from_json.py
msgid ""
"Where there is nothing, there is still power, and the Void Mages embody that"
" power.  The ability to wield emptiness itself is at their fingertips, and "
"no living creature can withstand the call of the void."
msgstr ""
"Tam, gdzie nie ma nic, wciąż jest moc, a magowie pustki ucieleśniają tę moc."
" Zdolność do władania samą pustką jest na wyciągnięcie ręki i żadna żywa "
"istota nie może wytrzymać wezwania pustki."

#: lang/json/mutation_from_json.py
msgid "Vulcanist"
msgstr "Wulkanista"

#. ~ Description for {'str': 'Vulcanist'}
#: lang/json/mutation_from_json.py
msgid ""
"One of the most destructive forces on earth, a Volcano Mage takes some "
"aspect of its namesake.  Their spells tend to be a little slow, but their "
"resilience in proximity to a volcano is legendary."
msgstr ""
"Jedna z najbardziej niszczycielskich sił na ziemi, mag wulkanu przybiera "
"pewien aspekt od swojego imiennika. Ich zaklęcia wydają się być nieco "
"powolne, ale ich odporność na bliskość wulkanu jest legendarna."

#: lang/json/mutation_from_json.py
msgid "Wither Mage"
msgstr "Mag obumierania"

#. ~ Description for {'str': 'Wither Mage'}
#: lang/json/mutation_from_json.py
msgid ""
"While biomancers focus on both life and death; Wither Mages set their sights"
" on the transitional period between these two stages.  They wield entropy "
"and decay hand and hand, using it to enhance their combat prowess to "
"surgical precision.  This confluence of abilities are what lead to assassin "
"mages gaining this attunement."
msgstr ""
"Podczas gdy biomanci skupiają się zarówno na życiu, jak i śmierci; magowie "
"obumierania skupili się na okresie przejściowym między tymi dwoma etapami. "
"Władają zarówno entropią i gniciem, wykorzystując je do zwiększenia swoich "
"zdolności bojowych do chirurgicznej precyzji. Ta konfluencja umiejętności "
"prowadzi do tego, że magowie-zabójcy zyskują to dostrojenie."

#: lang/json/mutation_from_json.py
msgid "Magus"
msgstr "Magus"

#. ~ Description for Magus
#: lang/json/mutation_from_json.py
msgid ""
"A tradition as old as magic, the Magus focuses on binding and shaping the "
"energy of the universe to their will."
msgstr ""
"Tradycja tak stara jak magia, magus skupia się na wiązaniu i kształtowaniu "
"energii Wszechświata zgodnie z ich wolą."

#: lang/json/mutation_from_json.py
msgid "Animist"
msgstr "Animista"

#. ~ Description for {'str': 'Animist'}
#: lang/json/mutation_from_json.py
msgid ""
"The animist tradition is a relatively new school of magical thought, formed "
"through combination of many older ways that focus on harmony and connection "
"to the natural world.  This does not mean that animists are passive: the "
"natural world is a savage place."
msgstr ""
"Tradycja animistyczna jest stosunkowo nową szkołą myśli magicznej, "
"uformowaną przez połączenie wielu starszych sposobów, które skupiają się na "
"harmonii i połączeniu ze światem przyrody. Nie oznacza to, że animiści są "
"bierni: świat przyrody jest dzikim miejscem."

#: lang/json/mutation_from_json.py
msgid "Kelvinist"
msgstr "Kelwinista"

#. ~ Description for Kelvinist
#: lang/json/mutation_from_json.py
msgid ""
"Disciples of the great Archwizard Lord Kelvin.  Kelvinists focus their magic"
" on manipulation and control of the temperature of their environment, "
"leading to spectacularly powerful explosions or bone-chilling cold."
msgstr ""
"Uczniowie wielkiego arcyczarodzieja Lorda Kelvina. Kelwiniści skupiają swoją"
" magię na manipulacji i kontrolowaniu temperatury otoczenia, co prowadzi do "
"spektakularnie potężnych eksplozji lub mrożącego krew w żyłach zimna."

#: lang/json/mutation_from_json.py
msgid "Stormshaper"
msgstr "Kształtujący sztormy"

#. ~ Description for Stormshaper
#: lang/json/mutation_from_json.py
msgid ""
"Stormshapers follow ancient arcane disciplines of meditation and harmony "
"with the winds and tides that shape the planet.  Through their deep "
"connection to these forces, they can request powerful changes."
msgstr ""
"Kształtujący sztormy podążają za starożytnymi tajemnymi dyscyplinami "
"medytacji i harmonii z wiatrami i przypływami, które kształtują planetę. "
"Dzięki głębokiemu połączeniu z tymi siłami mogą zażądać potężnych zmian."

#: lang/json/mutation_from_json.py
msgid "Technomancer"
msgstr "Technomanta"

#. ~ Description for Technomancer
#: lang/json/mutation_from_json.py
msgid ""
"Technomancers are the new breed of modern magician, blending their arcane "
"might with their advanced knowledge of the fundamental nature of the "
"universe.  They use technology to enhance their magic and vice versa."
msgstr ""
"Technomanci to nowy gatunek współczesnych magów, łączący swoją tajemną "
"potęgę z zaawansowaną wiedzą o fundamentalnej naturze wszechświata. Używają "
"technologii, aby wzmocnić swoją magię i na odwrót."

#: lang/json/mutation_from_json.py
msgid "Earthshaper"
msgstr "Kształtujący ziemię"

#. ~ Description for Earthshaper
#: lang/json/mutation_from_json.py
msgid ""
"Earthshapers have allowed their minds to sink deep within the stones and "
"metals of the planet, and become one with its secrets.  To a master "
"Earthshaper, spells can be as permanent as the stones they are created from,"
" and time is measured in geological eras."
msgstr ""
"Kształtujący ziemię pozwolili swoim umysłom zatopić się głęboko w kamieniach"
" i metalach planety i zjednoczyć się z jej sekretami. Dla mistrza "
"kształtującego ziemię zaklęcia mogą być tak trwałe, jak kamienie, z których "
"są tworzone, a czas mierzony jest w epokach geologicznych."

#: lang/json/mutation_from_json.py
msgid "Biomancer"
msgstr "Biomanta"

#. ~ Description for {'str': 'Biomancer'}
#: lang/json/mutation_from_json.py
msgid ""
"The Biomancer focuses on manipulating and even absorbing flesh; their own, "
"and that of other living or dead things.  Most other wizards find their "
"powers gross and disturbing, but no one can question the potency of their "
"abilities, and certainly not their adaptability to any situation."
msgstr ""
"Biomanta skupia się na manipulowaniu, a nawet wchłanianiu ciała; własnego i "
"innych żywych lub martwych istot. Większość innych czarodziejów uważa, że "
"ich moce są obrzydliwe i niepokojące, ale nikt nie może kwestionować siły "
"ich zdolności, a już na pewno nie ich zdolności przystosowania się do każdej"
" sytuacji."

#: lang/json/mutation_from_json.py
msgid "Druid"
msgstr "Druid"

#. ~ Description for Druid
#: lang/json/mutation_from_json.py
msgid ""
"Druids follow a wild tradition of allegiance and rebirth within the world of"
" nature, especially the cycle of death and rebirth that is the plant world."
"  A powerful Druid is as much a part of that world as the human one."
msgstr ""
"Druidzi kierują się dziką tradycją lojalności i odradzania się w świecie "
"natury, zwłaszcza cyklu śmierci i odrodzenia, czyli świata roślin. Potężny "
"druid jest tak samo częścią tego świata, jak ludzki."

#. ~ Description for {'str': 'Manatouched'}
#: lang/json/mutation_from_json.py
msgid "Magic is in you.  Magic is you."
msgstr "Magia jest w tobie. Magia to ty."

#: lang/json/mutation_from_json.py
msgid "Mana Solidification"
msgstr "Solidyfikacja many"

#. ~ Description for {'str': 'Mana Solidification'}
#: lang/json/mutation_from_json.py
msgid ""
"Your internal ley lines have become much easier for you to control, "
"resulting in you being able to naturally create crystallized mana."
msgstr ""
"Twoje wewnętrzne ley linie magii stały się znacznie łatwiejsze do "
"kontrolowania, dzięki czemu możesz naturalnie tworzyć skrystalizowaną manę."

#. ~ Description for {'str': 'Seeker Bolts'}
#: lang/json/mutation_from_json.py
msgid ""
"Your hands glow with mana energy.  You can fire seeker bolts from your "
"fingertips."
msgstr ""
"Twoje dłonie świecą energią many. Możesz strzelać piorunami naprowadzającymi"
" z opuszków palców."

#: lang/json/mutation_from_json.py
msgid "Subtle Spell"
msgstr "Subtelne zaklęcie"

#. ~ Description for {'str': 'Subtle Spell'}
#: lang/json/mutation_from_json.py
msgid ""
"You no longer need to move your arms to cast spells, due to your ley lines "
"becoming untethered from your arms.  Arm encumbrance no longer applies to "
"spell failure chance."
msgstr ""
"Nie musisz już ruszać rękami, aby rzucać zaklęcia, ponieważ ley linie mocy "
"odrywają się od twoich ramion. Skrępowanie rąk nie ma już wpływu na szansę "
"na niepowodzenie zaklęcia."

#: lang/json/mutation_from_json.py
msgid "Silent Spell"
msgstr "Ciche zaklęcie"

#. ~ Description for {'str': 'Silent Spell'}
#: lang/json/mutation_from_json.py
msgid ""
"You no longer need to use your voice to enforce your will upon the world.  "
"Mouth encumbrance no longer applies to spell failure chance."
msgstr ""
"Nie musisz już używać swojego głosu, aby narzucać światu swoją wolę. "
"Skrępowanie ust nie ma już wpływu na szansę na niepowodzenie zaklęcia."

#: lang/json/mutation_from_json.py
msgid "Weak"
msgstr "Słabość"

#. ~ Description for {'str': 'Weak'}
#: lang/json/mutation_from_json.py
msgid "Your body is unnaturally weak.  -2 Strength."
msgstr "Twoje ciało jest nienaturalnie słabe. Siła -2."

#: lang/json/mutation_from_json.py
msgid "Mana Luminance"
msgstr "Luminancja many"

#. ~ Description for {'str': 'Mana Luminance'}
#: lang/json/mutation_from_json.py
msgid ""
"Your body discards unusable mana as light and heat, making you glow softly."
msgstr ""
"Twoje ciało odrzuca bezużyteczną manę w postaci światła i ciepła, dzięki "
"czemu delikatnie świecisz."

#. ~ Description for {'str': 'Mana Siphon'}
#. ~ Description for {'str': 'Mana Drain'}
#. ~ Description for {'str': 'Mana Vortex'}
#: lang/json/mutation_from_json.py
msgid ""
"Violence excites your ley lines.  Whenever you hit an enemy in melee, you "
"have a chance of regaining some mana."
msgstr ""
"Przemoc ekscytuje twoje ley linie. Za każdym razem, gdy trafisz wroga w "
"walce wręcz, masz szansę na odzyskanie trochę many."

#: lang/json/mutation_from_json.py
msgid "Mana Drain"
msgstr "Wysysanie many"

#: lang/json/mutation_from_json.py
msgid "Mana Vortex"
msgstr "Wir many"

#: lang/json/mutation_from_json.py
msgid "Manatouched Mana Efficiency"
msgstr "Efektywność many dotkniętego maną"

#. ~ Description for {'str': 'Manatouched Mana Efficiency'}
#. ~ Description for Greater Mana Efficiency
#: lang/json/mutation_from_json.py
msgid "You are able to store a lot more mana in your body than usual."
msgstr ""
"Jesteś w stanie zgromadzić w swoim ciele o wiele więcej many niż zwykle."

#: lang/json/mutation_from_json.py
msgid "Manatouched Mana Regeneration"
msgstr "Regeneracja many dotkniętego maną"

#. ~ Description for Manatouched Mana Regeneration
#. ~ Description for Greater Mana Regeneration
#: lang/json/mutation_from_json.py
msgid "Your natural mana regeneration is much faster than normal."
msgstr "Twoja naturalna regeneracja many jest znacznie szybsza niż normalnie."

#: lang/json/mutation_from_json.py
msgid "Manatouched Mana Sensitivity"
msgstr "Delikatność dotkniętego maną"

#. ~ Description for Manatouched Mana Sensitivity
#. ~ Description for Greater Mana Sensitivity
#: lang/json/mutation_from_json.py
msgid ""
"You can sense the mana in your body much better than normal, allowing you to"
" tap into more of your reserves."
msgstr ""
"Możesz wyczuć manę w swoim ciele znacznie lepiej niż normalnie, co pozwala "
"ci na skorzystanie z większej ilości swoich rezerw."

#: lang/json/mutation_from_json.py
msgid "Lesser Mana Efficiency"
msgstr "Mniejsza efektywność many"

#. ~ Description for Lesser Mana Efficiency
#: lang/json/mutation_from_json.py
msgid "You are able to store a little more mana in your body than usual."
msgstr ""
"Jesteś w stanie zgromadzić trochę więcej many w swoim ciele niż zwykle."

#: lang/json/mutation_from_json.py
msgid "Mana Efficiency"
msgstr "Efektywność many"

#. ~ Description for Mana Efficiency
#: lang/json/mutation_from_json.py
msgid "You are able to store more mana in your body than usual."
msgstr "Jesteś w stanie zgromadzić więcej many w swoim ciele niż zwykle."

