msgstr[2] ""
msgstr[3] ""

#. ~ Description for poleaxe
#: lang/json/GENERIC_from_json.py
msgid ""
"This is a polearm with an axe head, a small hammer on the back, and a short "
"dagger-like spike on top.  It's less heavy than most polearms and has a "
"smaller head, making it slightly quicker."
msgstr ""
"Jest to broń drzewcowa z głowicą w kształcie topora, małym młotkiem na "
"grzbiecie i krótkim, sztyletowatym szpikulcem na szczycie. Jest lżejsza niż "
"większość kijów i ma mniejszą głowicę, co czyni ją nieco szybszą."

#: lang/json/GENERIC_from_json.py
msgid "ji"
msgid_plural "ji"
msgstr[0] "ji"
msgstr[1] "ji"
msgstr[2] "ji"
msgstr[3] "ji"

#. ~ Description for ji
#: lang/json/GENERIC_from_json.py
msgid ""
"This is a bronze polearm that originated in the Shang dynasty of China, if "
"not earlier.  It combines a spear head with the perpendicular blade of the "
"earlier ge or dagger-axe."
msgstr ""
"To broń drzewcowa z brązu pochodząca z chińskiej dynastii Szang, o ile nie "
"wcześniejszej. Łączy ostrze włóczni z księżycowatym ostrzem wcześniejszego "
"ge lub sztyletotopora."

#: lang/json/GENERIC_from_json.py
msgid "stone spear"
