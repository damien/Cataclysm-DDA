#: lang/json/ARMOR_from_json.py
msgid ""
"A simple covering tied over the eyes to block sight, made out of duct tape."
"  Useful for sleeping in bright areas."
msgstr ""
"Prosta osłona zawiązywana na oczy w celu zablokowania wzroku, wykonana z "
"taśmy montażowej. Przydatna do spania w jasnych pomieszczeniach."

