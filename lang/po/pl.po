msgstr[1] "łoje"
msgstr[2] "łoje"
msgstr[3] "łoje"

#. ~ Description for tallow
#: lang/json/COMESTIBLE_from_json.py
msgid ""
"A smooth white block of cleaned and rendered animal fat.  It will remain "
"edible for a very long time, and can be used as an ingredient in many foods "
"and projects."
msgstr ""
"Gładki biały blok oczyszczonego wytopionego tłuszczu zwierzęcego. Pozostaje "
"jadalny przez bardzo długi czas, i wykorzystany do wielu potraw i innych "
"celów."

#: lang/json/COMESTIBLE_from_json.py
