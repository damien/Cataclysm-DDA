#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "CRIT Automatic Rifleman"
msgstr "Strzelec karabinu automatycznego CRIT"

#. ~ Profession (male CRIT Automatic Rifleman) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You were assigned the billet of specializing in creating dead zones and "
"providing support fire.  When the cataclysm struck, your trusty LMG couldn't"
" keep the veritable tide of undead from overtaking your squad.  Now running "
"with all the strength your body can muster, will you have what it takes to "
"survive or is this hellish landscape something you just can't suppress?"
msgstr ""
"Przydzielono ci zadanie specjalizowania się w tworzeniu stref śmierci i "
"zapewnianiu wsparcia ogniowego. Kiedy nadszedł kataklizm, twój wierny "
"karabinek maszynowy nie był w stanie powstrzymać prawdziwej fali "
"nieumarłych, która pochłonęła twój oddział. Czy teraz, biegnąc z całych sił,"
" będziesz w stanie przetrwać, czy też ten piekielny krajobraz jest czymś, "
"czego nie jesteś w stanie stłumić ogniem?"

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "CRIT Automatic Rifleman"
msgstr "Strzelczyni karabinu automatycznego CRIT"

#. ~ Profession (female CRIT Automatic Rifleman) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_female"
msgid ""
"You were assigned the billet of specializing in creating dead zones and "
"providing support fire.  When the cataclysm struck, your trusty LMG couldn't"
" keep the veritable tide of undead from overtaking your squad.  Now running "
