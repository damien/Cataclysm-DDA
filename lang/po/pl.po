#. ~ Description for railgun rifle ammo
#: lang/json/AMMO_from_json.py
msgid ""
"Projectile used for a railgun.  It's made of a ferromagnetic metal, probably"
" cobalt."
msgstr ""
"Pociski stosowane w działach elektromagnetycznych. Zrobione z "
"ferromagnetycznego metalu, zwykle kobaltu."

