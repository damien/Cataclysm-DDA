msgstr[2] "kołczan"
msgstr[3] "kołczan"

#. ~ Description for quiver
#: lang/json/ARMOR_from_json.py
msgid ""
"A leather quiver worn at the waist that can hold 20 arrows or bolts.  Use "
"insert to store arrows or bolts."
msgstr ""
"Skórzany kołczan noszony przy pasie, który może pomieścić 20 strzał lub "
"bełtów. Użyj opcji włóż, aby przechowywać strzały lub bełty."

#: lang/json/ARMOR_from_json.py
msgid "birchbark quiver"
msgid_plural "birchbark quivers"
msgstr[0] "kołczan z brzozy"
msgstr[1] "kołczan z brzozy"
msgstr[2] "kołczan z brzozy"
msgstr[3] "kołczan z brzozy"

#. ~ Description for birchbark quiver
#: lang/json/ARMOR_from_json.py
msgid ""
"A quiver woven from strips of birch bark, worn at the waist, that can hold "
"20 arrows or bolts.  Use insert to store arrows or bolts."
msgstr ""
"Kołczan wypleciony z pasków kory brzozowej, noszony przy pasie, mieszczący "
"20 strzał lub bełtów. Użyj opcji włóż do przechowywania strzał lub bełtów."

#: lang/json/ARMOR_from_json.py
msgid "large quiver"
msgid_plural "large quivers"
msgstr[0] "duży kołczan"
msgstr[1] "duży kołczan"
msgstr[2] "duży kołczan"
msgstr[3] "duży kołczan"

#. ~ Description for large quiver
#: lang/json/ARMOR_from_json.py
msgid ""
"A large leather quiver trimmed with metal, worn on the back, that can hold "
"60 arrows or bolts.  Historically used by horse archers, rather than foot "
"archers, but neither of THEM had to fight zombies.  Use insert to store "
"arrows or bolts."
msgstr ""
"Duży skórzany kołczan obszyty metalem, noszony na plecach, który może "
"pomieścić 60 strzał lub bełtów. Historycznie używany raczej przez konnych "
"łuczników, niż pieszych, ale żaden z nich nie musiał walczyć z zombie. Użyj "
"opcji włóż do przechowywania strzał lub bełtów."

#: lang/json/ARMOR_from_json.py
msgid "large birchbark quiver"
msgid_plural "large birchbark quivers"
msgstr[0] "duży kołczan z brzozy"
msgstr[1] "duży kołczan z brzozy"
msgstr[2] "duży kołczan z brzozy"
msgstr[3] "duży kołczan z brzozy"

#. ~ Description for large birchbark quiver
#: lang/json/ARMOR_from_json.py
msgid ""
"A large quiver woven from strips of birchbark, worn on the back, that can "
"hold 60 arrows or bolts.  Use insert to store arrows or bolts."
msgstr ""
"Duży kołczan wypleciony z pasków kory brzozowej, noszony na plecach, który "
"może pomieścić 60 strzał lub bełtów. Użyj opcji włóż, aby przechowywać "
"strzały lub bełty."

