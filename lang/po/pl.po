#: lang/json/gun_from_json.py
msgid ""
"The EAA Witness is a modified variant of the CZ-75, produced in Italy by "
"Tanfoglio.  This is the standard steel framed version chambered in 10mm "
"Auto."
msgstr ""
"EAA Witness jest zmodyfikowanym wariantem CZ-75, produkowanym we Włoszech "
"przez firmę Tanfoglio. Jest to standardowa wersja o stalowej konstrukcji "
"szkieletu, kaliber 10 mm Auto."

#: lang/json/gun_from_json.py
