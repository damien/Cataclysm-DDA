#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Rookie"
msgstr "Żółtodziób"

#. ~ Profession (male Rookie) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"It's been months since the Cataclysm and somehow you're still greener than a"
" tree.  Maybe you're just a slow learner, who knows."
msgstr ""
"Minęły miesiące od Kataklizmu a jakimś cudem nadal jesteś zielony jak "
"szczypiorek na wiosnę. Może po prostu wolno się uczysz, kto wie?"

