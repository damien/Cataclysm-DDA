msgid_plural "M6 Survival Gun shotguns"
msgstr[0] "strzelba karabinu survivalowego M6"
msgstr[1] "strzelby karabinu survivalowego M6"
msgstr[2] "strzelb karabinu survivalowego M6"
msgstr[3] "strzelby karabinu survivalowego M6"

#: lang/json/gunmod_from_json.py
msgid ""
"The integrated 12 gauge shotgun barrel of the Chiappa M6 Survival Gun.  It's"
" irremovable."
msgstr ""
"Zintegrowana strzelba kalibru 12 w karabinie survivalowym Chiappa M6. Jest "
"nieusuwalna."

#: lang/json/gunmod_from_json.py
