msgstr[2] "strój ochronny"
msgstr[3] "strój ochronny"

#. ~ Description for cleansuit
#: lang/json/ARMOR_from_json.py
msgid ""
"A simple hazardous materials handling suit.  Though somewhat restrictive and"
" fragile, wearing it will provide excellent protection against ambient "
"radiation."
msgstr ""
"Prosty strój służący operowaniu niebezpiecznymi materiałami. Choć trochę "
"ogranicza ruchy i jest dość wrażliwy na uszkodzenia, to znakomicie chroni "
"przed promieniowaniem tła."

#: lang/json/ARMOR_from_json.py
