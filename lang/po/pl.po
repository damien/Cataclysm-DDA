msgstr[2] "kosa bojowa"
msgstr[3] "kosa bojowa"

#. ~ Description for war scythe
#: lang/json/GENERIC_from_json.py
msgid ""
"A pole weapon with a curving single-edged blade.  Its blade bears some "
"superficial resemblance to that of an agricultural scythe from which it "
"likely evolved."
msgstr ""
"Broń drzewcowa z zakrzywionym, jednosiecznym ostrzem. Jej ostrze przypomina "
"powierzchownie kosę rolniczą, z której prawdopodobnie wyewoluowała."

#: lang/json/GENERIC_from_json.py
