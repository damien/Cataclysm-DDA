"sztabkę."

#. ~ Description for tainted blood
#: lang/json/AMMO_from_json.py
msgid ""
"Blood from a blob corrupted creature.  The surface of this black sludge "
"undulates slowly as if agitated by a soft breeze."
msgstr ""
"Krew istoty skażonej śluzem. Powierzchnia tego czarnego szlamu faluje "
"powoli, jakby poruszana delikatną bryzą."

#: lang/json/AMMO_from_json.py
