msgstr "Chemia ze wstrzykiwacza przestaje działać. Czujesz się PASKUDNIE!"

#: lang/json/effects_from_json.py
msgid "RX11 Stimulant Comedown"
msgstr "Zjazd po stymulantach RX11"

#. ~ Description of effect 'RX11 Stimulant Comedown'.
#: lang/json/effects_from_json.py
msgid "You feel sluggish and slow."
msgstr "Czujesz się otępiały i spowolniony."

#: lang/json/effects_from_json.py
msgid "RX11 Stimulant Rush"
msgstr "Odlot po stymulantach RX11"

#. ~ Description of effect 'RX11 Stimulant Rush'.
#: lang/json/effects_from_json.py
msgid "An intense surge of stimulants pulses through your body."
msgstr "Intensywny napływ stymulantów pulsuje w twoim ciele."

#. ~ Apply message for effect(s) 'RX11 Stimulant Comedown, RX11 Stimulant
#. Rush'.
#: lang/json/effects_from_json.py
msgid "You feel an intense surge of stimulants pulse through your body!"
msgstr "Czujesz jak intensywny napływ stymulantów pulsuje w twoim ciele."

#. ~ Decay message for effect(s) 'RX11 Stimulant Comedown, RX11 Stimulant
#. Rush'.
#: lang/json/effects_from_json.py
msgid "The stimulant combo is wearing off.  You feel sluggish."
msgstr "Stymulująca mieszanka przestaje działać. Czujesz się ociężały."

#: lang/json/effects_from_json.py
msgid "Adrenaline Comedown"
msgstr "Zjazd adrenalinowy"

#: lang/json/effects_from_json.py
msgid "Adrenaline Rush"
msgstr "Odlot adrenalinowy"

#. ~ Description of effect 'Adrenaline Rush'.
#: lang/json/effects_from_json.py
msgid "You feel the rush of adrenaline in your body!"
msgstr "Czujesz adrenalinę gwałtownie krążącą w twoim ciele!"

#. ~ Apply message for effect(s) 'Adrenaline Comedown, Adrenaline Rush'.
#: lang/json/effects_from_json.py
msgid "You feel a surge of adrenaline!"
msgstr "Czujesz napływ adrenaliny!"

#. ~ Miss message for effect(s) 'Adrenaline Comedown, Adrenaline Rush'.
#: lang/json/effects_from_json.py
msgid "Your comedown throws you off."
msgstr "Twój zjazd wybija cię z równowagi."

#. ~ Decay message for effect(s) 'Adrenaline Comedown, Adrenaline Rush'.
#: lang/json/effects_from_json.py
msgid "Your adrenaline rush wears off.  You feel AWFUL!"
msgstr "Wpływ adrenaliny ustaje. Czujesz się PASKUDNIE!"

#: lang/json/effects_from_json.py
msgid "Mycus Respite"
msgstr "Grzybnicze wytchnienie"

#. ~ Description of effect 'Mycus Respite'.
#: lang/json/effects_from_json.py
msgid ""
"Our fibers are stretched near breaking.  Local power diverted to regenerate."
msgstr ""
"Nasze włókna są napięte że niemal się rwą. Lokalne siły oddelegowane do "
"regeneracji."

#: lang/json/effects_from_json.py
msgid "Mycus Wrath"
msgstr "Grzybniczy gniew"

#. ~ Description of effect 'Mycus Wrath'.
#: lang/json/effects_from_json.py
msgid "Our enemies are near, and violent action is imminent.  We are turgid."
msgstr "Nasi wrogowie są w pobliżu a przemoc nadchodzi. Jesteśmy nabrzmiali."

#. ~ Apply message for effect(s) 'Mycus Respite, Mycus Wrath'.
#: lang/json/effects_from_json.py
msgid "Mycal wrath fills our fibers, and we grow turgid."
msgstr "Grzybiczy gniew wypełnia nasze włókna i puchniemy."

#. ~ Decay message for effect(s) 'Mycus Respite, Mycus Wrath'.
#: lang/json/effects_from_json.py
msgid "We require repose; our fibers are nearly spent…"
msgstr "Potrzebujemy wytchnienia; nasze włókna są na wyczerpaniu…"

#: lang/json/effects_from_json.py
msgid "Meth comedown"
msgstr "Zjazd po mecie"

#: lang/json/effects_from_json.py
msgid "High on Meth"
msgstr "Odlot po mecie"

#: lang/json/effects_from_json.py
msgid "Nicotine"
msgstr "Nikotyna"

#: lang/json/effects_from_json.py
msgid "You had a puff or two."
msgstr "Sztachnięto się raz czy dwa."

#: lang/json/effects_from_json.py
msgid "You smoked too much."
msgstr "Za dużo wypalono."

#: lang/json/effects_from_json.py
msgid "High"
msgstr "Odlot"

#. ~ Description of effect 'High'.
#: lang/json/effects_from_json.py
msgid "You are high as a kite."
msgstr "Jesteś naćpany jak delfin."

#. ~ Apply message for effect(s) 'High'.
#. ~ Apply message for effect(s) 'Tipsy, Drunk, Trashed, Wasted, Dead Drunk'.
#: lang/json/effects_from_json.py
msgid "You feel lightheaded."
msgstr "Czujesz zawroty głowy i oszołomienie."

#: lang/json/effects_from_json.py
msgid ""
"That critter's jumping around like a jitterbug!  It needs to mellow out."
msgstr "To stworzenie skacze wokół jak oszalałe! Powinno się odprężyć."

#: lang/json/effects_from_json.py
msgid "Contact Lenses"
msgstr "Soczewki kontaktowe"

#. ~ Description of effect 'Contact Lenses'.
#: lang/json/effects_from_json.py
msgid "You are wearing contact lenses."
msgstr "Nosisz soczewki kontaktowe."

#. ~ Apply message for effect(s) 'Contact Lenses'.
#: lang/json/effects_from_json.py
msgid "You can see more clearly."
msgstr "Widzisz wyraźniej."

#. ~ Remove message for effect(s) 'Contact Lenses'.
#: lang/json/effects_from_json.py
msgid "Your vision starts to blur."
msgstr "Twój wzrok się rozmywa."

#: lang/json/effects_from_json.py
msgid "Tipsy"
msgstr "Podchmielony"

#. ~ Description of effect 'Tipsy'.
#: lang/json/effects_from_json.py
msgid "You drank some alcohol.  You feel warm inside."
msgstr "Wypiłeś nieco alkoholu. Czujesz ciepło w brzuchu."

#: lang/json/effects_from_json.py
msgid "Drunk"
msgstr "Pijany"

#. ~ Description of effect 'Drunk'.
#: lang/json/effects_from_json.py
msgid "You drank alcohol.  Party on!"
msgstr "Napiłeś się alkoholu. Impreza trwa!"

#: lang/json/effects_from_json.py
msgid "Trashed"
msgstr "Nawalony"

#. ~ Description of effect 'Trashed'.
#: lang/json/effects_from_json.py
msgid "You drank lots of alcohol.  Are those white mice?"
msgstr "Wypiłeś dużo alkoholu. Czy to białe myszki?"

#: lang/json/effects_from_json.py
msgid "Wasted"
msgstr "Urżnięty w trupa"

#. ~ Description of effect 'Wasted'.
#: lang/json/effects_from_json.py
msgid ""
"You drank unholy amounts of alcohol.  It's the end of the world, what do you"
" care?"
msgstr ""
"Wypiłeś nieziemskie ilości alkoholu. To koniec świata, co cię to obchodzi?"

#: lang/json/effects_from_json.py
msgid "Dead Drunk"
msgstr "Pijany w sztok"

#. ~ Description of effect 'Dead Drunk'.
#: lang/json/effects_from_json.py
msgid ""
"You embalmed yourself alive with so much alcohol, that even zombies will "
"leave your dead body alone."
msgstr ""
"Wlałeś w siebie tyle alkoholu, że twój akt można by było nazwać "
"autotanatopraksją. Słodkich snów."

#. ~ Miss message for effect(s) 'Tipsy, Drunk, Trashed, Wasted, Dead Drunk'.
#. ~ Miss message for effect(s) 'Depressants'.
#: lang/json/effects_from_json.py
msgid "You feel woozy."
msgstr "Czujesz się zamroczony."

#: lang/json/effects_from_json.py
msgid "You can't look away from the faultline…"
msgstr "Nie możesz oderwać wzroku od uskoku…"

#: lang/json/effects_from_json.py
msgid "Feared"
msgstr "Przerażenie"

#. ~ Description of effect 'Feared'.
#: lang/json/effects_from_json.py
msgid "You have been paralyzed by the fear."
msgstr "Paraliżuje cię strach."

#: lang/json/effects_from_json.py
msgid "Asthma"
msgstr "Astma"

#: lang/json/effects_from_json.py
msgid "Heavy Asthma"
msgstr "Ciężka astma"

#: lang/json/effects_from_json.py
msgid ""
"You suffer from a respiratory disorder that makes breathing difficult.\n"
"An asthma attack can occur from time to time, so have your inhaler nearby."
msgstr ""
"Cierpisz na schorzenie układu oddechowego, które utrudnia oddychanie.\n"
"Od czasu do czasu może ci się przydarzyć atak astmy, więc miej w pobliżu inhalator."

#. ~ Apply message for effect(s) 'Asthma, Asthma, Asthma, Asthma, Heavy
#. Asthma, Heavy Asthma'.
#: lang/json/effects_from_json.py
msgid "You can't breathe… asthma attack!"
msgstr "Nie możesz oddychać… atak astmy!"

#. ~ Miss message for effect(s) 'Asthma, Asthma, Asthma, Asthma, Heavy Asthma,
#. Heavy Asthma'.
#: lang/json/effects_from_json.py
msgid "You're winded."
msgstr "Jesteś pozbawiony tchu."

#: lang/json/effects_from_json.py
msgid "The ceiling collapses on you!"
msgstr "Dach zapada się na ciebie!"

#: lang/json/effects_from_json.py
msgid "Took anticonvulsant drugs"
msgstr "Zażyłeś antykonwulsanty"

#. ~ Description of effect 'Took anticonvulsant drugs'.
#: lang/json/effects_from_json.py
msgid ""
"You took anticonvulsant drugs some time ago and you might still be under its influence.\n"
"Prescription note says its effect duration may vary, so your estimate may be inaccurate."
msgstr ""
"Zażyłeś leki przeciw konwulsjom jakiś czas temu i możesz być nadal pod ich wpływem.\n"
"Ulotka mówiła, że czas działania może być zmienny, więc twoja ocena może być nieprecyzyjna."

#: lang/json/effects_from_json.py
msgid "Relaxation gas"
msgstr "Gaz odprężajacy"

#. ~ Description of effect 'Relaxation gas'.
#: lang/json/effects_from_json.py
msgid ""
"You are thoroughly relaxed and don't feel like moving.  Fighting?  Too much "
"effort."
msgstr ""
"Jesteś na wskroś zrelaksowany i nie masz ochoty się ruszać. Walczyć? Za dużo"
" zachodu."

#. ~ Apply message for effect(s) 'Relaxation gas'.
#: lang/json/effects_from_json.py
msgid "You inhale sweetish gas."
msgstr "Wdychasz słodkawy gaz."

#. ~ Remove message for effect(s) 'Relaxation gas'.
#: lang/json/effects_from_json.py
msgid "The slackness leaves your muscles."
msgstr "Ospałość opuszcza twe mięśnie."

#: lang/json/effects_from_json.py
msgid "Experiencing Datura"
msgstr "Doświadczasz działania bielunia"

#. ~ Description of effect 'Experiencing Datura'.
#: lang/json/effects_from_json.py
msgid "Buy the ticket, take the ride.  The datura has you now."
msgstr "Kup bilet, przejedź się. Bieluń cię teraz trzyma."

#: lang/json/effects_from_json.py
msgid "Grabbed"
msgstr "Schwytanie"

#. ~ Description of effect 'Grabbed'.
#: lang/json/effects_from_json.py
msgid ""
"You have been grabbed by an attack.\n"
"You are being held in place, and dodging and blocking are very difficult."
msgstr ""
"Zostałeś złapany.\n"
"Jesteś trzymany w miejscu - wykonanie uniku lub bloku będzie dla ciebie ciężkie."

#: lang/json/effects_from_json.py
msgid "Grabbing"
msgstr "Chwyt"

#. ~ Description of effect 'Grabbing'.
#: lang/json/effects_from_json.py
msgid "Grabbing another creature and holding them in place."
msgstr "Złapanie innej istoty i trzymanie jej w miejscu."

#: lang/json/effects_from_json.py
msgid "Lacking Sleep"
msgstr "Brakuje snu"

#. ~ Description of effect 'Lacking Sleep'.
#: lang/json/effects_from_json.py
msgid "You haven't slept in a while, and it shows."
msgstr "Długo już nie spałeś i to widać po tobie."

#. ~ Apply message for effect(s) 'Lacking Sleep'.
#: lang/json/effects_from_json.py
msgid "You are too physically tired to function well."
msgstr "Jesteś zbyt zmęczony fizycznie by dobrze funkcjonować."

#. ~ Miss message for effect(s) 'Lacking Sleep'.
#: lang/json/effects_from_json.py
msgid "You don't have energy to fight."
msgstr "Nie masz energii do walki."

#: lang/json/effects_from_json.py
msgid "You lie down to go to sleep…"
msgstr "Kładziesz się by zasnąć…"

#: lang/json/effects_from_json.py src/mutation_data.cpp
msgid "You fall asleep."
msgstr "Zasypiasz."

#: lang/json/effects_from_json.py
msgid "You wake up."
msgstr "Budzisz się."

#: lang/json/effects_from_json.py
msgid "Under operation"
msgstr "Operowany"

#. ~ Description of effect 'Under operation'.
#: lang/json/effects_from_json.py
msgid "You are being operated on.  Try to stay still."
msgstr ""
"Właśnie wykonuje się na tobie operację. Może… może nie ruszaj się przez "
"chwilę."

#: lang/json/effects_from_json.py
msgid "Playing an instrument"
msgstr "Gra na instrumencie"

#. ~ Description of effect 'Playing an instrument'.
#: lang/json/effects_from_json.py
msgid ""
"You're playing an instrument.\n"
"Focusing on playing music distracts you, slowing you down."
msgstr ""
"Grasz na instrumencie.\n"
"Skupienie na graniu muzyki pochłania twoją uwagę, spowalniając cię."

#: lang/json/effects_from_json.py
msgid "Corroding"
msgstr "Korozja"

#. ~ Description of effect 'Corroding'.
#. ~ Apply message for effect(s) 'Corroding'.
#: lang/json/effects_from_json.py
msgid "You're covered in acid!"
msgstr "Jesteś pokryty kwasem!"

#: lang/json/effects_from_json.py
msgid "Zapped"
msgstr "Porażenie"

#. ~ Description of effect 'Zapped'.
#: lang/json/effects_from_json.py
msgid "You've been zapped with electricity and are barely able to move!"
msgstr "Poraził cię prąd i ledwo możesz się ruszać!"

#. ~ Apply message for effect(s) 'Zapped'.
#: lang/json/effects_from_json.py
msgid "You're zapped!"
msgstr "Poraziło cię prądem!"

#: lang/json/effects_from_json.py
msgid "Early iron deficiency"
msgstr "Wczesny niedobór żelaza"

#. ~ Description of effect 'Early iron deficiency'.
#: lang/json/effects_from_json.py
msgid ""
"A lack of iron in your diet has hampered the efficiency and regeneration of "
"your red blood cells."
msgstr ""
"Brak żelaza w diecie osłabił efektywność czerwonych krwinek w tym proces ich"
" regeneracji."

#: lang/json/effects_from_json.py
msgid "Iron deficiency"
msgstr "Niedobór żelaza"

#. ~ Description of effect 'Iron deficiency'.
#: lang/json/effects_from_json.py
msgid ""
"Prolonged lack of iron in your diet has compromised the efficiency and "
"regeneration of your red blood cells."
msgstr ""
"Przedłużający się brak żelaza w diecie obniżył efektywność czerwonych "
"krwinek w tym proces ich regeneracji."

#: lang/json/effects_from_json.py
msgid "Acute iron deficiency"
msgstr "Ostry niedobór żelaza"

#. ~ Description of effect 'Acute iron deficiency'.
#: lang/json/effects_from_json.py
msgid ""
"Severe lack of iron in your diet results in your red blood cells dying "
"faster then they are regenerating."
msgstr ""
"Poważny niedobór żelaza w diecie powoduje, że twoje czerwone krwinki "
"obumierają szybciej niż się regenerują."

#. ~ Apply message for effect(s) 'Early iron deficiency, Iron deficiency,
#. Acute iron deficiency'.
#. ~ Apply message for effect(s) 'Early anemia, Anemia, Acute anemia'.
#: lang/json/effects_from_json.py
msgid "You begin feeling increasingly tired and listless."
msgstr "Czujesz się coraz bardziej zmęczony i apatyczny."

#. ~ Remove message for effect(s) 'Early iron deficiency, Iron deficiency,
#. Acute iron deficiency'.
#: lang/json/effects_from_json.py
msgid "You are no longer in risk of becoming anemic."
msgstr "Nie grozi ci już anemia."

#. ~ Decay message for effect(s) 'Early iron deficiency, Iron deficiency,
#. Acute iron deficiency'.
#: lang/json/effects_from_json.py
msgid "Your iron deficiency is nearly resolved."
msgstr "Twój niedobór żelaza jest już prawie uzupełniony."

#. ~ Decay message for effect(s) 'Early iron deficiency, Iron deficiency,
#. Acute iron deficiency'.
#: lang/json/effects_from_json.py
msgid "Your feel stronger as your iron deficiency starts to improve."
msgstr "Czujesz się silniejszy gdy zmniejsza się twój niedobór żelaza."

#: lang/json/effects_from_json.py
msgid "Early anemia"
msgstr "Wczesna anemia"

#: lang/json/effects_from_json.py
msgid "Anemia"
msgstr "Anemia"

#: lang/json/effects_from_json.py
msgid "Acute anemia"
msgstr "Ostra anemia"

#: lang/json/effects_from_json.py
msgid "Loss of red blood cells results in progressively worsening anemia."
msgstr "Utrata czerwonych krwinek powoduje pogarszającą się z czasem anemię."

#. ~ Remove message for effect(s) 'Early anemia, Anemia, Acute anemia'.
#: lang/json/effects_from_json.py
msgid "You no longer feel anemic."
msgstr "Nie czujesz się już anemicznie."

#. ~ Decay message for effect(s) 'Early anemia, Anemia, Acute anemia'.
#: lang/json/effects_from_json.py
msgid "Your anemia is nearly resolved."
msgstr "Anemia już niemal ustąpiła."

#. ~ Decay message for effect(s) 'Early anemia, Anemia, Acute anemia'.
#: lang/json/effects_from_json.py
msgid "Your feel stronger as your anemia starts to improve."
msgstr "Czujesz się silniejszy gdy maleje twoja anemia."

#: lang/json/effects_from_json.py
msgid "Early scurvy"
msgstr "Wczesny szkorbut"

#: lang/json/effects_from_json.py
msgid "Scurvy"
msgstr "Szkorbut"

#: lang/json/effects_from_json.py
msgid "Bad Scurvy"
msgstr "Zaawansowany szkorbut"

#: lang/json/effects_from_json.py
msgid ""
"A lack of vitamin C in your diet will result in progressively worse symptoms"
" of scurvy."
msgstr ""
"Brak witaminy A w twojej diecie powoduje pogarszające się symptomy "
"szkorbutu."

#. ~ Apply message for effect(s) 'Early scurvy, Scurvy, Bad Scurvy'.
#: lang/json/effects_from_json.py
msgid "You start to develop symptoms of scurvy."
msgstr "Pojawiają się u ciebie symptomy szkorbutu."

#. ~ Remove message for effect(s) 'Early scurvy, Scurvy, Bad Scurvy'.
#: lang/json/effects_from_json.py
msgid "Your scurvy has resolved."
msgstr "Szkorbut ustąpił."

#. ~ Decay message for effect(s) 'Early scurvy, Scurvy, Bad Scurvy'.
#: lang/json/effects_from_json.py
msgid "Your vitamin C deficiency is starting to resolve."
msgstr "Twój niedobór witaminy C jest już prawie uzupełniony."

#. ~ Decay message for effect(s) 'Early scurvy, Scurvy, Bad Scurvy'.
#: lang/json/effects_from_json.py
msgid "Your scurvy lessens as your Vitamin C deficiency improves."
msgstr ""
"Twój szkorbut wchodzi w fazę remisji gdy zmniejsza się deficyt witaminy C."

#: lang/json/effects_from_json.py
msgid "Hypervitaminosis"
msgstr "Hiperwitaminoza"

#. ~ Description of effect 'Hypervitaminosis'.
#: lang/json/effects_from_json.py
msgid "An excess of vitamins has badly affected your metabolism."
msgstr "Nadmiar witamin źle wpłyną na twój metabolizm."

#. ~ Apply message for effect(s) 'Hypervitaminosis'.
#: lang/json/effects_from_json.py
msgid "Your metabolism becomes unstable."
msgstr "Twój metabolizm staje się niestabilny."

#. ~ Remove message for effect(s) 'Hypervitaminosis'.
#: lang/json/effects_from_json.py
msgid "Your metabolism becomes more stable."
msgstr "Twój metabolizm stabilizuje się."

#: lang/json/effects_from_json.py
msgid "Concerning symptoms"
msgstr "Zastanawiające symptomy"

#. ~ Description of effect 'Concerning symptoms'.
#: lang/json/effects_from_json.py
msgid "Your muscles keep twitching strangely."
msgstr "Czujesz dziwny ucisk w mięśniach."

#: lang/json/effects_from_json.py
msgid "Unnerving symptoms"
msgstr "Niepokojące symptomy"

#. ~ Description of effect 'Unnerving symptoms'.
#: lang/json/effects_from_json.py
msgid ""
"Your nervous system is malfunctioning, almost like it's being torn apart "
"from the inside."
msgstr ""
"Twój system nerwowy nie działa poprawnie - czujesz jakbyś był rozrywany od "
"środka."

#: lang/json/effects_from_json.py
msgid "Gross food"
msgstr "Ohydne żarcie"

#. ~ Description of effect 'Gross food'.
#: lang/json/effects_from_json.py
msgid "The food you eat is disgusting."
msgstr "Pożywienie którym się żywisz jest obrzydliwe."

#: lang/json/effects_from_json.py
msgid "Demoralizing food"
msgstr "Demoralizujące żarcie"

#. ~ Description of effect 'Demoralizing food'.
#: lang/json/effects_from_json.py
msgid "Eating nothing but disgusting rations is starting to get you down."
msgstr ""
"Jedzenie wciąż tylko paskudnych racji żywnościowych zaczyna źle wpływać na "
"twoje samopoczucie."

#: lang/json/effects_from_json.py
msgid "Depressing food"
msgstr "Depresyjne żarcie"

#. ~ Description of effect 'Depressing food'.
#: lang/json/effects_from_json.py
msgid ""
"Sure, you survived, but what kind of survival is this, eating these "
"disgusting rations day in and day out?"
msgstr ""
"Jasne, jeszcze żyjesz, ale co to za życie skoro jesz to samo obrzydlistwo na"
" śniadanie i kolację."

#: lang/json/effects_from_json.py
msgid "Mild hypovolemic shock"
msgstr "Łagodny wstrząs hipowolemiczny"

#. ~ Description of effect 'Mild hypovolemic shock'.
#: lang/json/effects_from_json.py
msgid "You've lost some blood and look somewhat pale."
msgstr "Stracono trochę krwi i wyglądasz blado."

#: lang/json/effects_from_json.py
msgid "Moderate hypovolemic shock"
msgstr "Umiarkowany wstrząs hipowolemiczny"

#. ~ Description of effect 'Moderate hypovolemic shock'.
#: lang/json/effects_from_json.py
msgid "You've lost a large amount of blood, and you're not feeling well."
msgstr "Stracono dużo krwi i nie czujesz się najlepiej."

#: lang/json/effects_from_json.py
msgid "Advanced hypovolemic shock"
msgstr "Zaawansowany wstrząs hipowolemiczny"

#. ~ Description of effect 'Advanced hypovolemic shock'.
#: lang/json/effects_from_json.py
msgid ""
"You've lost an awful lot of blood, and your condition is severe.  Seek "
"medical attention."
msgstr ""
"Stracono mnóstwo krwi i twój stan jest poważny. Potrzebna ci pomoc medyczna."

#: lang/json/effects_from_json.py
msgid "Severe hypovolemic shock"
msgstr "Ostry wstrząs hipowolemiczny"

#. ~ Description of effect 'Severe hypovolemic shock'.
#: lang/json/effects_from_json.py
msgid ""
"You've lost tremendous amount of blood, and you're standing on death's door."
"  Transfusion might save you."
msgstr ""
"Stracono tak dużo krwi, że stoisz na progu śmierci. Transfuzja może cię "
"uratować."

#. ~ Apply message for effect(s) 'Mild hypovolemic shock, Moderate hypovolemic
#. shock, Advanced hypovolemic shock, Severe hypovolemic shock'.
#: lang/json/effects_from_json.py
msgid "You have lost a lot of blood, and your condition worsens."
msgstr "Stracono dużo krwi i twoja kondycja się pogarsza."

#. ~ Remove message for effect(s) 'Mild hypovolemic shock, Moderate
#. hypovolemic shock, Advanced hypovolemic shock, Severe hypovolemic shock'.
#: lang/json/effects_from_json.py
msgid "You are no longer in shock."
msgstr "Nie jesteś już pod wpływem wstrząsu."

#. ~ Decay message for effect(s) 'Mild hypovolemic shock, Moderate hypovolemic
#. shock, Advanced hypovolemic shock, Severe hypovolemic shock'.
#: lang/json/effects_from_json.py
msgid ""
"Your blood volume increases, and you feel better; but still, you look pale."
msgstr "Poziom twojej krwi się poprawia, ale nadal wyglądasz blado."

#. ~ Decay message for effect(s) 'Mild hypovolemic shock, Moderate hypovolemic
#. shock, Advanced hypovolemic shock, Severe hypovolemic shock'.
#: lang/json/effects_from_json.py
msgid "You feel stronger as your blood volume starts to improve."
msgstr "Czujesz siłę, gdy poziom twojej krwi się poprawia."

#. ~ Decay message for effect(s) 'Mild hypovolemic shock, Moderate hypovolemic
#. shock, Advanced hypovolemic shock, Severe hypovolemic shock'.
#: lang/json/effects_from_json.py
msgid ""
"You're not dying from lack of blood, but you're not out of the woods yet."
msgstr "Nie umierasz już z wykrwawienia, ale jeszcze daleka droga do domu."

#: lang/json/effects_from_json.py
msgid "Lit up"
msgstr "Oświetlenie"

#. ~ Description of effect 'Lit up'.
#: lang/json/effects_from_json.py
msgid "You are carrying a light and can't hide well."
msgstr "Nosisz źródło światła i nie możesz się dobrze ukryć."

#: lang/json/effects_from_json.py
msgid "Started recovery"
msgstr "Rozpoczyna powrót do zdrowia"

#: lang/json/effects_from_json.py
msgid "Recovering"
msgstr "W trakcie regeneracji"

#: lang/json/effects_from_json.py
msgid "Mostly recovered"
msgstr "Prawie uzdrowione"

#: lang/json/effects_from_json.py
msgid "This damaged limb is slowly regaining its functions."
msgstr "Ta uszkodzona kończyna powoli odzyskuje funkcjonowanie."

#: lang/json/effects_from_json.py
msgctxt "physically"
msgid "Disabled"
msgstr "Kaleka"

#. ~ Description of effect '{'ctxt': 'physically', 'str': 'Disabled'}'.
#: lang/json/effects_from_json.py
msgid "This limb is damaged beyond use and may require a splint to recover."
msgstr ""
"Ta kończyna jest uszkodzona poza próg zdatności do korzystania z niej i może"
" wymagać szyn, by się zregenerować."

#. ~ Apply message for effect(s) 'Disabled'.
#: lang/json/effects_from_json.py lang/json/snippet_from_json.py
msgid "Your limb breaks!"
msgstr "Twoja kończyna łamie się!"

#. ~ Remove message for effect(s) 'Disabled'.
#: lang/json/effects_from_json.py
msgid "The broken limb has mended."
msgstr "Złamana kończyna zrosła się."

#: lang/json/effects_from_json.py
msgid "Milked"
msgstr "Wydojone"

#. ~ Description of effect 'Milked'.
#: lang/json/effects_from_json.py
msgid "The creature has been partially or fully milked."
msgstr "To stworzenie zostało częściowo lub całkowicie wydojone."

#: lang/json/effects_from_json.py
msgid "Sheared"
msgstr "Ostrzyżone"

#. ~ Description of effect 'Sheared'.
#: lang/json/effects_from_json.py
msgid "The creature has been fully sheared."
msgstr "To stworzenie zostało całkowicie ostrzyżone."

#: lang/json/effects_from_json.py
msgid "Painkillers"
msgstr "Środki przeciwbólowe"

#. ~ Description of effect 'Painkillers'.
#: lang/json/effects_from_json.py
msgid ""
"You are under the influence of analgesic substances to relieve pain, but "
"they may numb you a bit."
msgstr ""
"Jesteś pod wpływem środków uśmierzających ból, ale mogą cie one trochę "
"otępić."

#: lang/json/effects_from_json.py
msgid "Happy"
msgstr "Szczęście"

#. ~ Description of effect 'Happy'.
#: lang/json/effects_from_json.py
msgid "Life is good."
msgstr "Życie jest dobre."

#: lang/json/effects_from_json.py
msgid "Joyful"
msgstr "Radość"

#. ~ Description of effect 'Joyful'.
#: lang/json/effects_from_json.py
msgid "Oh what a day!  What a lovely day!"
msgstr "Oh co za dzień! Co za cudny dzień!"

#: lang/json/effects_from_json.py
msgid "Elated"
msgstr "Upojenie"

#. ~ Description of effect 'Elated'.
#: lang/json/effects_from_json.py
msgid "I'm on top of the world, baby!"
msgstr "Jestem na szczycie świata, dziecino!"

#: lang/json/effects_from_json.py
msgid "Unhappy"
msgstr "Nieszczęście"

#. ~ Description of effect 'Unhappy'.
#: lang/json/effects_from_json.py
msgid "You are not content with your life."
msgstr "Nie odczuwasz zadowolenia ze swojego życia."

#: lang/json/effects_from_json.py
msgid "Sad"
msgstr "Smutek"

#. ~ Description of effect 'Sad'.
#: lang/json/effects_from_json.py
msgid "This is not what you planned for your life."
msgstr "Nie to było planem na twoje życie."

#: lang/json/effects_from_json.py
msgid "Depressed"
msgstr "Depresja"

#. ~ Description of effect 'Depressed'.
#: lang/json/effects_from_json.py
msgid "When will all your suffering end?"
msgstr "Kiedy się skończą twoje cierpienia?"

#. ~ Miss message for effect(s) 'Unhappy, Unhappy, Unhappy, Unhappy, Unhappy,
#. Sad, Sad, Sad, Sad, Sad, Depressed'.
#: lang/json/effects_from_json.py
msgid "What's the point of fighting?"
msgstr "Po co walczyć?"

#: lang/json/effects_from_json.py
msgid "Weakness"
msgstr "Osłabienie"

#: lang/json/effects_from_json.py
msgid "Stimulants"
msgstr "Stymulanty"

#. ~ Description of effect 'Stimulants'.
#: lang/json/effects_from_json.py
msgid "You're very jittery and pumped up, probably from some stimulants."
msgstr "Czujesz roztrzęsienie i nakręcenie, zapewne po stymulantach."

#: lang/json/effects_from_json.py
msgid "Depressants"
msgstr "Depresanty"

#. ~ Description of effect 'Depressants'.
#: lang/json/effects_from_json.py
msgid "You are under the influence of depressants, and in a bit of a daze."
msgstr ""
"Jesteś pod wpływem środków uspokajających i czujesz lekkie oszołomienie."

#: lang/json/effects_from_json.py
msgid "Stimulant Overdose"
msgstr "Przedawkowanie stymulantów"

#. ~ Description of effect 'Stimulant Overdose'.
#: lang/json/effects_from_json.py
msgid ""
"You can't sit still as you feel your heart pounding out of your chest.  You "
"probably overdosed on those stims."
msgstr ""
"Nie możesz usiedzieć w miejscu i słyszysz jak serce łomocze ci w piersi. "
"Pewnie przedawkowano te stymulanty."

#. ~ Miss message for effect(s) 'Stimulant Overdose'.
#: lang/json/effects_from_json.py
msgid "You shake with the excess stimulation."
msgstr "Trzęsiesz się od nadmiernej stymulacji."

#: lang/json/effects_from_json.py
msgid "Took weak antibiotic"
msgstr "Zażyty słaby antybiotyk"

#. ~ Description of effect 'Took weak antibiotic'.
#: lang/json/effects_from_json.py
msgid ""
"You consumed mild antibiotic some time ago to fight off infection.\n"
"If you don't recover you may want to take another dose, but beware overdosage."
msgstr ""
"Zażyto słaby antybiotyk jakiś czas temu, by zwalczyć infekcję.\n"
"Jeśli się nie wyliżesz możesz chcieć zażyć kolejną dawkę, ale uważaj, żeby nie przedawkować."

#: lang/json/effects_from_json.py
msgid "Took antibiotic"
msgstr "Zażyty antybiotyk"

#. ~ Description of effect 'Took antibiotic'.
#: lang/json/effects_from_json.py
msgid ""
"You consumed antibiotic some time ago to fight off infection.\n"
"If you don't recover you may want to take another dose, but beware overdosage."
msgstr ""
"Zażyto antybiotyk jakiś czas temu, by zwalczyć infekcję.\n"
"Jeśli się nie wyliżesz możesz chcieć zażyć kolejną dawkę, ale uważaj, żeby nie przedawkować."

#: lang/json/effects_from_json.py
msgid "Took strong antibiotic"
msgstr "Zażyty silny antybiotyk"

#. ~ Description of effect 'Took strong antibiotic'.
#: lang/json/effects_from_json.py
msgid ""
"You consumed prescription-grade antibiotic some time ago to fight off infection.\n"
"If you don't recover you may want to take another dose, but beware overdosage."
msgstr ""
"Zażyto silny antybiotyk na receptę jakiś czas temu, by zwalczyć infekcję.\n"
"Jeśli się nie wyliżesz możesz chcieć zażyć kolejną dawkę, ale uważaj, żeby nie przedawkować."

#: lang/json/effects_from_json.py
msgid "Panacea"
msgstr "Panaceum"

#. ~ Description of effect 'Panacea'.
#: lang/json/effects_from_json.py
msgid "You feel incredible!  You could take on the world!"
msgstr "Czujesz wyśmienicie! Możesz stawić czoła całemu światu!"

#: lang/json/effects_from_json.py
msgid "Soothed stomach"
msgstr "Uspokojony żołądek"

#. ~ Description of effect 'Soothed stomach'.
#: lang/json/effects_from_json.py
msgid "You are under the effects of a stomach soother."
msgstr "Jesteś pod wpływem leku na dolegliwości żołądkowe."

#: lang/json/effects_from_json.py
msgid "Antifungals"
msgstr "Środki przeciwgrzybiczne"

#. ~ Description of effect 'Antifungals'.
#: lang/json/effects_from_json.py
msgid "You are under the effects of an antifungal medicine or chemicals."
msgstr "Jesteś pod wpływem leków lub chemikaliów grzybobójczych."

#: lang/json/effects_from_json.py
msgid "Discharge"
msgstr "Wyładowanie"

#. ~ Description of effect 'Discharge'.
#: lang/json/effects_from_json.py
msgid "You've been recently affected by an electromagnetic pulse."
msgstr "Niedawno doświadczono impulsu elektromagnetycznego."

#: lang/json/effects_from_json.py
msgid "Supercharged"
msgstr "Przeładowanie"

#. ~ Description of effect 'Supercharged'.
#: lang/json/effects_from_json.py
msgid "You've been struck by lightning, and feel… different."
msgstr "Trafił cię piorun i czujesz się… inaczej."

#: lang/json/effects_from_json.py
msgid "Grown of Fusion"
msgstr "Wzrost po fuzji"

#. ~ Description of effect 'Grown of Fusion'.
#: lang/json/effects_from_json.py
msgid ""
"AI effect to increase stats after fusing with another critter.  1 stack "
"means one absorbed max_hp."
msgstr ""
"Efekt SI zwiększający statystyki po fuzji z innym stworzeniem. 1 poziom "
"oznacza jeden zaabsorbowany max_hp."

#: lang/json/effects_from_json.py
msgid "Stinking air"
msgstr "Śmierdzące powietrze"

#. ~ Description of effect 'Stinking air'.
#: lang/json/effects_from_json.py
msgid "The air in here smells like vinegar and mold."
msgstr "Tutejsze powietrze cuchnie jak ocet i pleśń."

#: lang/json/effects_from_json.py
msgid "Disorienting air"
msgstr "Dezorientujące powietrze"

#. ~ Description of effect 'Disorienting air'.
#: lang/json/effects_from_json.py
msgid ""
"The air in here smells like vinegar and mold.  It makes you feel soft-headed"
" and confused."
msgstr ""
"Tutejsze powietrze cuchnie jak ocet i pleśń. Przyprawia cię o zawroty głowy "
"i zamęt."

#: lang/json/effects_from_json.py
msgid "Smothering air"
msgstr "Dławiące powietrze"

#. ~ Description of effect 'Smothering air'.
#: lang/json/effects_from_json.py
msgid ""
"The air in here smells like vinegar and mold.  It is closing in and "
"smothering you, making it impossible to think clearly."
msgstr ""
"Tutejsze powietrze cuchnie jak ocet i pleśń. Czujesz jak cię przytłacza i "
"dławi, tak że ledwo utrzymujesz tok myślenia."

#. ~ Apply message for effect(s) 'Stinking air, Disorienting air, Disorienting
#. air, Smothering air, Smothering air'.
#: lang/json/effects_from_json.py
msgid ""
"The air in here smells like vinegar and mold, and hurts your lungs a bit."
msgstr ""
"Tutejsze powietrze cuchnie jak ocet i pleśń i trochę pali cię w płucach."

#. ~ Miss message for effect(s) 'Stinking air, Disorienting air, Disorienting
#. air, Smothering air, Smothering air'.
#: lang/json/effects_from_json.py
msgid "You feel groggy in this sweltering, foul air."
msgstr "Czujesz zamroczenie w tym dusznym, zatęchłym powietrzu."

#: lang/json/effects_from_json.py
msgid "Covered in fetid goop"
msgstr "Pokryty cuchnącym szlamem"

#. ~ Description of effect 'Covered in fetid goop'.
#: lang/json/effects_from_json.py
msgid ""
"The feeling of the goop slowly sliding on your skin revulses you and the "
"smell makes you gag."
msgstr ""
"Uczucie szlamu powoli ściekającego po twojej skórze przyprawia cię o mdłości"
" i masz ochotę puścić pawia."

#. ~ Apply message for effect(s) 'Covered in fetid goop'.
#: lang/json/effects_from_json.py
msgid "You're disgusted by the goop."
msgstr "Obrzydza cię szlam."

#: lang/json/effects_from_json.py
msgid "Incorporeal"
msgstr "Bezcielesność"

#. ~ Description of effect 'Incorporeal'.
#: lang/json/effects_from_json.py
msgid "You lack substance, as if composed of mist."
msgstr "Nie posiadasz substancji, jakby składać się z mgły."

#: lang/json/effects_from_json.py
msgid "Lightly Weary"
msgstr "Lekkie strudzenie"

#. ~ Description of effect 'Lightly Weary'.
#: lang/json/effects_from_json.py
msgid ""
"You've been pretty active for a while; operating at the highest levels of activity will be impaired.\n"
"The following move penalties are applied for the following activity levels:\n"
"Extreme: 1.25x"
msgstr ""
"Byłeś dość aktywny przez pewien czas; działanie na pełnej aktywności będzie ograniczone.\n"
"Następujące kary do punktów ruchu mają zastosowanie dla odpowiednich poziomów aktywności:\n"
"Ekstremalne: 1,25x"

#: lang/json/effects_from_json.py
msgid "Moderately Weary"
msgstr "Umiarkowane strudzenie"

#. ~ Description of effect 'Moderately Weary'.
#: lang/json/effects_from_json.py
msgid ""
"You've been quite active for a while; operating at higher levels of activity will be impaired.\n"
"The following move penalties are applied for the following activity levels:\n"
"Extreme: 1.67x, Active: 1.33x"
msgstr ""
"Byłeś dość aktywny przez dłuższy czas; działanie na wyższych poziomach aktywności będzie ograniczone.\n"
"Następujące kary do punktów ruchu mają zastosowanie dla odpowiednich poziomów aktywności:\n"
"Ekstremalne: 1,67x, Aktywne: 1,33x"

#: lang/json/effects_from_json.py
msgid "Weary"
msgstr "Strudzenie"

#. ~ Description of effect 'Weary'.
#: lang/json/effects_from_json.py
msgid ""
"You've been very active for a while, and need to slow down for a bit.\n"
"The following move penalties are applied for the following activity levels:\n"
"Extreme: 2.5x, Active: 2x, Brisk: 1.5x"
msgstr ""
"Byłeś bardzo aktywny przez dłuższy czas; powinieneś nieco zwolnić.\n"
"Następujące kary do punktów ruchu mają zastosowanie dla odpowiednich poziomów aktywności:\n"
"Ekstremalne: 2,5x, Aktywne: 2x, Żwawe: 1,5x"

#: lang/json/effects_from_json.py
msgid "Very Weary"
msgstr "Znaczne strudzenie"

#. ~ Description of effect 'Very Weary'.
#: lang/json/effects_from_json.py
msgid ""
"You've been extremely active for a while, and need to slow down.\n"
"The following move penalties are applied for the following activity levels:\n"
"Extreme: 5x, Active: 4x, Brisk: 3x, Moderate: 2x"
msgstr ""
"Byłeś ekstremalnie aktywny przez dłuższy czas i potrzebujesz zwolnić.\n"
"Następujące kary do punktów ruchu mają zastosowanie dla odpowiednich poziomów aktywności:\n"
"Ekstremalne: 5x, Aktywne: 4x, Żwawe: 3x, Umiarkowane: 2x"

#: lang/json/effects_from_json.py
msgid "Extremely Weary"
msgstr "Ekstremalne strudzenie"

#. ~ Description of effect 'Extremely Weary'.
#: lang/json/effects_from_json.py
msgid ""
"You've been extremely active for a while, and can't take much more activity.\n"
"The following move penalties are applied for the following activity levels:\n"
"Extreme: 10x, Active: 8x, Brisk: 6x, Moderate: 4x, Light: 2x"
msgstr ""
"Byłeś ekstremalnie aktywny przez dłuższy czas i nie dajesz już rady.\n"
"Następujące kary do punktów ruchu mają zastosowanie dla odpowiednich poziomów aktywności:\n"
"Ekstremalne: 10x, Aktywne: 8x, Żwawe: 6x, Umiarkowane: 4x, Lekkie: 2x"

#. ~ Description of effect 'Extremely Weary'.
#: lang/json/effects_from_json.py
msgid ""
"You've been extremely active for a while, and really need to get some rest.\n"
"The following move penalties are applied for the following activity levels:\n"
"Extreme: 10x, Active: 8x, Brisk: 6x, Moderate: 4x, Light: 2x"
msgstr ""
"Byłeś ekstremalnie aktywny przez dłuższy czas i naprawdę potrzebujesz odpoczynku.\n"
"Następujące kary do punktów ruchu mają zastosowanie dla odpowiednich poziomów aktywności:\n"
"Ekstremalne: 10x, Aktywne: 8x, Żwawe: 6x, Umiarkowane: 4x, Lekkie: 2x"

#. ~ Description of effect 'Extremely Weary'.
#: lang/json/effects_from_json.py
msgid ""
"You've been extremely active for a while; it's time to stop.\n"
"The following move penalties are applied for the following activity levels:\n"
"Extreme: 10x, Active: 8x, Brisk: 6x, Moderate: 4x, Light: 2x"
msgstr ""
"Byłeś ekstremalnie aktywny przez dłuższy czas i czas się zatrzymać.\n"
"Następujące kary do punktów ruchu mają zastosowanie dla odpowiednich poziomów aktywności:\n"
"Ekstremalne: 10x, Aktywne: 8x, Żwawe: 6x, Umiarkowane: 4x, Lekkie: 2x"

#. ~ Description of effect 'Extremely Weary'.
#: lang/json/effects_from_json.py
msgid ""
"You've been extremely active for a while, and can no longer keep pushing.\n"
"The following move penalties are applied for the following activity levels:\n"
"Extreme: 10x, Active: 8x, Brisk: 6x, Moderate: 4x, Light: 2x"
msgstr ""
"Byłeś ekstremalnie aktywny przez dłuższy czas i już dalej nie ujedziesz.\n"
"Następujące kary do punktów ruchu mają zastosowanie dla odpowiednich poziomów aktywności:\n"
"Ekstremalne: 10x, Aktywne: 8x, Żwawe: 6x, Umiarkowane: 4x, Lekkie: 2x"

#: lang/json/effects_from_json.py src/panels.cpp
msgid "Full"
msgstr "Najedzenie"

#. ~ Description of effect 'Full'.
#. ~ Apply message for effect(s) 'Full'.
#: lang/json/effects_from_json.py
