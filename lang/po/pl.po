#: lang/json/effects_from_json.py
msgid "Panicking"
msgstr "Panika"

#. ~ Description of effect 'Panicking'.
#: lang/json/effects_from_json.py
msgid "You just can't stop shaking and are overwhelmed by fear."
msgstr "Nie możesz przestać się trząść i opanował cię strach."

#. ~ Apply message for effect(s) 'Panicking'.
#: lang/json/effects_from_json.py
msgid ""
"An all consuming dread overwhelms your mind and you begin to shake "
"uncontrollably!"
msgstr ""
"Wszechogarniający strach pochłania twój umysł i trzęsiesz się jak osika!"

#. ~ Remove message for effect(s) 'Panicking'.
#: lang/json/effects_from_json.py
msgid "Your heartrate slows back to normal!"
msgstr "Twoje serce zwalnia do normalnego tempa!"

#. ~ Miss message for effect(s) 'Panicking'.
#: lang/json/effects_from_json.py
msgid "You shake uncontrollably"
msgstr "Trzęsiesz się spazmatycznie"

#. ~ Description of effect 'Mana Fatigue'.
#: lang/json/effects_from_json.py
msgid "You are exhausted from channeling a lot of mana."
msgstr "Jesteś zmęczony od przepływu znacznej ilości many."

#. ~ Apply message for effect(s) 'Mana Fatigue'.
#: lang/json/effects_from_json.py
msgid "Channeling so much mana is making you tired"
msgstr "Przepływ tak dużej ilości many powoduje, że się męczysz"

#. ~ Remove message for effect(s) 'Mana Fatigue'.
#: lang/json/effects_from_json.py
msgid "The burden of mana fatigue has faded"
msgstr "Wysiłek spowodowany przepływem many ustaje"

#. ~ Description of effect 'Windrunning'.
#: lang/json/effects_from_json.py
msgid "You are bolstered and pushed along by the power of the wind."
msgstr "Siła wiatru wspiera cię i pcha do przodu."

#. ~ Apply message for effect(s) 'Windrunning'.
#: lang/json/effects_from_json.py
msgid "You are bolstered and pushed along by the power of the wind"
msgstr "Siła wiatru wspiera cię i pcha do przodu"

#. ~ Remove message for effect(s) 'Windrunning'.
#: lang/json/effects_from_json.py
msgid "The wind at your back dies down."
msgstr "Wiatr wiejący ci w plecy ustaje."

#. ~ Description of effect 'Dark Sight'.
#: lang/json/effects_from_json.py
msgid "You can see in the dark."
msgstr "Widzisz w ciemności."

#. ~ Apply message for effect(s) 'Dark Sight'.
#: lang/json/effects_from_json.py
msgid "Your sight adjusts to the darkness."
msgstr "Twój wzrok przywyka do ciemności."

#. ~ Remove message for effect(s) 'Dark Sight'.
#: lang/json/effects_from_json.py
msgid "The darkness loses its shape."
msgstr "Ciemność traci swój kształt."

#: lang/json/effects_from_json.py
msgid "Ethereal Hold"
msgstr "Wieczysty uścisk"

#. ~ Description of effect 'Ethereal Hold'.
#: lang/json/effects_from_json.py
msgid "Ghostly arms are trying to hold you in place!"
msgstr "Duchowe ramiona próbują zatrzymać cię w miejscu!"

#. ~ Apply message for effect(s) 'Ethereal Hold'.
#: lang/json/effects_from_json.py
msgid "Ethereal arms shoot out of the ground and grab onto you!"
msgstr "Eteryczne ramiona wyłaniają się z ziemi i chwytają cię!"

#. ~ Remove message for effect(s) 'Ethereal Hold'.
#: lang/json/effects_from_json.py
msgid "The ghostly arms fade away."
msgstr "Duchowe ramiona znikają."

#. ~ Description of effect 'Invisibility'.
#: lang/json/effects_from_json.py
msgid "Nothing can see you."
msgstr "Nic nie może cię dostrzec."

#. ~ Apply message for effect(s) 'Invisibility'.
#: lang/json/effects_from_json.py
msgid "You fade away."
msgstr "Znikasz."

#. ~ Remove message for effect(s) 'Invisibility'.
#: lang/json/effects_from_json.py
msgid "You can see your hands again."
msgstr "Znów możesz zobaczyć swoje dłonie."

#: lang/json/effects_from_json.py
msgid "Blessed"
msgstr "Błogosławieństwo"

#. ~ Description of effect 'Blessed'.
#: lang/json/effects_from_json.py
msgid "You are filled with energy that improves everything you do."
msgstr "Wypełnia cię energia, która ulepsza każde twoje działanie."

#. ~ Apply message for effect(s) 'Blessed'.
#: lang/json/effects_from_json.py
msgid "You are filled with energy that improves everything you do!"
msgstr "Wypełnia cię energia, która ulepsza każde twoje działanie!"

#. ~ Remove message for effect(s) 'Blessed'.
#: lang/json/effects_from_json.py
msgid "Your energy fades."
msgstr "Twoje energia zanika."

#. ~ Description of effect 'Grotesque Enhancement'.
#. ~ Apply message for effect(s) 'Grotesque Enhancement'.
#: lang/json/effects_from_json.py
msgid ""
"Your body ripples with writhing alien muscles, your limbs lengthen, and your"
" eyes glow with a faint green."
msgstr ""
"Twoje ciało pulsuje od wijącej się nieziemskiej masy mięśni, kończyny "
"wydłużają się, a oczy jarzą się zielonym blaskiem."

#. ~ Remove message for effect(s) 'Grotesque Enhancement'.
#: lang/json/effects_from_json.py
msgid "Your body rapidly returns to normal."
msgstr "Twoje ciało gwałtownie wraca do normalności."

#. ~ Description of effect 'Vegetative Grasp'.
#. ~ Description of effect 'Root Impale'.
#: lang/json/effects_from_json.py
msgid "Roots and vines entangle your foes."
msgstr "Korzenie i pnącza owijają twoich wrogów."

#. ~ Apply message for effect(s) 'Vegetative Grasp'.
#: lang/json/effects_from_json.py
msgid "Roots and vines entangle your foes to slow them!"
msgstr "Korzenie i pnącza owijają twoich wrogów, by ich spowolnić."

#. ~ Remove message for effect(s) 'Vegetative Grasp'.
#: lang/json/effects_from_json.py
msgid "The roots and vines wither up and die."
msgstr "Korzenie i pnącza usychają i giną."

#: lang/json/effects_from_json.py
msgid "Root Impale"
msgstr "Przebijające korzenie"

#. ~ Apply message for effect(s) 'Root Impale'.
#: lang/json/effects_from_json.py
msgid "Roots rip out from the ground and impale your enemies!"
msgstr "Korzenie wyrywają się z ziemi i przebijają twoich wrogów!"

#. ~ Remove message for effect(s) 'Root Impale'.
#: lang/json/effects_from_json.py
msgid "The roots wither up and die."
msgstr "Korzenie usychają i giną."

#: lang/json/effects_from_json.py
msgid "Acidic burn"
msgstr "Poparzenie kwasem"

#. ~ Description of effect 'Acidic burn'.
#: lang/json/effects_from_json.py
msgid "Burned with acid"
msgstr "Poparzenie od kwasu"

#: lang/json/effects_from_json.py
msgid "Hasted"
msgstr "Przyspieszenie"

#. ~ Description of effect 'Hasted'.
#: lang/json/effects_from_json.py
msgid "Your speed is boosted enormously."
msgstr "Twoja prędkość niezmiernie wzrasta."

#. ~ Apply message for effect(s) 'Hasted'.
#: lang/json/effects_from_json.py
msgid "Your speed is boosted to superhuman levels!"
msgstr "Twoja prędkość wzrasta do nieludzkiego poziomu."

#. ~ Remove message for effect(s) 'Hasted'.
#: lang/json/effects_from_json.py
msgid "You return to your normal speed."
msgstr "Powracasz do normalnej prędkości."

#. ~ Description of effect 'Synaptic Stimulation'.
#: lang/json/effects_from_json.py
