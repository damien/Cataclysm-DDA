msgstr "Podróże z plecakiem"

#. ~ Profession (male Backpacking) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You enjoyed trekking on long trails in nature with all your necessities "
"strapped to your back."
msgstr ""
"Lubiłeś trekking po długich szlakach na łonie natury ze wszystkimi "
"niezbędnymi rzeczami przypiętymi do pleców."

#: lang/json/professions_from_json.py
