#: lang/json/TOOL_ARMOR_from_json.py
msgid "atomic headlamp"
msgid_plural "atomic headlamps"
msgstr[0] "atomowa czołówka"
msgstr[1] "atomowe czołówki"
msgstr[2] "atomowych czołówek"
msgstr[3] "atomowych czołówek"

#. ~ Use action msg for atomic headlamp.
#: lang/json/TOOL_ARMOR_from_json.py
msgid "You close the headlamp's cover."
msgstr "Zamykasz pokrywę czołówki."

#. ~ Description for atomic headlamp
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"This is a custom-made reinforced headlamp powered by the magic of nuclear "
"decay, focused for more usable brightness.  The adjustable strap allows it "
"to be comfortably worn on your head or attached to your helmet.  Use it to "
"close the cover and hide the light."
msgstr ""
"Jest to indywidualnie wykonana wzmocniona latarka czołowa zasilana magią "
"rozpadu jądrowego, skoncentrowana dla uzyskania większej jasności użytkowej."
" Regulowany pasek pozwala na wygodne noszenie jej na głowie lub "
"przymocowanie do kasku. Użyj go, aby zamknąć pokrywę i ukryć światło."

#: lang/json/TOOL_ARMOR_from_json.py
msgid "atomic headlamp (covered)"
msgid_plural "atomic headlamps (covered)"
msgstr[0] "atomowa czołówka (zakryta)"
msgstr[1] "atomowe czołówki (zakryte)"
msgstr[2] "atomowych czołówek (zakryte)"
msgstr[3] "atomowych czołówek (zakryte)"

#. ~ Use action msg for atomic headlamp (covered).
#: lang/json/TOOL_ARMOR_from_json.py
msgid "You open the headlamp's cover."
msgstr "Otwierasz pokrywę czołówki."

#. ~ Description for atomic headlamp (covered)
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"This is a custom-made reinforced headlamp powered by the magic of nuclear "
"decay, focused for more usable brightness.  The adjustable strap allows it "
"to be comfortably worn on your head or attached to your helmet.  Use it to "
"open the cover and show the light."
msgstr ""
"Jest to indywidualnie wykonana wzmocniona latarka czołowa zasilana magią "
"rozpadu jądrowego, skoncentrowana dla uzyskania większej jasności użytkowej."
" Regulowany pasek pozwala na wygodne noszenie jej na głowie lub "
"przymocowanie do kasku. Użyj go, aby otworzy pokrywę i odkry światło."

