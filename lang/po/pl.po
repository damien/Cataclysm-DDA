msgid "pieces of candy wrapper"
msgid_plural "pieces of candy wrapper"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description for pieces of candy wrapper
#: lang/json/COMESTIBLE_from_json.py
msgid ""
"Bits and pieces of plastic entangled in sticky candy goop.  They spot some "
"bright colors and might have been part of a candy wrapper at some point.  "
"Maybe you could suck the sugar from them, if you're really desperate."
msgstr ""
"Odłamki i kawałki plastiku zaplątane w lepki kit cukierkowy. Występują w "
"kilku jaskrawych kolorach i mogły być częścią opakowania cukierków w pewnym "
"momencie. Może mógłbyś wyssać z nich cukier, jeśli jesteś naprawdę "
"zdesperowany."

#: lang/json/COMESTIBLE_from_json.py
msgid "sticky sludge"
msgid_plural "sticky sludge"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description for sticky sludge
#: lang/json/COMESTIBLE_from_json.py
msgid ""
"A pile of weird sticky sludge.  It looks absolutly disgusting but smells "
"kind of sweet."
msgstr ""
"Kupa dziwnego, kleistego szlamu. Wygląda absolutnie obrzydliwie, ale pachnie"
" jakby słodko."

#: lang/json/COMESTIBLE_from_json.py
msgid "caramel ointment"
msgid_plural "caramel ointments"
msgstr[0] "maść karmelowa"
msgstr[1] "maści karmelowe"
msgstr[2] "maści karmelowych"
msgstr[3] "maści karmelowej"

#. ~ Description for caramel ointment
#: lang/json/COMESTIBLE_from_json.py
msgid ""
"An ointment made of caramel.  You could use it to heal your wounds, if you "
"were made of sugar."
msgstr ""
"Maść zrobiona z karmelu. Mógłbyś nią leczyć swoje rany, gdybyś był z cukru."

