msgid "Sheath knife"
msgstr "Schowaj nóż"

#. ~ Description for ankle sheath
#: lang/json/ARMOR_from_json.py
msgid ""
"A small concealed knife sheath worn on the ankle.  It is awkward to use "
"without practice.  Activate to sheathe/draw a weapon."
msgstr ""
"Niewielka ukryta pochwa na nóż noszona na kostce. Niezręczna w użyciu dla "
"osób bez praktyki. Aktywuj by wyjąć/schować broń."

#: lang/json/ARMOR_from_json.py
msgid "birchbark ankle sheath"
msgid_plural "birchbark ankle sheathes"
msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description for birchbark ankle sheath
#: lang/json/ARMOR_from_json.py
msgid ""
"A handcrafted small concealed knife sheath worn on the ankle, made from "
"birch bark.  It is awkward to use without practice.  Activate to "
"sheathe/draw a weapon."
msgstr ""
"Niewielka ukryta pochwa na nóż noszona na kostce, rękodzieło z brzozowej "
"kory. Niezręczna w użyciu dla osób bez praktyki. Aktywuj by wyjąć/schować "
"broń."

#: lang/json/ARMOR_from_json.py
msgid "back scabbard"
msgid_plural "back scabbards"
msgstr[0] "pochwa noszona na plecach"
msgstr[1] "pochwa noszona na plecach"
msgstr[2] "pochwa noszona na plecach"
msgstr[3] "pochwa noszona na plecach"

#. ~ Description for back scabbard
#: lang/json/ARMOR_from_json.py
msgid ""
"A leather scabbard, big enough for almost any sword.  Designed to be "
"strapped to the back, it's very difficult to draw from without considerable "
"practice.  Activate to sheath/draw a sword."
msgstr ""
"Skórzana pochwa, duża na tyle by schować w niej prawie każdy miecz. "
"Opracowana do noszenia na plecach, i bardzo trudna w obsłudze bez sporej "
"wprawy. Aktywuj by schować/wyciągnąć miecz."

#: lang/json/ARMOR_from_json.py
msgid "scabbard"
msgid_plural "scabbards"
msgstr[0] "pochwa na miecz"
msgstr[1] "pochwa na miecz"
msgstr[2] "pochwa na miecz"
msgstr[3] "pochwa na miecz"

#. ~ Description for scabbard
#: lang/json/ARMOR_from_json.py
msgid ""
"A large, adjustable sheath for holding swords and other large blades.  "
"Activate to sheathe/draw a weapon."
