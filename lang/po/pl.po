#: lang/json/effects_from_json.py
msgid "Your mind accelerates."
msgstr "Twój umysł przyspiesza."

#. ~ Remove message for effect(s) 'Synaptic Stimulation'.
#: lang/json/effects_from_json.py
msgid "Your mind returns to normal speed."
msgstr "Twój umysł powraca do normalnej prędkości."

#. ~ Description of effect 'Ogre's Strength'.
#: lang/json/effects_from_json.py
msgid "You have the strength of an Ogre!"
msgstr "Masz siłę ogra!"

#. ~ Apply message for effect(s) 'Ogre's Strength'.
#: lang/json/effects_from_json.py
msgid "You feel strong!"
msgstr "Czujesz siłę!"

#. ~ Remove message for effect(s) 'Ogre's Strength'.
#: lang/json/effects_from_json.py
msgid "Your strength deflates."
msgstr "Twoja siła uchodzi."

#: lang/json/effects_from_json.py
msgid "Safe Shopping Experience"
msgstr "Bezpieczeństwo zakupów"

#. ~ Description of effect 'Safe Shopping Experience'.
#: lang/json/effects_from_json.py
msgid "Magical Store Security"
msgstr "Magiczne bezpieczeństwo sklepu"

#. ~ Apply message for effect(s) 'Safe Shopping Experience'.
#: lang/json/effects_from_json.py
msgid "You feel very seen!"
msgstr "Czujesz się bardzo na widoku!"

#. ~ Remove message for effect(s) 'Safe Shopping Experience'.
#: lang/json/effects_from_json.py
msgid "You no longer feel like somebody's watching you."
msgstr "Nie masz już wrażenia, że ktoś cię obserwuje."

#. ~ Description of effect 'Eagle's Sight'.
#: lang/json/effects_from_json.py
