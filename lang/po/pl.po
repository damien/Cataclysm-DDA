#. ~ Name for scenario 'Ambush' for a male character
#: lang/json/scenario_from_json.py
msgctxt "scenario_male"
msgid "Ambush"
msgstr "Zasadzka"

#. ~ Name for scenario 'Ambush' for a female character
#: lang/json/scenario_from_json.py
msgctxt "scenario_female"
msgid "Ambush"
msgstr "Zasadzka"

#. ~ Description for scenario 'Ambush' for a male character.
#: lang/json/scenario_from_json.py
msgctxt "scen_desc_male"
msgid ""
"It is the winter after zero hour.  As you were scavenging for food and a "
"warm place to stay at, you heard the sound of lots of movement nearby."
msgstr ""
"Jest zima, po północy. Podczas szukania jedzenia i ciepłego miejsca, w "
"którym mógłbyś się zatrzymać, słyszysz wiele odgłosów ruchu w pobliżu."

#. ~ Description for scenario 'Ambush' for a female character.
#: lang/json/scenario_from_json.py
