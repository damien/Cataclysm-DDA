msgstr[2] "kombinezon strażacki"
msgstr[3] "kombinezon strażacki"

#. ~ Description for entry suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A flame-resistant whole-body garment worn by firefighters as protection "
"against extreme heat.  It requires a separate gas mask for full protection "
"against smoke."
msgstr ""
"Ognioodporne ubranie na całe ciało noszone przez strażaków jako ochrona "
"przed ekstremalnym żarem. Wymaga oddzielnej maski przeciwgazowej dla pełnej "
"ochrony przed dymem."

