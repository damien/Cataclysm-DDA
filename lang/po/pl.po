msgstr ""
"\"zasadziłem się na kilku i nie byli zbyt twardzi. tylko uważaj na "
"posiłki.\""

#: lang/json/snippet_from_json.py
msgid "\"earth wasn't the first\""
msgstr "\"ziemia nie była pierwsza\""

#: lang/json/snippet_from_json.py
msgid ""
"\"bullet holes and plasma burns all over the car.  piece of shit hardly "
"runs\""
msgstr "\"bryka cała w dziurach po kulach i popalona plazmą, złom ledwo chodzi\""

#: lang/json/snippet_from_json.py
msgid "\"one day this will all be over.\""
msgstr "\"pewnego dnia to się wszystko skończy.\""

#: lang/json/snippet_from_json.py
msgid ""
"\"Got a picture of someone wasting one of those walkers.  You should see it "
