#. ~ Description for baldric
#: lang/json/ARMOR_from_json.py
msgid ""
"A leather scabbard, big enough for anything up to a longsword, or even a bit"
" larger than that.  Designed to be worn at the waist, secured by a shoulder "
"belt.  Activate to sheath/draw a sword."
msgstr ""
"Skórzana pochwa, duża na tyle by schować w niej długi miecz, lub nawet nieco"
" większą broń. Opracowana do noszenia w talii, zabezpieczona pasem "
"naramiennym. Aktywuj by schować/wyciągnąć miecz."

#: lang/json/ARMOR_from_json.py
msgid "ankle sheath"
msgid_plural "ankle sheaths"
msgstr[0] "pochwa na kostkę"
msgstr[1] "pochwa na kostkę"
msgstr[2] "pochwa na kostkę"
msgstr[3] "pochwa na kostkę"

