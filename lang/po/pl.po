msgstr "Aktywny Immobilizer"

#. ~ description for fault '{'str': 'Active immobiliser'}'
#: lang/json/fault_from_json.py
msgid "Prevents starting of the vehicle without the appropriate key."
msgstr "Uniemożliwia uruchomienie silnika bez odpowiedniego klucza."

#. ~ name of mending method for fault '{'str': 'Active immobiliser'}'
#: lang/json/fault_from_json.py
