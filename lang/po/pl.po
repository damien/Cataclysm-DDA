msgid_plural "LeMat revolver shotguns"
msgstr[0] "strzelba do rewolweru LeMat"
msgstr[1] "strzelby do rewolweru LeMat"
msgstr[2] "strzelb do rewolweru LeMat"
msgstr[3] "strzelby do rewolweru LeMat"

#: lang/json/gunmod_from_json.py
msgid ""
"The Lemat revolver is unique in that its cylinder axis pin is also a fully "
"functional 20ga percussion-primed smoothbore barrel.  It's irremovable."
msgstr ""
"Wyjątkowość rewolweru LeMat polega na tym, że trzpień osi cylindra jest "
"jednocześnie pełnowartościową lufą gładkolufową kalibru 20. Jest "
"nieusuwalna."

#: lang/json/gunmod_from_json.py
