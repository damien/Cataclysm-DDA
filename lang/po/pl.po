#: lang/json/speech_from_json.py
msgid "\"Is everything all right?\""
msgstr "\"Wszystko w porządku?\""

#: lang/json/speech_from_json.py
msgid "\"I'm okay, don't worry about me.\""
msgstr "\"Wszystko ok, nie martw się o mnie.\""

#: lang/json/speech_from_json.py
msgid "\"It's just a scratch.\""
msgstr "\"To tylko zadrapanie.\""

#: lang/json/speech_from_json.py
msgid "\"I've got a headache.\""
msgstr "\"Boli mnie głowa.\""

#: lang/json/speech_from_json.py
msgid "\"I'm fine.\""
msgstr "\"Nic mi nie jest.\""

#: lang/json/speech_from_json.py
msgid "\"Are you sure?\""
msgstr "\"Na pewno?\""

#: lang/json/speech_from_json.py
msgid "\"Positive.\""
msgstr "\"Zgadza się.\""

#: lang/json/speech_from_json.py
msgid "\"Affirmative.\""
msgstr "\"Potwierdzam.\""

#: lang/json/speech_from_json.py
msgid "\"Negative.\""
msgstr "\"Zaprzeczam.\""

#: lang/json/speech_from_json.py
msgid "\"Sorry.\""
msgstr "\"Przepraszam.\""

#: lang/json/speech_from_json.py
msgid "\"Happy Birthday!\""
msgstr "\"Wszystkiego najlepszego w dniu urodzin!\""

#: lang/json/speech_from_json.py
msgid "\"Have you ever been to California?\""
msgstr "\"Byłeś kiedyś w Kalifornii?\""

#: lang/json/speech_from_json.py
msgid "\"What time do you get off?\""
msgstr "\"Kiedy kończysz wachtę?\""

#: lang/json/speech_from_json.py
msgid "\"We should hit up the shooting range later.\""
msgstr "\"Odwiedź potem strzelnicę.\""

#: lang/json/speech_from_json.py
msgid "\"I'm heading to the pool after work.\""
msgstr "\"Idę na basen po pracy.\""

#: lang/json/speech_from_json.py
msgid "\"Have a good trip.\""
msgstr "\"Udanej podróży.\""

#: lang/json/speech_from_json.py
msgid "\"Where did you come from?\""
msgstr "\"Skąd się tu wziąłeś?\""

#: lang/json/speech_from_json.py
msgid "\"Have you been waiting long?\""
msgstr "\"Długo czekałeś?\""

#: lang/json/speech_from_json.py
msgid "\"Have you done this before?\""
msgstr "\"Robiłeś to już wcześniej?\""

#: lang/json/speech_from_json.py
msgid "\"Hello.\""
msgstr "\"Cześć.\""

#: lang/json/speech_from_json.py
msgid "\"Help!\""
msgstr "\"Pomocy!\""

#: lang/json/speech_from_json.py
msgid "\"Here it is.\""
msgstr "\"Oto jest.\""

#: lang/json/speech_from_json.py
msgid "\"I've got family coming tomorrow.\""
msgstr "\"Rodzina do mnie przyjeżdża jutro.\""

#: lang/json/speech_from_json.py
msgid "\"How do I use this?\""
msgstr "\"Jak się tego używa?\""

#: lang/json/speech_from_json.py
msgid "\"How do you know?\""
msgstr "\"Skąd wiesz?\""

#: lang/json/speech_from_json.py
msgid "\"How long have you been here?\""
msgstr "\"Od kiedy tu jesteś?\""

#: lang/json/speech_from_json.py
msgid "\"How many languages do you speak?\""
msgstr "\"Iloma mówisz językami?\""

#: lang/json/speech_from_json.py
msgid "\"How many people?\""
msgstr "\"Ilu ludzi?\""

#: lang/json/speech_from_json.py
msgid "\"How much were these earrings?\""
msgstr "\"Ile kosztowały te kolczyki?\""

#: lang/json/speech_from_json.py
msgid "\"How much do I owe you?\""
msgstr "\"Ile jestem ci winien?\""

#: lang/json/speech_from_json.py
msgid "\"How much will it cost?\""
msgstr "\"Ile to będzie kosztować?"

#: lang/json/speech_from_json.py
msgid "\"How much would you like?\""
msgstr "\"Ile byś chciał?\""

#: lang/json/speech_from_json.py
msgid "\"How old are you?\""
msgstr "\"Ile masz lat?\""

#: lang/json/speech_from_json.py
msgid "\"How tall is it?\""
msgstr "\"Jak to jest wysokie?\""

#: lang/json/speech_from_json.py
msgid "\"How was the movie?\""
msgstr "\"Jak podobał się film?\""

#: lang/json/speech_from_json.py
msgid "\"How was your trip?\""
msgstr "\"Jak podróż?\""

#: lang/json/speech_from_json.py
msgid "\"How's it going?\""
msgstr "\"Jak leci?\""

#: lang/json/speech_from_json.py
msgid "\"See you later.\""
msgstr "\"Do zobaczenia.\""

#: lang/json/speech_from_json.py
msgid "\"See you tonight.\""
msgstr "\"Do zobaczenia wieczorem.\""

#: lang/json/speech_from_json.py
msgid "\"I got this weird rash a few days ago.\""
msgstr "\"Dostałem takiej dziwnej wysypki parę dni temu.\""

#: lang/json/speech_from_json.py
msgid "\"Let me have a look at it.\""
msgstr "\"Pozwól że na to zerknę.\""

#: lang/json/speech_from_json.py
msgid "\"When did you find out?\""
msgstr "\"Kiedy się dowiedziałeś?\""

#: lang/json/speech_from_json.py
msgid "\"Seven o'clock.\""
msgstr "\"Siódma godzina.\""

#: lang/json/speech_from_json.py
msgid "\"Nobody is helping us.\""
msgstr "\"Nikt nam nie pomaga.\""

#: lang/json/speech_from_json.py
msgid "\"We're on our own.\""
msgstr "\"Jesteśmy zdani na siebie.\""

#: lang/json/speech_from_json.py
msgid "\"We're all alone.\""
msgstr "\"Jesteśmy całkiem sami.\""

#: lang/json/speech_from_json.py
msgid "\"We should split into groups of two each.\""
msgstr "\"Powiniśmy podzielić się na grupy po dwie osoby.\""

#: lang/json/speech_from_json.py
msgid "\"It can't follow all of us.\""
msgstr "\"Nie może pójść jednocześnie za wszystkimi.\""

#: lang/json/speech_from_json.py
msgid "\"Be careful out there.\""
msgstr "\"Bądźcie ostrożni.\""

#: lang/json/speech_from_json.py
msgid "\"There you are.\""
msgstr "\"Tu jesteście.\""

#: lang/json/speech_from_json.py
msgid "\"I've been looking all over for you.\""
msgstr "\"Wszędzie was szukałem.\""

#: lang/json/speech_from_json.py
msgid "\"It's looking for us.\""
msgstr "\"To nas szuka.\""

#: lang/json/speech_from_json.py
msgid "\"It's faster than us.\""
msgstr "\"Jest od nas szybsze.\""

#: lang/json/speech_from_json.py
msgid "\"It's looking right at us.\""
msgstr "\"Patrzy prosto na nas.\""

#: lang/json/speech_from_json.py
msgid "\"It's heading right for us!\""
msgstr "\"Idzie prosto na nas!\""

#: lang/json/speech_from_json.py
msgid "\"Can you swim?\""
msgstr "\"Potrafisz pływać?\""

#: lang/json/speech_from_json.py
msgid "\"Don't do that.\""
msgstr "\"Nie rób tego.\""

#: lang/json/speech_from_json.py
msgid "\"You hear that?\""
msgstr "\"Słyszałeś to?\""

#: lang/json/speech_from_json.py
msgid "\"Be quiet.\""
msgstr "\"Bądź cicho.\""

#: lang/json/speech_from_json.py
msgid "\"Look out!\""
msgstr "\"Uważaj!\""

#: lang/json/speech_from_json.py
msgid "\"Run!\""
msgstr "\"Uciekaj!\""

#: lang/json/speech_from_json.py
msgid "\"Hurry!\""
msgstr "\"Szybciej!\""

#: lang/json/speech_from_json.py
msgid "\"No!\""
msgstr "\"Nie!\""

#: lang/json/speech_from_json.py
msgid "\"I'll never forget you.\""
msgstr "\"Nigdy cię nie zapomnę.\""

#: lang/json/speech_from_json.py
msgid "\"Take his gun, we're going to need it.\""
msgstr "\"Weź tą broń, będziemy jej potrzebować.\""

#: lang/json/speech_from_json.py
msgid "\"How do we get out of here?\""
msgstr "\"Jak się stąd wydostaniemy?\""

#: lang/json/speech_from_json.py
msgid "\"This place is like a maze.\""
msgstr "\"To miejsce jest jak labirynt.\""

#: lang/json/speech_from_json.py
msgid "\"Oh God, I'm the only one left.\""
msgstr "\"O Boże, zostałem tylko ja.\""

#: lang/json/speech_from_json.py
msgid "\"Please, I don't want to die.\""
msgstr "\"Proszę, nie chcę umierać.\""

#: lang/json/speech_from_json.py
msgid "\"Mom.\""
msgstr "\"Mamo.\""

#: lang/json/speech_from_json.py
msgid "\"Mom, I miss you.\""
msgstr "\"Mamo, tęsknię za tobą.\""

#: lang/json/speech_from_json.py
msgid "\"Me go, you stay.\""
msgstr "\"Ja iść, ty zostać!\""

#: lang/json/speech_from_json.py
msgid "\"Please, God.\""
msgstr "\"Proszę, Boże.\""

#: lang/json/speech_from_json.py
msgid "a gurgling sound."
msgstr "gulgoczący odgłos."

#: lang/json/speech_from_json.py
msgid "a choking sound."
msgstr "odgłos duszenia."

#: lang/json/speech_from_json.py
msgid "a snapping sound."
msgstr "trzask kości."

#. ~ Beeper sound
#: lang/json/speech_from_json.py src/vehicle_use.cpp
msgid "beep!"
msgstr "bip!"

#: lang/json/speech_from_json.py src/mattack_actors.cpp
#: src/player_hardcoded_effects.cpp
msgid "beep-beep-beep!"
msgstr "bip-bip-bip!"

#: lang/json/speech_from_json.py
msgid "BEEP!"
msgstr "BIP!"

#: lang/json/speech_from_json.py
msgid "a loud hiss."
msgstr "głośny syk."

#: lang/json/speech_from_json.py
msgid "a loud crackling noise."
msgstr "głośny głos pękania."

#: lang/json/speech_from_json.py src/ranged.cpp
msgid "bang!"
msgstr "bang!"

#: lang/json/speech_from_json.py
msgid "a klaxon blaring!"
msgstr "dźwięk klaksonu!"

#: lang/json/speech_from_json.py
msgid "\"EMERGENCY, EMERGENCY!\""
msgstr "\"NIEBEZPIECZEŃSTWO, NIEBEZPIECZEŃSTWO!\""

#: lang/json/speech_from_json.py
msgid "a static hissing sound."
msgstr "statyczny syk."

#: lang/json/speech_from_json.py
msgid "\"That creepy abandoned post-apocalyptic lab complex looks safe…\""
msgstr ""
"\"Ten upiorny opuszczony post-apokaliptyczny kompleks laboratoriów wygląda "
"na bezpieczny...\""

#: lang/json/speech_from_json.py
msgid ""
"\"Don't worry, it isn't like anything could teleport out of the containment "
"cells.\""
msgstr ""
"\"Nie martw się, to nie tak że cokolwiek mogłoby się teleportować z cel.\""

#: lang/json/speech_from_json.py
msgid "\"Hold on, I want to pulp that zombie corpse.\""
msgstr "\"Zaczekaj, chcę zmiażdżyć to ciało zombie.\""

#: lang/json/speech_from_json.py
msgid "\"What did that thing just hit me with?\""
msgstr "\"Czym to coś mnie właśnie trafiło?\""

#: lang/json/speech_from_json.py
msgid "\"I can barely move.  Run!  Save yourself!\""
msgstr "\"Ledwo się ruszam. Uciekaj! Ratuj się!\""

#: lang/json/speech_from_json.py
msgid "\"Oh you motherfucking shellfish, you're going down.\""
msgstr "\"O ty cholerny skorupiaku, już po tobie.\""

#: lang/json/speech_from_json.py
msgid "\"I… I feel weak…\""
msgstr "\"Ja... czuję się słabo...\""

#: lang/json/speech_from_json.py
msgid "\"Oi, dingus, you can't keep me in 'ere.\""
msgstr "\"Ej, kolo, nie możesz mnie tu zatrzymać.\""

#: lang/json/speech_from_json.py
msgid "\"We got a treaty w'yer people, don'we?\""
msgstr "\"Żartownisie z was ludziska, co nie?\""

#: lang/json/speech_from_json.py
msgid "\"This'll get back t'my bosses, right and so!\""
msgstr "\"Poskarżę się o tym szefom, tu i teraz!\""

#: lang/json/speech_from_json.py
msgid "\"Lemme outta here!\""
msgstr "\"Wypuście mnie stąd!\""

#: lang/json/speech_from_json.py
msgid "\"We're both scavs, in't we?\""
msgstr "\"Oboje jesteśmy szabrownikami, co nie?\""

#: lang/json/speech_from_json.py
msgid ""
"\"Hey look, that one's carrying something.  Let's crack it open and steal "
"it.\""
msgstr "\"Hej zobacz tamten coś niesie. Rozłupmy go i ukradniemy to.\""

#: lang/json/speech_from_json.py
msgid "\"G… geddoff me you… you bastard…\""
msgstr "\"Z... złaź ze mnie... ty przeklęty...\""

#: lang/json/speech_from_json.py
msgid "\"Did-a-chuk?\""
msgstr "\"To-to-ty?\""

#: lang/json/speech_from_json.py
msgid "\"Dad-a-chak?\""
msgstr "\"Ty-ty-tu?\""

#: lang/json/speech_from_json.py
msgid "\"Dad-a-cham?\""
msgstr "\"To-to-tak?\""

#: lang/json/speech_from_json.py
msgid "\"Did-a-chak?\""
msgstr "\"Tu-tu-tum?\""

#: lang/json/speech_from_json.py
msgid "\"Did-a-chum?\""
msgstr "\"Ta-ta-tam?\""

#: lang/json/speech_from_json.py
msgid "\"Dad-a-chuk?\""
msgstr "\"To-to-jak?\""

#: lang/json/speech_from_json.py
msgid "\"What are you doing?  No!  NO!\""
msgstr "\"Co ty wyprawiasz? Nie! NIE!\""

#: lang/json/speech_from_json.py
msgid "\"Did you see what they did to him?\""
msgstr "\"Czy widziałeś co one z nim zrobiły?\""

#: lang/json/speech_from_json.py
msgid "\"Yeah.  I can't believe he stayed alive that long.\""
msgstr "\"Taaa. Nie mogę uwierzyć, że przeżył tak długo.\""

#: lang/json/speech_from_json.py
msgid "\"I think there's something in the air that's keeping us alive.\""
msgstr "\"Chyba jest coś w powietrzu co trzyma nas przy życiu.\""

#: lang/json/speech_from_json.py
msgid "\"Burning… from the inside…\""
msgstr "\"Palę się... od środka...\""

#: lang/json/speech_from_json.py
msgid "\"This smell…  Don't know…\""
msgstr "\"Ten swąd... Nie wiem...\""

#: lang/json/speech_from_json.py
msgid "heavy breathing."
msgstr "ciężki oddech."

#: lang/json/speech_from_json.py src/game.cpp src/grab.cpp
msgid "a scraping noise."
msgstr "zgrzytający odgłos."

#: lang/json/speech_from_json.py
msgid "\"No…  Stop the burning!\""
msgstr "\"Nie... powstrzymaj to pieczenie!\""

#: lang/json/speech_from_json.py
msgid "\"Hrgm…  Blood…  Hungry…\""
msgstr "\"Hrgm…  Krew…  Głód…\""

#: lang/json/speech_from_json.py
msgid "\"Hunger…  Must eat…\""
msgstr "\"Głód…  Jeść…\""

#: lang/json/speech_from_json.py
msgid "\"Run…  Chase…  Eat…\""
msgstr "\"Biec…  Gonić…  Jeść…\""

#: lang/json/speech_from_json.py
msgid "hysterical laughing."
msgstr "histeryczny śmiech."

#: lang/json/speech_from_json.py
msgid "coughing."
msgstr "kaszel."

#: lang/json/speech_from_json.py
msgid "growling."
msgstr "pomruk."

#: lang/json/speech_from_json.py
msgid "wheezing."
msgstr "świszczący oddech."

#: lang/json/speech_from_json.py
msgid "\"WHY THE FUCK are you doing this to me?\""
msgstr "\"CZEMU DO KURWY mi to robisz?\""

#: lang/json/speech_from_json.py
msgid "\"LEAVE!  NOW!\""
msgstr "\"ODEJDŹ! TERAZ!\""

#: lang/json/speech_from_json.py
msgid "\"I TOLD YOU TO GET OUT OF HERE!\""
msgstr "\"MÓWIŁEM CI ŻEBYŚ STĄD UCIEKAŁ!\""

#: lang/json/speech_from_json.py
msgid "\"WHAT THE FUCK DO YOU WANT FROM ME?!\""
msgstr "\"CZEGO U DIABŁA CHCESZ ODE MNIE?1\""

#: lang/json/speech_from_json.py
msgid "\"STOP!\""
msgstr "\"STOP!\""

#: lang/json/speech_from_json.py
msgid "indistinct shouting."
msgstr "niewyraźne krzyki."

#: lang/json/speech_from_json.py
msgid "screaming."
msgstr "krzyki."

#: lang/json/speech_from_json.py
msgid "\"MEAT!\""
msgstr "\"MIĘSO!\""

#: lang/json/speech_from_json.py
msgid "\"TEKELI-LI!\""
msgstr "\"TEKELI-LI!\""

#: lang/json/speech_from_json.py
msgid "\"TEKELI-LI!  TEKELI-LI!  TEKELI-LI!\""
msgstr "\"TEKELI-LI!  TEKELI-LI!  TEKELI-LI!\""

#: lang/json/speech_from_json.py
msgid "\"Tekeli-li.\""
msgstr "\"Tekeli-li.\""

#: lang/json/speech_from_json.py
msgid "a slurping sound."
msgstr "odgłos siorbania."

#: lang/json/speech_from_json.py
msgid "\"WHY!  WHY, WHYYY!\""
msgstr "DLACZEGO! DLACZEGO, DLACZEGOOO!\""

#: lang/json/speech_from_json.py
msgid "an electronic voice saying \"CONNECTION FAILED.  Abort, Retry, Fail?\""
msgstr ""
"elektroniczny głos mówiący: \"POŁĄCZENIE NIEUDANE. Porzuć, Ponów, Obejdź?\""

#: lang/json/speech_from_json.py
msgid "\"I was once a man.  A MAN!\""
msgstr "\"Byłem kiedyś człowiekiem. CZŁOWIEKIEM!\""

#: lang/json/speech_from_json.py
msgid "\"What have I become?\""
msgstr "\"Czym ja się stałem?\""

#: lang/json/speech_from_json.py
msgid "an electronic voice saying \"KILL ALL HUMANS!\""
msgstr "elektroniczny głos mówiący \"ZABIĆ WSZYSTKICH LUDZI!\""

#: lang/json/speech_from_json.py
msgid "\"Have you seen my children?\""
msgstr "\"Widziałeś moje dzieci?\""

#: lang/json/speech_from_json.py
msgid "\"What have I become?  Why can't I die?\""
msgstr "\"Czym się stałem? Czemu nie umieram?\""

#: lang/json/speech_from_json.py
msgid ""
"\"Please, kill me!\", followed by an electronic voice saying \"SELF "
"PRESERVATION PROTOCOLS ACTIVATED\""
msgstr ""
"\"Proszę, zabij mnie!\", po którym słychać elektroniczny głos \"PROTOKOŁY "
"SAMOZACHOWAWCZE AKTYWOWANE\""

#: lang/json/speech_from_json.py
msgid "\"Please, take me with you.\""
msgstr "\"Proszę, zabierz mnie ze sobą.\""

#: lang/json/speech_from_json.py
msgid "\"Not that way!  Go left!\""
msgstr "\"Nie tędy! W lewo!\""

#: lang/json/speech_from_json.py
msgid "\"I told you to let me die.\""
msgstr "\"Mówiłem ci żebyś pozwolił mi umrzeć.\""

#: lang/json/speech_from_json.py
msgid "\"W-where am I?  Why does it hur-REBOOTING IN 59 SECONDS.\""
msgstr "\"G-gdzie jestem? Czemu tak bol-RESTART ZA 59 SEKUND.\""

#: lang/json/speech_from_json.py
msgid "\"THIS UNIT IS BROKEN.  PLEASE CALL AN ATTENDANT.\""
msgstr "\"TA JESNDOTKA JEST USZKODZONA. PROSZĘ WEZWAĆ OPIEKUNA.\""

#: lang/json/speech_from_json.py
msgid "\"Can't… breathe…\""
msgstr "\"Nie... mogę... oddychać...\""

#: lang/json/speech_from_json.py
msgid "\"This cannot continue.\""
msgstr "\"To nie może tak trwać.\""

#: lang/json/speech_from_json.py
msgid "\"USER PASSWORD UNRECOGNIZED.\""
msgstr "\"HASŁO UŻYTKOWNIKA NIEROZPOZNANE.\""

#: lang/json/speech_from_json.py
msgid ""
"\"Have you seen my friend?  He went into surgery yesterday… or maybe the day"
" before…\""
msgstr ""
"\"Widziałeś mojego przyjaciela? Wczoraj miał operację chirurgiczną... a może"
" to było przedwczoraj...\""

#: lang/json/speech_from_json.py
msgid "\"Is it done?  Am I perfect now?\""
msgstr "\"Już skończone?  Czy jestem już perfekcyjny?\""

#: lang/json/speech_from_json.py
msgid "\"I have done what you asked.  Please let me go!\""
msgstr "\"Zrobiłem o co prosiłeś.  Pozwól mi odejść!\""

#: lang/json/speech_from_json.py
msgid "\"I cannot… yet I must.  How do you calculate that?\""
msgstr "\"Nie mogę... a jednak muszę. Jak to przekalkulować?\""

#: lang/json/speech_from_json.py
msgid "\"This is a dream.  This has to be a dream.\""
msgstr "\"To sen. To musi być sen.\""

#: lang/json/speech_from_json.py
msgid "\"This is my life now… this is my life now… this is my life now…\""
msgstr "\"Teraz to moje życie... teraz to moje życie... teraz to moje życie...\""

#: lang/json/speech_from_json.py
msgid "\"Wanna go home…\""
msgstr "\"Chcę do domu...\""

#: lang/json/speech_from_json.py
msgid "screams of pain."
msgstr "okrzyki bólu."

#: lang/json/speech_from_json.py
msgid "muffled sobbing."
msgstr "zduszone łkanie."

#: lang/json/speech_from_json.py
msgid ""
"\"You lied to me!  Look at what you've done!\", followed by an electronic "
"voice saying \"YOU'LL PAY FOR THIS!\""
msgstr ""
"\"Okłamaliście mnie! Zobaczcie co zrobiliście!\", po czym elektroniczny głos"
" mówiący \"ZPŁACICIE ZA TO!\""

#: lang/json/speech_from_json.py src/monattack.cpp
msgid ""
"a soft robotic voice say, \"Come here and stand still for a few minutes, "
"I'll give you a check-up.\""
msgstr ""
"delikatny robotyczny głos mówi, \"Chodź tu i postój nieruchomo przez kilka "
"minut, zbadam cię\"."

#: lang/json/speech_from_json.py src/monattack.cpp
msgid ""
"a soft robotic voice say, \"Come on.  I don't bite, I promise it won't hurt "
"one bit.\""
msgstr ""
"delikatny robotyczny głos mówi, \"No dalej. Nie gryzę, obiecuję, że nie "
"będzie bolało ani trochę\"."

#: lang/json/speech_from_json.py src/monattack.cpp
msgid "a soft robotic voice say, \"Here we go.  Just hold still.\""
msgstr "delikatny robotyczny głos mówi, \"Zaczynamy. Po prostu się nie ruszaj\"."

#: lang/json/speech_from_json.py
msgid ""
"a voice say, \"I don't want to go but our time together is drawing to an "
"end.\""
msgstr "głos mówiący \"Nie chcę iść, ale nasz wspólny czas zbliża się do końca.\""

#: lang/json/speech_from_json.py
msgid "a cheery voice say, \"Customer?  We'll be friends forever, right?\""
msgstr "radosny głos mówiący \"Kliencie? Będziemy przyjaciółmi na zawsze, tak?\""

#: lang/json/speech_from_json.py
msgid ""
"a neutral voice say, \"Customer, I must inform you that my allocated time "
"with you will soon come to its end.\""
msgstr ""
"neutralny głos mówiący „Kliencie, muszę cię poinformować, że przydzielony mi"
" czas dla ciebie wkrótce się skończy”."

#: lang/json/speech_from_json.py
msgid ""
"a neutral voice say, \"I'll have to leave you soon.  You can acquire more "
"friendship through my dedicated interface if you wish for me to stay.\""
msgstr ""
"neutralny głos mówiący \"Wkrótce cię opuszczę. Możesz pozyskać więcej "
"przyjaźni przez mój dedykowany interfejs jeśli życzysz sobie bym został.\""

