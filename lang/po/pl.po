#. ~ Description for scenario 'Evacuee' for a male character.
#: lang/json/scenario_from_json.py
msgctxt "scen_desc_male"
msgid ""
"You have survived the initial wave of panic, and have achieved (relative) "
"safety in one of the many government evac shelters."
msgstr ""
"Przeżyłeś pierwszą falę paniki i zapewniłeś sobie (względne) bezpieczeństwo "
"w jednym z wielu rządowych schronów ewakuacyjnych."

#. ~ Description for scenario 'Evacuee' for a female character.
#: lang/json/scenario_from_json.py
