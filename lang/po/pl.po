#: lang/json/AMMO_from_json.py
msgid "tiny pistol ammo, ball"
msgid_plural "tiny pistol ammo, ball"
msgstr[0] "drobna amunicja do pistoletu, ball"
msgstr[1] "drobne amunicje do pistoletu, ball"
msgstr[2] "drobnych amunicji do pistoletu, ball"
msgstr[3] "drobnej amunicji do pistoletu, ball"

#. ~ Description for tiny pistol ammo, ball
#: lang/json/AMMO_from_json.py
msgid ""
"Minuscule pistol and rifle ammunition, for target practice or turn of the "
"century sidearms.  Sold in great quantities preceding the riots.  'Ball' is "
"an old term for full metal jacketed bullets which offer reduced fouling, "
"better reliability, and slightly improved penetration compared to plain "
"lead."
msgstr ""
"Niewielka amunicja pistoletowa i karabinowa, do treningu strzeleckiego lub "
"broni bocznej z przełomu wieków. Sprzedawana w dużych ilościach w okresie "
"poprzedzającym zamieszki. \"Kula\" to stare określenie dla pocisków z "
"płaszczem metalowym, które oferują mniejsze zanieczyszczenie, lepszą "
"niezawodność i nieco lepszą penetrację w porównaniu do zwykłego ołowiu."

#: lang/json/AMMO_from_json.py
msgid "tiny pistol ammo, JHP"
msgid_plural "tiny pistol ammo, JHP"
msgstr[0] "drobna amunicja do pistoletu, JHP"
msgstr[1] "drobne amunicje do pistoletu, JHP"
msgstr[2] "drobnych amunicji do pistoletu, JHP"
msgstr[3] "drobnej amunicji do pistoletu, JHP"

#. ~ Description for tiny pistol ammo, JHP
#: lang/json/AMMO_from_json.py
msgid ""
"Minuscule pistol and rifle ammunition, for target practice or turn of the "
"century sidearms.  Sold in great quantities preceding the riots.  Jacketed "
"Hollow Points are defensive/duty projectiles that are more destructive to "
"tissue than plain ball ammunition, and slightly reduce overpenetration "
"concerns."
msgstr ""
"Niewielka amunicja pistoletowa i karabinowa, do ćwiczeń strzeleckich lub "
