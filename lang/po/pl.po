msgstr[3] "kompaktowego pistoletu Glock"

#: lang/json/gun_from_json.py
msgid ""
"A small pistol accepting Glock magazines and chambered in 10mm.  Because of "
"it size, it is easy to carry, but it has rather fierce recoil."
msgstr ""
"Niewielki pistolet akceptujący magazynki Glocka, kaliber 10 mm. Ze względu "
"na swoje rozmiary jest łatwy do przenoszenia, ale ma dość silny odrzut."

#: lang/json/gun_from_json.py
