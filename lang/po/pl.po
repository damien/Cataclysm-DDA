#: lang/json/scenario_from_json.py
msgctxt "scen_desc_male"
msgid ""
"You start drunk to the point of incapacitation, depressed, infected, "
"surrounded by fire, and sick with the flu.  This day went downhill really "
"fast."
msgstr ""
"Zaczynasz pijany w sztok, w depresji, zainfekowany, otoczony płomieniami i "
"chory na grypę. Ten dzień stoczył się po równi pochyłej naprawdę szybko."

