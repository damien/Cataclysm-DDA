msgstr[2] "gumowej podeszwy"
msgstr[3] "gumowych podeszew"

#. ~ Description for rubber sole
#: lang/json/AMMO_from_json.py
msgid ""
"This is a sole made from rubber, usually found on the bottoms of boots.  Can"
" be used for making actual boots."
msgstr ""
"To gumowa podeszwa, zwykle znajdowana na spodzie butów. Można ją wykorzystać"
" by zrobić prawdziwe buty."

#: lang/json/AMMO_from_json.py
msgid "polycarbonate sheet"
msgid_plural "polycarbonate sheets"
msgstr[0] "arkusz poliwęglanu"
msgstr[1] "arkusze poliwęglanu"
msgstr[2] "arkuszy poliwęglanu"
msgstr[3] "arkusza poliwęglanu"

#. ~ Description for polycarbonate sheet
#: lang/json/AMMO_from_json.py
