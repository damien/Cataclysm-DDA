msgstr[3] ""

#. ~ Description for copper necklace
#: lang/json/ARMOR_from_json.py
msgid ""
"A simple chain of copper, with a clasp in the middle to create a necklace.  "
"You can wear it if you like, but it won't provide any effects."
msgstr ""
"Prosty łańcuszek z miedzi, z zapięciem w środku do stworzenia naszyjnika. "
"Możesz go nosić, jeśli chcesz, ale nie da żadnych efektów."

