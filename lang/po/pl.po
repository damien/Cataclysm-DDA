msgstr[2] ""
msgstr[3] ""

#. ~ Description for copper ring
#: lang/json/ARMOR_from_json.py
msgid ""
"A plain, copper ring.  Not very shiny, and not very popular.  You can wear "
"it if you like, but it won't provide any effects."
msgstr ""
"Zwykły, miedziany pierścionek. Niezbyt błyszczący, i niezbyt popularny. "
"Możesz go nosić, jeśli chcesz, ale nie przyniesie żadnych efektów."

