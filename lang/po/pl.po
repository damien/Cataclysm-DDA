#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Operator CBRN"
msgstr "Żołnierz sił specjalnych - ABC"

#. ~ Profession (male Operator CBRN) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"Chemical weapons?  Check.  Biological outbreak?  Check.  Nuclear war?  "
"Check.  Sounds like the perfect job for you!"
msgstr ""
"Broń chemiczna? Jest. Biologiczna pandemia? Jest. Wojna atomowa? Jest. "
"Wygląda na to, że to doskonała robota dla ciebie."

