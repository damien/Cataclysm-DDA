msgstr ""
"FE09-    A3 65 FF    ATA $#17A\n"
"FE0B-    4E          SKO $5010\n"
"FE0D-    A5 24       ZRĘ $#05\n"

#: lang/json/effects_from_json.py
msgid "Sadie's injection"
msgstr "Zastrzyk od Sadie"

#. ~ Apply message for effect(s) 'Sadie's injection'.
#: lang/json/effects_from_json.py
msgid "A wave of cold runs through your body and you feel dizzy"
msgstr "Fala zimna przebiega twoje ciało i masz zawroty głowy"

#. ~ Remove message for effect(s) 'Sadie's injection'.
#: lang/json/effects_from_json.py
msgid "The effects of Sadie's injection appear to be wearing off now"
msgstr "Efekt zastrzyku od Sadie wydaje się zanikać"

#: lang/json/effects_from_json.py
msgid "Blood Spiders"
msgstr "Pająki krwi"

#. ~ Description of effect 'Blood Spiders'.
#: lang/json/effects_from_json.py
msgid ""
"You have contracted an interdimensional disease, specifically Blood Spiders."
"  Symptoms can be alleviated by medication (antiparasitic)."
msgstr ""
"Masz zarażenie międzywymiarową chorobą, a konkretnie pająkami krwi. Objawy "
"mogą zostać złagodzone przez lekarstwa (przeciwpasożytnicze)."

#. ~ Apply message for effect(s) 'Blood Spiders'.
#: lang/json/effects_from_json.py
msgid "Your veins itch…"
msgstr "Twoje żyły swędzą…"

#. ~ Male memorial apply log for effect(s) 'Blood Spiders'.
#: lang/json/effects_from_json.py
msgctxt "memorial_male"
msgid "Caught blood spiders."
msgstr "Złapał pająki krwi."

#. ~ Female memorial apply log for effect(s) 'Blood Spiders'.
#: lang/json/effects_from_json.py
msgctxt "memorial_female"
msgid "Caught blood spiders."
msgstr "Złapała pająki krwi."

#. ~ Male memorial remove log for effect(s) 'Blood Spiders'.
#: lang/json/effects_from_json.py
msgctxt "memorial_male"
msgid "Eradicated the spiders in his blood."
msgstr "Zlikwidował pająki w swojej krwi."

#. ~ Female memorial remove log for effect(s) 'Blood Spiders'.
#: lang/json/effects_from_json.py
msgctxt "memorial_female"
msgid "Eradicated the spiders in his blood."
