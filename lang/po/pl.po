msgstr "Uwielbiasz się uczyć i sypać przypadkowymi ciekawostkami."

#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Scrap Art"
msgstr "Metaloplastyka"

#. ~ Profession (male Scrap Art) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You spent hours welding discarded scrap into large and intricate designs.  "
"Some say you just welded junk into bigger junk.  You call it art."
msgstr ""
"Spędzałeś godziny na spawaniu złomu w duże i skomplikowane projekty. "
"Niektórzy mówią, że po prostu przyspawałeś złom do większego złomu. Ty "
"nazywasz to sztuką."

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Scrap Art"
msgstr "Metaloplastyka"

#. ~ Profession (female Scrap Art) description
#: lang/json/professions_from_json.py
