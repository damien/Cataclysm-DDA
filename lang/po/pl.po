#. ~ Description for aspirin
#: lang/json/COMESTIBLE_from_json.py
msgid ""
"Acetylsalicylic acid, a mild anti-inflammatory.  Take to relieve pain and "
"swelling."
msgstr ""
"Kwas acetylosalicylowy, lekki środek przeciwobrzękowy. Weź by zmniejszyć ból"
" i opuchliznę."

