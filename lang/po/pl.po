msgstr[1] "poduszki pod policzek"
msgstr[2] "poduszek pod policzek"
msgstr[3] "poduszki pod policzek"

#: lang/json/gunmod_from_json.py
msgid ""
"A stock accessory for sniper rifles and even DMRs considerably improving eye"
" relief efficiency, prevents slipping, and reduces recoil to the neck and "
"cheek."
msgstr ""
"Domyślne akcesorium dla karabinów wyborowych, znacząco poprawiające komfort "
"oka, zapobiegające ześlizgiwaniu się i zmniejszające odrzut i zmniejszające "
"odrzut przy szyi i policzku."

#: lang/json/gunmod_from_json.py
