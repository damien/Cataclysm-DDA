msgstr[1] "dora"
msgstr[2] "dora"
msgstr[3] "dora"

#. ~ Description for dory
#: lang/json/GENERIC_from_json.py
msgid "A well-made spear with a bronze head, Greek in origin."
msgstr "Solidna hoplicka włócznia z ostrzem z brązu, rodem z Grecji."

