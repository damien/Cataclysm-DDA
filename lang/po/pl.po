msgstr "Spędziłeś przyjemnie czas relaksując się z kimś."

#. ~ Miss message for effect(s) 'Relaxed with Alonso'.
#: lang/json/effects_from_json.py
msgid "You feel relaxed."
msgstr "Czujesz się zrelaksowany."

#: lang/json/effects_from_json.py
msgid "Encased in foamcrete"
msgstr "Zalany pianobetonem"

#: lang/json/effects_from_json.py
msgid "A partial covering of foamcrete is slowing you down."
msgstr "Częściowe pokrycie pianobetonem spowalnia cię."

#: lang/json/effects_from_json.py
msgid "Movement Optimization (1)"
msgstr "Optymizacja ruchu (1)"

#: lang/json/effects_from_json.py
msgid "Movement Optimization (2)"
msgstr "Optymizacja ruchu (2)"

#: lang/json/effects_from_json.py
msgid "Movement Optimization (3)"
msgstr "Optymizacja ruchu (3)"

#: lang/json/effects_from_json.py
