#: lang/json/AMMO_from_json.py
msgid "battery"
msgid_plural "battery"
msgstr[0] "bateria"
msgstr[1] "baterie"
msgstr[2] "baterii"
msgstr[3] "baterii"

#. ~ Description for battery
#: lang/json/AMMO_from_json.py
msgid ""
"Some free-floating battery charge.  This can be reloaded into rechargable "
"battery cells, but can never be unloaded."
msgstr ""
"Ładunek baterii wolny jak elektron. Można nim naładować akumulatorki, ale "
"nie można ich wyładować."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "butane"
msgid_plural "butane"
msgstr[0] "butan"
msgstr[1] "butanu"
msgstr[2] "butanu"
msgstr[3] "butanu"

#. ~ Description for butane
#: lang/json/AMMO_from_json.py
msgid "A common flammable liquid used in lighters."
msgstr "Palny płyn powszechnie używany w zapalniczkach."

#: lang/json/AMMO_from_json.py
msgid "aerosol paint"
msgid_plural "aerosol paint"
msgstr[0] "farba w aerozolu"
msgstr[1] "farby w aerozolu"
msgstr[2] "farb w aerozolu"
msgstr[3] "farby w aerozolu"

#. ~ Description for aerosol paint
#: lang/json/AMMO_from_json.py
msgid ""
"A paint that comes in a sealed, pressurized container and is released in an "
"aerosol spray when a valve button is depressed."
msgstr ""
"Farba znajdująca się w szczelnym pojemniku pod ciśnieniem i uwalniana w "
"postaci aerozolu po naciśnięciu przycisku zaworu."

#: lang/json/AMMO_from_json.py
msgid "permanent ink"
msgid_plural "permanent ink"
msgstr[0] "tusz permanentny"
msgstr[1] "tusze permanentne"
msgstr[2] "tuszy permanentnych"
msgstr[3] "tuszu permanentnego"

#. ~ Description for permanent ink
#: lang/json/AMMO_from_json.py
msgid ""
"A ink comprises a main carrier solvent, a glyceride, a pyrrolidone, a resin "
"and a colorant, making it water resistant."
msgstr ""
"Tusz zawiera główny nośnik rozpuszczalnikowy, gliceryd, pirolidon, żywicę i "
"barwnik, dzięki czemu jest wodoodporny."

#: lang/json/AMMO_from_json.py
msgid "candle wax"
msgid_plural "candle wax"
msgstr[0] "wosk świecowy"
msgstr[1] "woski świecowe"
msgstr[2] "wosków świecowych"
msgstr[3] "wosku świecowego"

#. ~ Description for candle wax
#: lang/json/AMMO_from_json.py
msgid "A flammable solid substance used to make candles."
msgstr "Łatwopalna stała substancja używana do tworzenia świec."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "flare pyrotechnic"
msgid_plural "flare pyrotechnic"
msgstr[0] "flara pirotechniczna"
msgstr[1] "flary pirotechniczne"
msgstr[2] "flar pirotechnicznych"
msgstr[3] "flary pirotechnicznej"

#. ~ Description for flare pyrotechnic
#: lang/json/AMMO_from_json.py
msgid "A pyrotechnic chemical used in flares."
msgstr "Chemikalia pirotechniczne używane w flarach."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "match"
msgid_plural "matches"
msgstr[0] "zapałka"
msgstr[1] "zapałki"
msgstr[2] "zapałek"
msgstr[3] "zapałki"

#. ~ Description for match
#: lang/json/AMMO_from_json.py
msgid ""
"A small stick with a red part at the end.  Strike it against a matchbook to "
"light it."
msgstr ""
"Patyczek z czerwoną końcówką. Przeciągnij po opakowaniu zapałek, aby "
"rozpalić."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "oxygen"
msgid_plural "oxygen"
msgstr[0] "tlen"
msgstr[1] "tlenu"
msgstr[2] "tlenu"
msgstr[3] "tlenu"

#. ~ Description for oxygen
#: lang/json/AMMO_from_json.py
msgid "Compressed medical oxygen."
msgstr "Skompresowany tlen medyczny."

#: lang/json/AMMO_from_json.py
msgid "aluminum foil"
msgid_plural "aluminum foil"
msgstr[0] "folia aluminiowa"
msgstr[1] "folie aluminiowe"
msgstr[2] "folii aluminiowych"
msgstr[3] "folii aluminiowej"

#. ~ Description for aluminum foil
#: lang/json/AMMO_from_json.py
msgid ""
"A thin foil made of aluminum.  Sometimes called 'tin foil' due to being made"
" of tin in the past."
msgstr ""
"Cienka folia wykonana z aluminium. Czasami nazywana 'folią cynową', ponieważ"
" w przeszłości była robiona z cyny."

#: lang/json/AMMO_from_json.py
msgid "cent"
msgid_plural "cents"
msgstr[0] "cent"
msgstr[1] "centy"
msgstr[2] "centów"
msgstr[3] "centa"

#. ~ Description for cent
#: lang/json/AMMO_from_json.py
msgid "A unit of currency equivalent to 0.01 US dollars."
msgstr "Jednostka monetarna równa 0,01 dolara amerykańskiego."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "thread"
msgid_plural "thread"
msgstr[0] "nić"
msgstr[1] "nici"
msgstr[2] "nici"
msgstr[3] "nici"

#. ~ Description for thread
#: lang/json/AMMO_from_json.py
msgid "A small quantity of thread that could be used to refill a sewing kit."
msgstr ""
"Nieduża ilość nici, której można użyć do uzupełnienia zestawu do szycia."

#: lang/json/AMMO_from_json.py
msgid "sinew"
msgid_plural "sinews"
msgstr[0] "ścięgno"
msgstr[1] "ścięgna"
msgstr[2] "ścięgien"
msgstr[3] "ścięgna"

#. ~ Description for sinew
#: lang/json/AMMO_from_json.py
msgid "A tough sinew cut from a corpse, usable as thread."
msgstr "Wytrzymałe ścięgna wycięte z ciała, mogą zastąpić nici."

#: lang/json/AMMO_from_json.py
msgid "plant fiber"
msgid_plural "plant fibers"
msgstr[0] "włókno roślinne"
msgstr[1] "włókna roślinne"
msgstr[2] "włókien roślinnych"
msgstr[3] "włókna roślinnego"

#. ~ Description for plant fiber
#: lang/json/AMMO_from_json.py
msgid "Tough thin fiber, taken from a plant.  Can be used as thread."
msgstr ""
"Wytrzymałe cienkie włókna pochodzenia roślinnego. Można ich używać jako "
"nici."

#: lang/json/AMMO_from_json.py
msgid "yarn"
msgid_plural "yarn"
msgstr[0] "przędza"
msgstr[1] "przędze"
msgstr[2] "przędz"
msgstr[3] "przędzy"

#. ~ Description for yarn
#: lang/json/AMMO_from_json.py
msgid "Wool yarn, could be used to knit wool clothing."
msgstr ""
"Wełniana przędza, nadająca się do tkania i szydełkowania wełnianych ubrań."

#: lang/json/AMMO_from_json.py
msgid "soap bar"
msgid_plural "soap bars"
msgstr[0] "kostka mydła"
msgstr[1] "kostki mydła"
msgstr[2] "kostek mydła"
msgstr[3] "kostki mydła"

#. ~ Description for soap bar
#: lang/json/AMMO_from_json.py
msgid "A cleansing agent made into bars."
msgstr "Środek do czyszczenia w formie kostek."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "duct tape"
msgid_plural "duct tape"
msgstr[0] "taśma klejąca"
msgstr[1] "taśmy klejące"
msgstr[2] "taśm klejących"
msgstr[3] "taśmy klejącej"

#. ~ Description for duct tape
#: lang/json/AMMO_from_json.py
msgid "A roll of incredibly strong tape.  Its uses are innumerable."
msgstr ""
"Rolka niezwykle wytrzymałej taśmy klejącej. Jej zastosowania są niezliczone."

#: lang/json/AMMO_from_json.py
msgid "rolling paper"
msgid_plural "rolling papers"
msgstr[0] "bibułka"
msgstr[1] "bibułki"
msgstr[2] "bibułek"
msgstr[3] "bibułki"

#. ~ Description for rolling paper
#: lang/json/AMMO_from_json.py
msgid "These are thin paper strips intended for the rolling of cigarettes."
msgstr "Te cienkie kawałki papieru służą do zwijania papierosów."

#: lang/json/AMMO_from_json.py
msgid "copper wire"
msgid_plural "copper wires"
msgstr[0] "miedziany drut"
msgstr[1] "miedziane druty"
msgstr[2] "miedzianych drutów"
msgstr[3] "miedzianego drutu"

#. ~ Description for copper wire
#: lang/json/AMMO_from_json.py
msgid "Plastic jacketed copper cable of the type used in small electronics."
msgstr ""
"Obleczone w plastik miedziane kable w rodzaju używanym w drobnej "
"elektronice."

#: lang/json/AMMO_from_json.py
msgid "raw copper wire"
msgid_plural "raw copper wires"
msgstr[0] "goły miedziany drut"
msgstr[1] "gołe miedziane druty"
msgstr[2] "gołych miedzianych drutów"
msgstr[3] "gołego miedzianego drutu"

#. ~ Description for raw copper wire
#: lang/json/AMMO_from_json.py
msgid "Copper wire ready to be covered with plastic."
msgstr "Miedziany drut gotowy do obleczenia w plastik."

#: lang/json/AMMO_from_json.py
msgid "plutonium fuel cell"
msgid_plural "plutonium fuel cells"
msgstr[0] "ogniwo paliwowe z plutonu"
msgstr[1] "ogniwa paliwowe z plutonu"
msgstr[2] "ogniw paliwowych z plutonu"
msgstr[3] "ogniwa paliwowego z plutonu"

#. ~ Description for plutonium fuel cell
#: lang/json/AMMO_from_json.py
msgid ""
"This is neither a fuel cell, nor nuclear, but the name stuck.  It uses "
"plutonium-244 as a catalyst to stabilize a complicated nanocompound that can"
" store enormous amounts of power.  Unfortunately it cannot be recharged by "
"conventional means: expended cells had to be sent to a central reprocessing "
"facility that almost certainly doesn't exist anymore."
msgstr ""
"To nie jest ogniwo paliwowe ani nuklearne, ale nazwa przylgnęła. "
"Wykorzystuje pluton-244 jako katalizator do stabilizacji skomplikowanego "
"nanokomponentu, który może przechowywać ogromne ilości energii. Niestety, "
"nie można go ładować konwencjonalnymi metodami: zużyte ogniwa musiały być "
"wysyłane do centralnego zakładu przetwarzania, który prawie na pewno już nie"
" istnieje."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "plutonium slurry"
msgid_plural "plutonium slurry"
msgstr[0] "zawiesina plutonu"
msgstr[1] "zawiesiny plutonu"
msgstr[2] "zawiesin plutonu"
msgstr[3] "zawiesiny plutonu"

#. ~ Description for plutonium slurry
#. ~ Description for watery plutonium slurry
#: lang/json/AMMO_from_json.py
msgid ""
"Highly radioactive slurry.  It is probably best to get far away from this."
msgstr ""
"Wysoce radioaktywna zawiesina. Najlepiej byłoby zabrać się jak najdalej od "
"niej."

#: lang/json/AMMO_from_json.py
msgid "watery plutonium slurry"
msgid_plural "watery plutonium slurry"
msgstr[0] "rozwodniona zawiesina plutonu"
msgstr[1] "rozwodnione zawiesiny plutonu"
msgstr[2] "rozwodnionych zawiesin plutonu"
msgstr[3] "rozwodnionej zawiesiny plutonu"

#: lang/json/AMMO_from_json.py lang/json/snippet_from_json.py
msgid "rock"
msgid_plural "rocks"
msgstr[0] "kamień"
msgstr[1] "kamienie"
msgstr[2] "kamieni"
msgstr[3] "kamienia"

#. ~ Description for rock
#: lang/json/AMMO_from_json.py
msgid ""
"A rock the size of a baseball.  Makes a decent melee weapon, and is also "
"good for throwing at enemies."
msgstr ""
"Kamień wielkości piłki baseballowej. Niezła broń ręczna, przydatna także do "
"rzucania w przeciwnika."

#: lang/json/AMMO_from_json.py
msgid "pebble"
msgid_plural "pebbles"
msgstr[0] "kamyk"
msgstr[1] "kamyki"
msgstr[2] "kamyków"
msgstr[3] "kamyka"

#. ~ Description for pebble
#: lang/json/AMMO_from_json.py
msgid "A small rock, useful as ammunition for slingshots."
msgstr "Mały kamień, użyteczny jako amunicja do proc."

#: lang/json/AMMO_from_json.py
msgid "clay pellet"
msgid_plural "clay pellets"
msgstr[0] "gliniany śrut"
msgstr[1] "gliniane śruty"
msgstr[2] "glinianych śrutów"
msgstr[3] "glinianego śrutu"

#. ~ Description for clay pellet
#: lang/json/AMMO_from_json.py
msgid "A handful of round projectiles made of clay, useful for slingshots."
msgstr "Garść okrągłych pocisków do procy zrobionych z gliny."

#: lang/json/AMMO_from_json.py
msgid "marble"
msgid_plural "marbles"
msgstr[0] "kulka"
msgstr[1] "kulki"
msgstr[2] "kulek"
msgstr[3] "kulki"

#. ~ Description for marble
#: lang/json/AMMO_from_json.py
msgid "A handful of glass marbles, useful as ammunition for slingshots."
msgstr "Garść szklanych kulek, użyteczne jako amunicja do procy."

#: lang/json/AMMO_from_json.py
msgid "bearings"
msgid_plural "bearings"
msgstr[0] "łożysko kulkowe"
msgstr[1] "łożyska kulkowe"
msgstr[2] "łożysk kulkowych"
msgstr[3] "łożyska kulkowego"

#. ~ Description for bearings
#: lang/json/AMMO_from_json.py
msgid "A box of ball bearings, useful as ammunition for slingshots."
msgstr "Pudło łożysk kulkowych, użyteczne jako amunicja do procy."

#: lang/json/AMMO_from_json.py
msgid "BB"
msgid_plural "BBs"
msgstr[0] "kulka ze śrutu"
msgstr[1] "kulki ze śrutu"
msgstr[2] "kulek ze śrutu"
msgstr[3] "kulki ze śrutu"

#. ~ Description for BB
#: lang/json/AMMO_from_json.py
msgid ""
"A box of small steel balls that can be fired from a BB gun.  They deal "
"virtually no damage."
msgstr ""
"Pudło małych stalowych kulek, które można wystrzelić z wiatrówki. Zadają "
"praktycznie zero obrażeń."

#: lang/json/AMMO_from_json.py
msgid "feather"
msgid_plural "feathers"
msgstr[0] "pióro"
msgstr[1] "pióra"
msgstr[2] "piór"
msgstr[3] "pióra"

#. ~ Description for feather
#: lang/json/AMMO_from_json.py
msgid "Feathers from a bird.  Useful for fletching arrows."
msgstr "Ptasie pióra. Przydatne do tworzenia strzał."

#: lang/json/AMMO_from_json.py
msgid "down feather"
msgid_plural "down feathers"
msgstr[0] "puchowe pióro"
msgstr[1] "puchowe pióra"
msgstr[2] "puchowych piór"
msgstr[3] "puchowego pióra"

#. ~ Description for down feather
#: lang/json/AMMO_from_json.py
msgid "Fluffy down feathers from a bird.  Useful for making cozy bedclothes."
msgstr ""
"Puchate pierze wydarte z ptasich podbrzuszy. Użyteczne przy wykonywaniu "
"miękkich pierzyn i poduszek."

#: lang/json/AMMO_from_json.py
msgid "120mm HEAT"
msgid_plural "120mm HEAT"
msgstr[0] "120 mm kumulacyjny"
msgstr[1] "120 mm kumulacyjne"
msgstr[2] "120 mm kumulacyjnych"
msgstr[3] "120 mm kumulacyjnego"

#. ~ Description for 120mm HEAT
#: lang/json/AMMO_from_json.py
msgid ""
"A 120mm high-explosive anti-tank round.  It could ruin anyone's whole day."
msgstr ""
"120 mm pocisk kumulacyjny ze zintegrowanym ładunkiem wybuchowym. Potrafi "
"zrujnować komuś cały dzień."

#: lang/json/AMMO_from_json.py
msgid "hydrogen canister"
msgid_plural "hydrogen canisters"
msgstr[0] "kanister z wodorem"
msgstr[1] "kanistry z wodorem"
msgstr[2] "kanistrów z wodorem"
msgstr[3] "kanistra z wodorem"

#. ~ Description for hydrogen canister
#: lang/json/AMMO_from_json.py
msgid ""
"A canister of pressurized hydrogen so heavily compressed it has turned "
"solid.  With proper equipment, it could be heated to plasma."
msgstr ""
"Kanister wodoru pod ciśnieniem, który został tak mocno sprężony, że zamienił"
" się w ciało stałe. Z odpowiednim wyposażeniem mógłby być podgrzany do stanu"
" plazmy."

#: lang/json/AMMO_from_json.py
msgid "mixed smokeless gunpowder"
msgid_plural "mixed smokeless gunpowder"
msgstr[0] "zmieszany proch bezdymny"
msgstr[1] "zmieszane prochy bezdymne"
msgstr[2] "zmieszanych prochów bezdymnych"
msgstr[3] "zmieszanego prochu bezdymnego"

#. ~ Description for mixed smokeless gunpowder
#: lang/json/AMMO_from_json.py
msgid ""
"Firearm-quality gunpowder, mixed without concern for composition, burn rate "
"or shape.  It has been slightly ground to make its properties more uniform."
"  Only the truly desperate would attempt to reload with this."
msgstr ""
"Proch strzelniczy o jakości broni palnej, mieszany bez względu na skład, "
"szybkość spalania i kształt. Został lekko zmielony, aby jego właściwości "
"były bardziej jednolite. Tylko prawdziwie zdesperowani próbowaliby tym "
"przeładować."

#: lang/json/AMMO_from_json.py
msgid "smokeless shotgun powder"
msgid_plural "smokeless shotgun powder"
msgstr[0] "bezdymny proch do strzelb"
msgstr[1] "bezdymne prochy do strzelb"
msgstr[2] "bezdymnych prochów do strzelb"
msgstr[3] "bezdymnego prochu do strzelb"

#. ~ Description for smokeless shotgun powder
#: lang/json/AMMO_from_json.py
msgid "Firearm-quality gunpowder, intended for use in shotgun shells."
msgstr "Proch strzelniczy używany w pociskach przeznaczonych do strzelb."

#: lang/json/AMMO_from_json.py
msgid "smokeless pistol powder"
msgid_plural "smokeless pistol powder"
msgstr[0] "bezdymny proch do pistoletów"
msgstr[1] "bezdymne prochy do pistoletów"
msgstr[2] "bezdymnych prochów do pistoletów"
msgstr[3] "bezdymnego prochu do pistoletów"

#. ~ Description for smokeless pistol powder
#: lang/json/AMMO_from_json.py
msgid "Firearm-quality gunpowder, intended for use in pistol ammunition."
msgstr "Proch strzelniczy używany w pociskach przeznaczonych do pistoletów."

#: lang/json/AMMO_from_json.py
msgid "smokeless magnum powder"
msgid_plural "smokeless magnum powder"
msgstr[0] "bezdymny proch do broni typu magnum"
msgstr[1] "bezdymne prochy do broni typu magnum"
msgstr[2] "bezdymnych prochów do broni typu magnum"
msgstr[3] "bezdymnego prochu do broni typu magnum"

#. ~ Description for smokeless magnum powder
#: lang/json/AMMO_from_json.py
msgid ""
"Firearm-quality gunpowder intended for use in magnum pistol ammunition."
msgstr ""
"Proch strzelniczy używany w pociskach przeznaczonych do broni typu magnum."

#: lang/json/AMMO_from_json.py
msgid "smokeless rifle powder"
msgid_plural "smokeless rifle powder"
msgstr[0] "bezdymny proch do karabinu"
msgstr[1] "bezdymne prochy do karabinu"
msgstr[2] "bezdymnych prochów do karabinu"
msgstr[3] "bezdymnego prochu do karabinu"

#. ~ Description for smokeless rifle powder
#: lang/json/AMMO_from_json.py
msgid "Firearm-quality gunpowder intended for use in rifle ammunition."
msgstr "Proch strzelniczy używany w pociskach przeznaczonych do karabinów."

#: lang/json/AMMO_from_json.py
msgid "smokeless overbore rifle powder"
msgid_plural "smokeless overbore rifle powder"
msgstr[0] "bezdymny proch do karabinu kalibru overbore"
msgstr[1] "bezdymne prochy do karabinu kalibru overbore"
msgstr[2] "bezdymnych prochów do karabinu kalibru overbore"
msgstr[3] "bezdymnego prochu do karabinu kalibru overbore"

#. ~ Description for smokeless overbore rifle powder
#: lang/json/AMMO_from_json.py
msgid "Firearm-quality gunpowder intended for use in large rifle ammunition."
msgstr ""
"Proch strzelniczy używany w dużych pociskach przeznaczonych do broni typu "
"overbore."

#: lang/json/AMMO_from_json.py
msgid "artillery propellant"
msgid_plural "artillery propellant"
msgstr[0] "pędnik artyleryjski"
msgstr[1] "pędniki artyleryjskie"
msgstr[2] "pędników artyleryjskich"
msgstr[3] "pędniku artyleryjskiego"

#. ~ Description for artillery propellant
#: lang/json/AMMO_from_json.py
msgid ""
"Single base smokeless gunpowder intended for use in artillery propelling "
"charges."
msgstr "Proch używany w pociskach przeznaczonych do broni artyleryjskiej."

#: lang/json/AMMO_from_json.py
msgid "oxidizer powder"
msgid_plural "oxidizer powder"
msgstr[0] "proszek utleniacza"
msgstr[1] "proszki utleniacza"
msgstr[2] "proszków utleniacza"
