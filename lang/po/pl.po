msgstr "Ruszajmy."

#: lang/json/snippet_from_json.py
msgid "Time's a-wasting.  Let's head out."
msgstr "Zegar tyka. Ruszajmy już."

#: lang/json/snippet_from_json.py
msgid "Come on.  We got stuff to do."
msgstr "Chodź, mamy masę rzeczy do zrobienia."

#: lang/json/snippet_from_json.py
msgid "Let's hit the road."
msgstr "Ruszajmy już."

#: lang/json/snippet_from_json.py
msgid "We'll pick this up another time.  Let's go."
msgstr "Pogadamy o tym innym razem. Ruszajmy już."

#: lang/json/snippet_from_json.py
msgid "Let's put a pin in this chat for now."
msgstr "Kiedyś wrócimy do tej rozmowy."

#: lang/json/snippet_from_json.py
msgid "Talk to you later."
msgstr "Potem pogadamy."

