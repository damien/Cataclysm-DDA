msgid_plural "faux fur scraps"
msgstr[0] "skrawki sztucznego futra"
msgstr[1] "skrawki sztucznego futra"
msgstr[2] "skrawków sztucznego futra"
msgstr[3] "skrawka sztucznego futra"

