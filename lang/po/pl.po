msgstr "Optymizacja ruchu (4)"

#: lang/json/effects_from_json.py
msgid "You move with machine-guided precision."
msgstr "Poruszasz się z maszynową precyzją."

#: lang/json/effects_from_json.py
msgid "Isohypsa Overwatch"
msgstr "Obserwacja Isohypsy"

#. ~ Description of effect 'Isohypsa Overwatch'.
