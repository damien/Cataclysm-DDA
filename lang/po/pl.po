#: lang/json/snippet_from_json.py
msgid "They'll kill us!  Run away!"
msgstr "Zabiją nas wszystkich! Uciekaj!"

#: lang/json/snippet_from_json.py
msgid "We're going to die!  Fall back!"
msgstr "Umrzemy! Wycofaj się!"

#: lang/json/snippet_from_json.py
msgid "Fall back and regroup!"
msgstr "Wycofać się i przegrupować!"

#: lang/json/snippet_from_json.py
msgid "There's no hope for victory.  I'm running!"
msgstr "Nie ma nadziei na zwycięstwo. Ja zwiewam!"

#: lang/json/snippet_from_json.py
msgid "Feet don't fail me now!"
msgstr "Stopy nie zawiedźcie mnie teraz!"

#: lang/json/snippet_from_json.py
msgid "I don't have to be faster than them, just faster than you!"
msgstr "Nie muszę być szybszy od nich, wystarczy, że będę szybszy od Ciebie!"

#: lang/json/snippet_from_json.py
msgid "Oh God, my leg, Oh God!"
msgstr "O Boże, moja noga, o Boże!"

#: lang/json/snippet_from_json.py
msgid "We have a serious situation here.  I'm leaving!"
msgstr "Mamy tutaj poważną sytuację. Ja się wynoszę!"

#: lang/json/snippet_from_json.py
msgid "It can't follow all of us.  I'll run this way, you go there!"
msgstr ""
"To nie może gonić nas wszystkich. Ja uciekam w tą stronę a ty w tamtą!"

#: lang/json/snippet_from_json.py
msgid "Me go, you stay."
msgstr "Ja idę, Ty zostajesz."

#: lang/json/snippet_from_json.py
msgid "Not that way!  Go left!"
msgstr "Nie tędy! Idź w lewo!"

#: lang/json/snippet_from_json.py
msgid "<move>!"
msgstr "<move>!"

#: lang/json/snippet_from_json.py
msgid "Retreat!  Retreat!"
msgstr "Odwrót! Odwrót!"

#: lang/json/snippet_from_json.py
msgid "Book it!"
msgstr "No dawaj!"

#: lang/json/snippet_from_json.py
msgid "Leg it!"
msgstr "Spieprzamy!"

#: lang/json/snippet_from_json.py
msgid "I'm getting the hell out of here!"
msgstr "Uciekam stąd jakby się paliło!"

#: lang/json/snippet_from_json.py
msgid "Thank fuck for all the cardio!"
msgstr "Zajebiście się cieszę że ćwiczyłem przed Kataklizmem."

#: lang/json/snippet_from_json.py
msgid "I can't outrun it!  I'm going to kill it!"
msgstr "Nie mogę tego prześcignąć! Więc to zabiję!"

#: lang/json/snippet_from_json.py
msgid "<swear>!  Die, you <name_b>!  I want to live!"
msgstr "<swear>! Zgiń w końcu Ty <name_b>! Ja chcę żyć!"

#: lang/json/snippet_from_json.py
msgid "My feet failed me!  Arms, don't fail me!"
msgstr "Moje stopy mnie zawiodły! Ręce chociaż wy mnie nie zawiedźcie!"

#: lang/json/snippet_from_json.py
msgid "Can't run!  Have to fight!"
msgstr "Nie można uciec! Trzeba walczyć!"

#: lang/json/snippet_from_json.py
msgid "I can't run away from this!"
msgstr "Nie mogę od tego uciec!"

#: lang/json/snippet_from_json.py
msgid "If I die, I'm taking you all with me!"
msgstr "Jeśli umrę to zabiorę was ze sobą do piekła!"

#: lang/json/snippet_from_json.py
msgid "Call the fire department!  Wait, they're dead!  Run away!"
msgstr "Dzwoń po straż pożarną! Czekaj, przecież oni nie żyją! Uciekaj!"

#: lang/json/snippet_from_json.py
msgid "This place is on fire.  I'm leaving."
msgstr "To miejsce płonie. Odchodzę."

#: lang/json/snippet_from_json.py
msgid "Put the fire out!  Put it out!"
msgstr "Zgaś ten ogień! Zgaś to!"

#: lang/json/snippet_from_json.py
msgid "Fire bad!  <move>!"
msgstr "Ogień zły! <move>!"

#: lang/json/snippet_from_json.py
msgid "We need to put this fire out!"
msgstr "Musimy ugasić ten ogień!"

#: lang/json/snippet_from_json.py
msgid "Somebody get some water!"
msgstr "Niech ktoś przyniesie tu wodę!"

#: lang/json/snippet_from_json.py
msgid "Fire, fire, FIRE!"
msgstr "Ogień, ogień, OGIEŃ!"

#: lang/json/snippet_from_json.py
msgid "Get an extinguisher!"
msgstr "Znajdź gaśnicę!"

#: lang/json/snippet_from_json.py
msgid "Somebody get some water or something!"
msgstr "Niech ktoś poda wodę albo co!"

#: lang/json/snippet_from_json.py
msgid "Danger hot!"
msgstr "Tu jest zbyt gorąco!"

#: lang/json/snippet_from_json.py
msgid "I've done so much for you, and you can't even keep me fed!"
msgstr ""
"Ja tyle dla ciebie zrobiłem, a ty nawet nie potrafisz podzielić się ze mną "
"jedzeniem!"

#: lang/json/snippet_from_json.py
msgid "You are the worst person in the world!"
msgstr "Jesteś najgorszą osobą na tym świecie!"

#: lang/json/snippet_from_json.py
msgid "Why are you such a horrible leader?"
msgstr "Dlaczego jesteś tak okropnym przywódcą?"

#: lang/json/snippet_from_json.py
msgid "I trusted you, and you can't even provide food!"
msgstr "Zaufałem Ci, a Ty nawet nie potrafisz zapewnić jedzenia!"

#: lang/json/snippet_from_json.py
msgid ""
"I don't have to take this abuse from you, there are plenty of people to "
"abuse me!"
msgstr ""
"Nie będę tolerował od ciebie takich obelg. Znam wiele innych osób które "
"mogłyby mnie dręczyć."

#: lang/json/snippet_from_json.py
msgid "You said you would keep me safe, and you haven't!"
msgstr "Obiecałeś że będę przy tobie bezpieczny! Kłamałeś."

#: lang/json/snippet_from_json.py
msgid ""
"There's only a couple hundred people left in the world, and I relied on the "
"dumbest one!"
msgstr ""
"Na tym świecie zostało pewnie jakieś parę setek osób. Ja musiałem zaufać "
"akurat tej najbardziej idiotycznej."

#: lang/json/snippet_from_json.py
msgid "You're a monster!"
msgstr "Jesteś potworem!"

#: lang/json/snippet_from_json.py
msgid "You call this safe?  You're crazy and incompetent!"
msgstr ""
"Nazywasz to bezpieczeństwem? Jesteś szalony, nieodpowiedzialny i "
"niekompetentny!"

#: lang/json/snippet_from_json.py
msgid "That was the last straw!  I'm not following your orders anymore!"
msgstr "Tego już za wiele! Pora się pożegnać."

#: lang/json/snippet_from_json.py
msgid "child"
msgstr "dziecko"

#: lang/json/snippet_from_json.py
msgid "my child"
msgstr "moje dziecko"

#: lang/json/snippet_from_json.py
msgid "dear"
msgstr "droga"

#: lang/json/snippet_from_json.py
msgid "my dear"
msgstr "moja droga"

#: lang/json/snippet_from_json.py
msgid "survivor"
msgstr "ocalony"

#: lang/json/snippet_from_json.py
msgid "Clean water, the taste that refreshes!"
msgstr "Czysta woda zdrowia doda!"

#: lang/json/snippet_from_json.py
msgid "I was parched, but not I am not."
msgstr "Suszyło mnie, ale już nie."

#: lang/json/snippet_from_json.py
msgid "Water is nice, but I should get a grog ration."
msgstr "Woda jest spoko, ale powinienem dostać porcję grogu."

#: lang/json/snippet_from_json.py
msgid "Nothing quite like clean water."
msgstr "Czystej wody nie zastąpi nic."

#: lang/json/snippet_from_json.py
msgid "That wasn't Evian, but I'm not thirsty."
msgstr "Mineralna to to nie jest, ale za to pragnienie zniknęło."

#: lang/json/snippet_from_json.py
msgid "And now I have eaten and am not hungry."
msgstr "Człowiek pojedzony to i nie głodny."

#: lang/json/snippet_from_json.py
msgid "That food was good, but I miss real restaurants."
msgstr "To dobre jedzenie, ale tęsknię za restauracjami."

#: lang/json/snippet_from_json.py
msgid "Well, that satisfied me."
msgstr "Cóż, to mnie usatysfakcjonowało."

#: lang/json/snippet_from_json.py
msgid "Nice to have food once in a while."
msgstr "Dobrze coś zjeść od czasu do czasu."

#: lang/json/snippet_from_json.py
msgid ""
"I just had some food, but I'm still peckish.  Would you mind if I ate more?"
msgstr ""
"Właśnie jadłem, ale nadal bym coś przekąsił. Nie było by problemu żebym coś "
"jeszcze przełknął?"

#: lang/json/snippet_from_json.py
msgid "Hey, <name_g>, we're out of food."
msgstr "Hej, <name_g>, skończyło się nam jedzenie."

#: lang/json/snippet_from_json.py
msgid "Hey, the larder is empty!  We're going to starve."
msgstr "Hej, spiżarnia jest pusta! Będziemy głodować."

#: lang/json/snippet_from_json.py
msgid "There's no food in the larder!"
msgstr "Nie ma jedzenia w spiżarni!"

#: lang/json/snippet_from_json.py
msgid "We need more food in the basecamp larder; it's empty."
msgstr "Potrzebujemy więcej jedzenia w spiżarni obozowej, bo jest pusta."

#: lang/json/snippet_from_json.py
msgid ""
"Uhm, <name_g>, I don't meant to criticize, but we should focus on "
"distributing some food into the basecamp larder."
msgstr ""
"Uhm, <name_g>, nie żebym krytykował, ale powinniśmy się skupić na zasileniu "
"spiżarni obozowej w nieco zapasów jedzenia."

#: lang/json/snippet_from_json.py
msgid "right on top of us!"
msgstr "prawie przy nas!"

#: lang/json/snippet_from_json.py
msgid "right there!"
msgstr "o tam!"

#: lang/json/snippet_from_json.py
msgid "danger close!"
msgstr "niebezpiecznie bliski!"

#: lang/json/snippet_from_json.py
msgid "almost in melee range!"
msgstr "prawie w zasięgu ręki!"

#: lang/json/snippet_from_json.py
msgid "too close for comfort!"
msgstr "niepokojąco blisko!"

#: lang/json/snippet_from_json.py
msgid "within shooting range."
msgstr "w zasięgu strzału!"

#: lang/json/snippet_from_json.py
msgid "only a couple of seconds' away."
msgstr "kilka sekund stąd."

#: lang/json/snippet_from_json.py
msgid "just a bit away."
msgstr "kilka kroków dalej."

#: lang/json/snippet_from_json.py
msgid "closer than I'd like."
msgstr "bliżej niż bym chciał."

#: lang/json/snippet_from_json.py
msgid "near enough to see us."
msgstr "na tyle blisko, że nas widzi."

#: lang/json/snippet_from_json.py
msgid "quite a bit away."
msgstr "kawałek stąd."

#: lang/json/snippet_from_json.py
msgid "maybe within shooting range."
msgstr "może w zasięgu strzału."

#: lang/json/snippet_from_json.py
msgid "at a good distance."
msgstr "nieco w oddali."

#: lang/json/snippet_from_json.py
msgid "far enough away that we could make sneak away."
msgstr "na tyle daleko, że możemy się wymknąć."

#: lang/json/snippet_from_json.py
msgid "out on the horizon, so don't worry much."
msgstr "na horyzoncie, więc nie mater więc za bardzo."

#: lang/json/snippet_from_json.py
msgid "at a long distance."
msgstr "w oddali."

