msgstr[2] "śrutów 00 do strzelby"
msgstr[3] "śrutu 00 do strzelby"

#. ~ Description for 00 shot
#: lang/json/AMMO_from_json.py
msgid ""
"A shell filled with metal pellets.  Extremely damaging, plus the spread "
"makes it very accurate at short range.  Favored by SWAT forces."
msgstr ""
"Naboje typu loftka są nabite grubym śrutem (peletami). Zadają duże "
"obrażenia, a ich rozrzut zapewnia celność na krótkich dystansach. "
"Preferowane przez oddziały SWAT."

#: lang/json/AMMO_from_json.py
msgid "shotgun beanbag"
msgid_plural "shotgun beanbags"
msgstr[0] "amunicja gumowa do strzelby"
msgstr[1] "amunicje gumowe do strzelby"
msgstr[2] "amunicji gumowej do strzelby"
msgstr[3] "amunicji gumowej do strzelby"

#. ~ Description for shotgun beanbag
#. ~ Description for shotshell, beanbag
#: lang/json/AMMO_from_json.py
msgid "A beanbag round for shotguns, not deadly but designed to disable."
msgstr ""
"Gumowy pocisk w naboju do strzelby nie ma zabijać a obalać i unieszkodliwiać"
" w ten sposób cel."

#: lang/json/AMMO_from_json.py
msgid "birdshot"
msgid_plural "birdshot"
msgstr[0] "drobny śrut do strzelby"
msgstr[1] "drobne śruty do strzelby"
msgstr[2] "drobnych śrutów do strzelby"
msgstr[3] "drobnego śrutu do strzelby"

#. ~ Description for birdshot
#: lang/json/AMMO_from_json.py
msgid ""
"Weak shotgun ammunition.  Designed for hunting birds and other small game, "
"its applications in combat are very limited."
msgstr ""
"Słaby nabój śrutowy do strzelb. Przeznaczony do polowania na ptactwo i inną "
"małą zwierzynę. Ma ograniczone zastosowanie w walce."

#: lang/json/AMMO_from_json.py
msgid "dragon's breath shell"
msgid_plural "dragon's breath shells"
msgstr[0] "amunicja zapalająca do strzelby"
msgstr[1] "amunicje zapalające do strzelby"
msgstr[2] "amunicji zapalającej do strzelby"
msgstr[3] "amunicji zapalającej do strzelby"

#. ~ Description for dragon's breath shell
#: lang/json/AMMO_from_json.py
msgid ""
"A shotgun shell filled with magnesium pellets or shards, used mostly as a "
"distress flare or pyrotechnics tool.  When the round is fired, high "
"temperature sparks and flames shoot out of the barrel, igniting everything "
"in their path."
msgstr ""
"Łuska śrutowa wypełniona granulkami lub odłamkami magnezu, używana głównie "
"jako raca alarmowa lub narzędzie pirotechniczne. Po wystrzeleniu pocisku z "
"lufy wystrzeliwują iskry i płomienie o wysokiej temperaturze, zapalając "
"wszystko na swojej drodze."

#: lang/json/AMMO_from_json.py
msgid "flechette shell"
msgid_plural "flechette shells"
msgstr[0] "amunicja strzałkowa do strzelby"
msgstr[1] "amunicje strzałkowe do strzelby"
msgstr[2] "amunicji strzałkowych do strzelby"
msgstr[3] "amunicji strzałkowej do strzelby"

#. ~ Description for flechette shell
#: lang/json/AMMO_from_json.py
msgid ""
"A shotgun shell filled with tiny steel darts.  Extremely damaging, plus the "
"spread makes it very accurate at short range.  Slices through most forms of "
"armor with ease."
msgstr ""
"Nabój do strzelby wypełniony małymi strzałkami lub igłami. Zadaje duże "
"obrażenia, a rozrzut zapewnia bardzo dobrą celność na krótkich dystansach. "
"Strzałki z łatwością przebijają większość pancerzy."

#: lang/json/AMMO_from_json.py
msgid "explosive slug"
msgid_plural "explosive slugs"
msgstr[0] "wybuchowa breneka do strzelby"
msgstr[1] "wybuchowych brenek do strzelby"
msgstr[2] "wybuchowych brenek do strzelby"
msgstr[3] "wybuchowej breneki do strzelby"

#. ~ Description for explosive slug
#: lang/json/AMMO_from_json.py
msgid ""
"A shotgun shell shooting a small explosive.  Damaging, but rather inaccurate"
" and short ranged.  Banned in several states."
msgstr ""
"Pocisk do strzelby miotający małym ładunkiem wybuchowym. Niszczący, ale "
"raczej niecelny i o krótkim zasięgu. Zakazany w wielu stanach."

#: lang/json/AMMO_from_json.py
msgid "00 shot, scrap loaded"
msgid_plural "00 shot, scrap loaded"
msgstr[0] "śrut 00 do strzelby, załadowany złomem"
msgstr[1] "śruty 00 do strzelby, załadowane złomem"
msgstr[2] "śrutów 00 do strzelby, załadowanych złomem"
msgstr[3] "śrutu 00 do strzelby, załadowanego złomem"

#. ~ Description for 00 shot, scrap loaded
#. ~ Description for shotshell, junk
#: lang/json/AMMO_from_json.py
msgid ""
"A shotgun shell filled with whatever was lying around.  They are more "
"damaging than birdshot, but fairly inaccurate."
msgstr ""
"Nabój do strzelby wypchany czymkolwiek co było pod ręką. Silniejszy od "
"śrutowca, lecz mniej celny."

#: lang/json/AMMO_from_json.py
msgid "00 shot, black powder, scrap loaded"
msgid_plural "00 shot, black powder, scrap loaded"
msgstr[0] "śrut 00 do strzelby, czarnoprochowy, załadowany złomem"
