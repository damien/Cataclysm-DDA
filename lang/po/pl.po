msgstr[0] ""
msgstr[1] ""
msgstr[2] ""
msgstr[3] ""

#. ~ Description for pair of XL hard arm guards
#: lang/json/ARMOR_from_json.py
msgid ""
"A pair of neoprene arm sleeves covered with molded plastic sheaths.  Epic "
