msgstr[1] "wełniana szarfa"
msgstr[2] "wełniana szarfa"
msgstr[3] "wełniana szarfa"

#. ~ Description for knit cowl
#: lang/json/ARMOR_from_json.py
msgid ""
"A snuggly woolen cowl.  It's one of those stylish and bulky cowls you see in"
" fashion magazines."
msgstr ""
"Miękka wełniana szarfa zrobiona na szydełkach. Jedna tych stylowych grubych "
"szarf, które widywałeś w magazynach mody."

#: lang/json/ARMOR_from_json.py
