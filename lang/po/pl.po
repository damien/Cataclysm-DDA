#: lang/json/COMESTIBLE_from_json.py
msgid "chunk of mutant humanoid fat"
msgid_plural "chunks of mutant humanoid fat"
msgstr[0] "kawałek mięsa człekokształtnego mutanta"
msgstr[1] "kawałki mięsa człekokształtnego mutanta"
msgstr[2] "kawałków mięsa człekokształtnego mutanta"
msgstr[3] "kawałka mięsa człekokształtnego mutanta"

#. ~ Description for chunk of mutant humanoid fat
#: lang/json/COMESTIBLE_from_json.py
