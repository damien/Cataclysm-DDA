#: lang/json/gun_from_json.py
msgid ""
"A severed robotic hand from a Wraitheon Sentinel.  The powerful electro-"
"laser stun gun embed on its wrist is still functional, and can be used when "
"connected to an UPS."
msgstr ""
"Odcięta robotyczna ręka z Wartownika Wraitheon. Potężny paralizator elektro-"
"laserowy umieszczony na nadgarstku wciąż działa i może być użyty po "
"podłączeniu do zasilacza UPS."

#: lang/json/gun_from_json.py
