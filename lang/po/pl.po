msgstr "Przewracasz się z prawa na lewo, starając się utrzymać ciepło."

#: src/player_hardcoded_effects.cpp
msgid "It's too cold to sleep."
msgstr "Jest za zimno na sen."

#: src/player_hardcoded_effects.cpp
msgid "You toss and turn in the heat."
msgstr "Przewracasz się z prawa na lewo z gorąca."

#: src/player_hardcoded_effects.cpp
msgid "It's too hot to sleep."
msgstr "Jest za gorąco na sen."

#: src/player_hardcoded_effects.cpp
msgid "Your flesh crawls; insects tear through the flesh and begin to emerge!"
msgstr ""
"Coś pełza w twoim ciele. Owady rozrywają ciało i wychodzą na zewnątrz."

