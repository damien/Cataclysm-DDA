msgctxt "scenario_male"
msgid "Challenge - Hunted"
msgstr "Wyzwanie - polowany"

#. ~ Name for scenario 'Challenge - Hunted' for a female character
#: lang/json/scenario_from_json.py
msgctxt "scenario_female"
msgid "Challenge - Hunted"
msgstr "Wyzwanie - polowana"

#. ~ Description for scenario 'Challenge - Hunted' for a male character.
#: lang/json/scenario_from_json.py
msgctxt "scen_desc_male"
msgid ""
"Since the start of the Cataclysm, something has been hunting you "
"relentlessly.  You can outrun it, but it always seems to find you "
"eventually.  The only escape is for one of you to die."
msgstr ""
"Od początku Kataklizmu coś niestrudzenie na ciebie poluje. Możesz mu uciec, "
"ale zawsze w końcu cię znajdzie. Jedyną ucieczką jest śmierć jednego z was."

