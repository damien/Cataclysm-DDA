msgstr[1] "duże gotowane ludzkie żołądki"
msgstr[2] "dużych gotowanych ludzkich żołądków"
msgstr[3] "dużego gotowanego ludzkiego żołądka"

#. ~ Description for boiled large human stomach
#: lang/json/COMESTIBLE_from_json.py
msgid ""
"A boiled stomach from a large humanoid creature, nothing else.  It looks all"
" but appetizing."
msgstr ""
"Gotowany żołądek z humanoida, nic ponadto. Wszytko można o nim można "
"powiedzieć, ale nie że jest apetyczny."

#: lang/json/COMESTIBLE_from_json.py
msgid "boiled stomach"
msgid_plural "boiled stomachs"
msgstr[0] "gotowany żołądek"
