#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Cryosleep Survivor"
msgstr "Ocalały ze snu kriogenicznego"

#. ~ Profession (male Cryosleep Survivor) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"A sudden power failure woke you from the cryosleep sarcophagus in which you "
"had entombed yourself lifetimes ago.  It seems the emergency reanimation "
"procedure has damaged your memory, and now, bearing almost no knowledge of "
"your past life, you must find a way to survive in a ruined and alien world."
msgstr ""
"Nagła awaria zasilania wybudziła cię z sarkofagu, w którym zapadłeś w "
"kriogeniczny sen przed wiekami. Wygląda na to, że procedura awaryjnej "
"reanimacji uszkodziła twoją pamięć i teraz, nie mając prawie żadnej wiedzy o"
" swoim poprzednim życiu, musisz znaleźć sposób na przetrwanie w zrujnowanym "
"i obcym świecie."

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Cryosleep Survivor"
msgstr "Ocalała ze snu kriogenicznego"

