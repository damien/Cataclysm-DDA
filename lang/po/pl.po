msgstr[2] "gotowanych żołądków"
msgstr[3] "gotowanego żołądka"

#. ~ Description for boiled stomach
#: lang/json/COMESTIBLE_from_json.py
msgid ""
"A small boiled stomach from an animal, nothing else.  It looks all but "
"appetizing."
msgstr ""
"Mały gotowany żołądek zwierzęcy, nic ponadto. Wszytko można o nim można "
"powiedzieć, ale nie że jest apetyczny."

#: lang/json/COMESTIBLE_from_json.py
msgid "boiled human stomach"
