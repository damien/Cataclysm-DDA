msgstr[1] "szczeniaki labradora"
msgstr[2] "szczeniaków labradora"
msgstr[3] "szczeniaka labradora"

#. ~ Description for Labrador puppy
#: lang/json/MONSTER_from_json.py
msgid ""
"An adorable, defenseless Labrador puppy.  Much safer to tame than an adult "
"dog."
msgstr ""
"Uroczy, bezbronny szczeniak Labradora. Znacznie bezpieczniej jest oswoić go "
"niż dorosłego psa."

#: lang/json/MONSTER_from_json.py
msgid "bulldog"
msgid_plural "bulldogs"
msgstr[0] "buldog"
msgstr[1] "buldogi"
msgstr[2] "buldogów"
msgstr[3] "buldoga"

#. ~ Description for bulldog
#: lang/json/MONSTER_from_json.py
msgid ""
"The American bulldog is a hardy, well built dog, that seems suited for "
"surviving the apocalypse."
msgstr ""
"Amerykański buldog to twardy, dobrze zbudowany pies, który wydaje się "
"odpowiednio przystosowany do przetrwania apokalipsy."

#: lang/json/MONSTER_from_json.py
msgid "bulldog puppy"
msgid_plural "bulldog puppies"
msgstr[0] "szczeniak buldoga"
msgstr[1] "szczeniaki buldoga"
msgstr[2] "szczeniaków buldoga"
msgstr[3] "szczeniaka buldoga"

#. ~ Description for bulldog puppy
#: lang/json/MONSTER_from_json.py
msgid ""
"An adorable, defenseless American bulldog puppy.  Much safer to tame than an"
" adult dog."
msgstr ""
"Uroczy bezbronny szczeniak amerykańskiego buldoga. Dużo łatwiejszy do "
"oswojenia niż dorosły osobnik."

#: lang/json/MONSTER_from_json.py
msgid "pit bull mix"
msgid_plural "pit bull mixes"
msgstr[0] "pitbul"
msgstr[1] "pitbule"
msgstr[2] "pitbuli"
msgstr[3] "pitbula"

#. ~ Description for pit bull mix
#: lang/json/MONSTER_from_json.py
msgid ""
"The oft-misunderstood pit bull is not actually a single breed but a label "
"for several kinds of terriers.  It has average abilities, and is well-known "
"for its 'lock jaw' - which isn't real, but their incredible determination "
"is."
msgstr ""
"Często niepoprawnie rozumiany pitbul to de facto nie pojedynczy gatunek a "
"nazwa kilku rodzajów teriera. Przeciętne zdolne i powszechnie znane z "
"'zacisku szczęk' co nie jest prawdą, w przeciwieństwie do ich niezwykłej "
"determinacji."

#: lang/json/MONSTER_from_json.py
msgid "pit bull puppy"
msgid_plural "pit bull puppies"
msgstr[0] "szczeniak pitbula"
msgstr[1] "szczeniaki pitbula"
msgstr[2] "szczeniaków pitbula"
msgstr[3] "szczeniaka pitbula"

#. ~ Description for pit bull puppy
#: lang/json/MONSTER_from_json.py
msgid ""
"An adorable, defenseless pit bull puppy.  Much safer to tame than an adult "
"dog."
msgstr ""
"Uroczy bezbronny szczeniak pitbula. Dużo łatwiejszy do oswojenia niż dorosły"
" osobnik."

#: lang/json/MONSTER_from_json.py
msgid "beagle"
msgid_plural "beagles"
msgstr[0] "beagle"
msgstr[1] "beagle'e"
msgstr[2] "beagle'i"
msgstr[3] "beagle'a"

#. ~ Description for beagle
#: lang/json/MONSTER_from_json.py
msgid ""
"An adorable beagle that has managed to survive the apocalypse.  Being agile "
"and small, they are difficult to shoot at.  Generally attacks in packs."
msgstr ""
"Uroczy beagle który przetrwał apokalipsę. Będąc zwinnym i małym, jest rudny "
"do trafienia z broni palnej. Zwykle atakują sforą."

#: lang/json/MONSTER_from_json.py
msgid "beagle puppy"
msgid_plural "beagle puppies"
msgstr[0] "szczeniak beagle'a"
msgstr[1] "szczeniaki beagle'a"
msgstr[2] "szczeniaków beagle'a"
msgstr[3] "szczeniaka beagle'a"

#. ~ Description for beagle puppy
#: lang/json/MONSTER_from_json.py
msgid ""
"An adorable, defenseless beagle puppy.  Much safer to tame than an adult "
"dog."
msgstr ""
"Uroczy bezbronny szczeniak beagle. Dużo łatwiejszy do oswojenia niż dorosły "
"osobnik."

#: lang/json/MONSTER_from_json.py
msgid "border collie"
msgid_plural "border collies"
msgstr[0] "border collie"
msgstr[1] "border collie"
msgstr[2] "border collie"
msgstr[3] "border collie"

#. ~ Description for border collie
#: lang/json/MONSTER_from_json.py
msgid ""
"An athletic and hyperactive dog that loves to herd animals and jump, the "
"Border Collie is an agile attacker.  Although they can be easy to train, "
"they don't work well in packs."
msgstr ""
