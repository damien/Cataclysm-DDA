#: lang/json/speech_from_json.py
msgid "\"Stop where you are!\""
msgstr "\"Stój tam gdzie jesteś!\""

#: lang/json/speech_from_json.py
msgid "\"You are under arrest!\""
msgstr "\"Jesteś aresztowany!\""

#: lang/json/speech_from_json.py
msgid "\"Criminal activity detected!\""
msgstr "\"Wykryto aktywność kryminalną!\""

#: lang/json/speech_from_json.py
msgid "\"Criminal activity registered!\""
msgstr "\"Zarejestrowano aktywność kryminalną!\""

#: lang/json/speech_from_json.py
msgid "\"Violation of law detected!\""
msgstr "\"Wykryto złamanie prawa!\""

#: lang/json/speech_from_json.py
msgid "\"Suspect on the move!\""
msgstr "\"Podejrzany przemieszcza się!\""

#: lang/json/speech_from_json.py
msgid "\"Suspect in sight!\""
msgstr "\"Podejrzany w polu widzenia!\""

#: lang/json/speech_from_json.py
msgid "\"You are being detained!\""
msgstr "„Jesteś zatrzymany!”"

#: lang/json/speech_from_json.py
msgid "\"You have right to remain silent!\""
msgstr "\"Masz prawo milczeć!\""

#: lang/json/speech_from_json.py
msgid "\"Requesting assistance!\""
msgstr "\"Prośba o wsparcie!\""

#: lang/json/speech_from_json.py
msgid "\"Requesting supervisor!\""
msgstr "„Prośba o nadzór!”"

#: lang/json/speech_from_json.py
msgid "\"Requesting human officer!\""
msgstr "„Prośba o ludzkiego oficera!”"

#: lang/json/speech_from_json.py
msgid "\"No officer on scene.  Requesting backup!\""
msgstr "\"Brak służb na miejscu. Wzywam wsparcie!\""

#: lang/json/speech_from_json.py
msgid "\"Let me see your hands!\""
msgstr "\"Pokaż mi ręce!\""

#: lang/json/speech_from_json.py
msgid "\"Stop resisting!\""
msgstr "\"Przestań się opierać!\""

#: lang/json/speech_from_json.py
msgid "\"Code 10-66.  Copy 10-4.  Possible 10-55.\""
msgstr "\"Kod 10-66. Zarejestrowano 10-4. Prawdopodobne 10-55.\""

#: lang/json/speech_from_json.py
msgid "\"Probable 10-70.\""
msgstr "\"Możliwe 10-70.\""

#: lang/json/speech_from_json.py
msgid "\"Get on the ground!  Now!\""
msgstr "\"Na ziemię! Już!\""

#: lang/json/speech_from_json.py
msgid "\"Suspected felony!\""
msgstr "„Podejrzenie przestępstwa!”"

#: lang/json/speech_from_json.py
msgid "\"Suspected misdemeanor!\""
msgstr "\"Podejrzenie wykroczenia!\""

#: lang/json/speech_from_json.py
msgid "\"Do not reach for your pockets!\""
msgstr "\"Nie sięgaj do kieszeni!\""

#: lang/json/speech_from_json.py
msgid "\"Keep your hands up!\""
msgstr "\"Trzymaj swoje ręce wysoko!\""

#: lang/json/speech_from_json.py
msgid "\"Get on your knees!\""
msgstr "\"Na kolana!\""

#: lang/json/speech_from_json.py
msgid "\"Hands in the air!\""
msgstr "\"Ręce do góry!\""

#: lang/json/speech_from_json.py
msgid "\"Wait for law enforcement officer!\""
msgstr "\"Czekaj na funkcjonariusza policji!”"

#: lang/json/speech_from_json.py
msgid "\"Remain where you are!\""
msgstr "\"Zostań tam gdzie jesteś!\""

#: lang/json/speech_from_json.py
msgid "\"Police inbound.  Stay where you are!\""
msgstr "„Policja w drodze. Zostań tam, gdzie jesteś!”"

#: lang/json/speech_from_json.py
msgid "visceral chittering."
msgstr "ekspresywne ćwierkanie."

#: lang/json/speech_from_json.py
msgid "a clear, high-pitched hum."
msgstr "czyste wysokie buczenie."

#: lang/json/speech_from_json.py
msgid "the hum of static electricity."
msgstr "buczenie elektryczności statycznej."

#: lang/json/speech_from_json.py
msgid "a low buzzing sound."
msgstr "niski buczący dźwięk."

#: lang/json/speech_from_json.py
msgid "\"I AM FOODPERSON.  AND I BRING SUSTENANCE!\""
msgstr "\"JESTEM FOODPERSON. I PRZYNOSZĘ ZRÓWNOWAŻENIE!\""

#: lang/json/speech_from_json.py
msgid "\"Come to Foodplace today and buy food!\""
msgstr "\"Przyjdź dziś do Foodplace i kup jedzenie!\""

#: lang/json/speech_from_json.py
msgid "\"Foodplace: The best restaurant in an area!\""
msgstr "\"Foodplace: najlepsza restauracja w okolicy!\""

#: lang/json/speech_from_json.py
#, no-python-format
msgid "\"Our food contains up to 95% real food.\""
msgstr "\"Nasze jedzenie zawiera do 95% prawdziwego jedzenia.\""

#: lang/json/speech_from_json.py
msgid "\"At Foodplace your excellent value brings nourishment and delight.\""
msgstr ""
"\"W Foodplace twoja doskonała wartość przynosi wartości odżywcze i smak.\""

#: lang/json/speech_from_json.py
msgid "\"At Foodplace we have a host of solutions for your food needs!\""
msgstr "\"W Foodplace mamy wiele rozwiązań dla twoich potrzeb żywieniowych!\""

#: lang/json/speech_from_json.py
msgid "\"♪Eat at Foodplace.  ♫It is a place with food.♪\""
msgstr "\"♪Jedz w Foodplace. ♫To miejsce ma jedzenie.♪\""

#: lang/json/speech_from_json.py
msgid ""
"\"Foodplace is a popular food chain selling food items.  What else is there "
"to know?\""
msgstr ""
"\"Foodplace to popularna sieć gastronomiczna sprzedająca jedzenie. Co więcej"
" można powiedzieć?\""

#: lang/json/speech_from_json.py
msgid "\"You need food, don't you?  Then come with me to FOODPLACE!!\""
msgstr "\"Potrzebujesz jeść, co nie? Więc choć ze mną do FOODPLACE!!\""

#: lang/json/speech_from_json.py
msgid "\"You need food, don't you?  It's time for Foodplace!\""
msgstr "\"Potrzebujesz jeść, co nie? Czas na Foodplace!\""

#: lang/json/speech_from_json.py
msgid "\"Foodplace: It's the Calories.\""
msgstr "\"Foodplace: Ah te kalorie.\""

#: lang/json/speech_from_json.py
msgid "\"Foodplace: Don’t get caught in the web of unsafe diet.\""
msgstr "\"Foodplace: Nie daj się złapać w sieć niebezpiecznych diet.\""

#: lang/json/speech_from_json.py
msgid "\"Foodplace: Edible food is OUR guarantee!\""
msgstr "\"Foodplace: Zjadliwe jedzenie jest u NAS gwarantowane!\""

#: lang/json/speech_from_json.py
msgid "\"Foodplace: We bring food to life!\""
msgstr "\"Foodplace: Wnosimy życie do jedzenia!\""

#: lang/json/speech_from_json.py
msgid "\"Foodplace: Edible food is one of our main goals!\""
msgstr "\"Foodplace: Zjadliwe jedzenie to jeden z naszych głównych celów!\""

#: lang/json/speech_from_json.py
msgid ""
"\"Foodplace is the only way to obtain healthy and strong lifecycle "
"choices!!\""
msgstr "\"Foodplace to jedyny wybór drogi do zdrowego i silnego cyklu życia!!\""

#: lang/json/speech_from_json.py
msgid "\"Wanna play with me?\""
msgstr "„Chcesz się ze mną pobawić?”."

#: lang/json/speech_from_json.py
msgid "\"Sing with me!\""
msgstr "„Zaśpiewaj ze mną!”."

#: lang/json/speech_from_json.py
msgid "\"I love you!\""
msgstr "„Kocham cię!”."

#: lang/json/speech_from_json.py
msgid "\"Please take me with you!\""
msgstr "„Proszę, weź mnie ze sobą!”."

#: lang/json/speech_from_json.py
msgid "\"May I have a cookie?\""
msgstr "„Mogę ciasteczko?”."

#: lang/json/speech_from_json.py
msgid "\"Let's play together!\""
msgstr "„Zagrajmy razem!”."

#: lang/json/speech_from_json.py
msgid "\"Time to play!\""
msgstr "„Czas na zabawę!”."

#: lang/json/speech_from_json.py
msgid "\"Om nom nom!  Delicious!\""
msgstr "„Mniam, mniam! Pychota!”."

#: lang/json/speech_from_json.py
msgid "\"Are you my mommy?\""
msgstr "„Jesteś moją mamusią?”."

#: lang/json/speech_from_json.py
msgid "\"Oh, how fun!\""
msgstr "„O, jak fajnie!”."

#: lang/json/speech_from_json.py
msgid "\"You're my best friend!\""
msgstr "„Jesteś moim najlepszym przyjacielem!”."

#: lang/json/speech_from_json.py
msgid "\"Heehee!\""
msgstr "„Hihi!”."

#: lang/json/speech_from_json.py
msgid "\"Let's have fun!\""
msgstr "„Pobawmy się!”."

#: lang/json/speech_from_json.py
msgid "\"Let's have a tea party!\""
msgstr "„Zróbmy przyjęcie herbaciane!”."

#: lang/json/speech_from_json.py
msgid "\"You're the best!\""
msgstr "„Jesteś najlepszy!”."

#: lang/json/speech_from_json.py
msgid "\"You shouldn't have done that.\""
msgstr "„Nie powinieneś był tego robić”."

#: lang/json/speech_from_json.py
msgid "\"Let's play… Russian roulette.\""
msgstr "„Zagrajmy… w rosyjską ruletkę”."

#: lang/json/speech_from_json.py
msgid "\"I hate you.\""
msgstr "„Nienawidzę cię”."

#: lang/json/speech_from_json.py
msgid "\"Go kill yourself!\""
msgstr "„Idź się zabij!”."

#: lang/json/speech_from_json.py
msgid "\"Big Brother is watching you…\""
msgstr "„Wielki Brat patrzy…”."

#: lang/json/speech_from_json.py
msgid "\"Die for me!\""
msgstr "„Umrzyj dla mnie!”."

#: lang/json/speech_from_json.py
msgid "\"Why won't you die?\""
msgstr "„Czemu nie umrzesz?”."

#: lang/json/speech_from_json.py
msgid "\"Blood…  Delicious.\""
msgstr "„Krew… Pyszna”."

#: lang/json/speech_from_json.py
msgid "\"See you… IN HELL!\""
msgstr "„Do zobaczenia… W PIEKLE!”."

#: lang/json/speech_from_json.py
msgid "AAAIEEEEEEE!"
msgstr "AAAIEEEEEEE!"

#: lang/json/speech_from_json.py
msgid "\"FUCK YOU!\""
msgstr "„PIERDOL SIĘ!”."

#: lang/json/speech_from_json.py
msgid "\"What did you do with my Mommy?\""
msgstr "„Co zrobiłeś z moją mamusią?”."

#: lang/json/speech_from_json.py
msgid "\"Stay with me… forever!\""
msgstr "„Zostań ze mną… na zawsze!”."

#: lang/json/speech_from_json.py
msgid "\"Hey kids.  Want some candy?\""
msgstr "„Hej dzieciaki. Chcecie cukierki?”."

#: lang/json/speech_from_json.py
msgid "\"Down here, they ALL float!\""
msgstr "„Tu w dole, oni WSZYSCY płyną!”."

#: lang/json/speech_from_json.py
msgid "\"Do you really need that much honey?\""
msgstr "„Czy naprawdę potrzebujesz aż tylu pieniędzy?”."

#: lang/json/speech_from_json.py
msgid "\"My previous owner squealed like a pig when I gutted her!\""
msgstr ""
"„Moja poprzednia właścicielka kwiczała jak świnia, gdy ją oprawiłem!”."

#: lang/json/speech_from_json.py
msgid "BARK!"
msgstr "HAU!"

#: lang/json/speech_from_json.py
msgid "YAP!"
msgstr "HAUU!"

#: lang/json/speech_from_json.py
msgid "WOOF!"
msgstr "ŁUF!"

#: lang/json/speech_from_json.py
msgid "labored breathing."
msgstr "utrudzony oddech."

#: lang/json/speech_from_json.py
msgid "a whimper."
msgstr "skomlenie."

#: lang/json/speech_from_json.py
msgid "a rasping growl."
msgstr "chrypiący warkot."

#: lang/json/speech_from_json.py
msgid "\"I have no mouth and yet I scream!\""
msgstr "\"Nie mam ust a jednak krzyczę!\""

#: lang/json/speech_from_json.py
msgid "\"¿Por qué?\""
msgstr "\"¿Por qué?\""

#: lang/json/speech_from_json.py
msgid "\"Come closer little one.\""
msgstr "\"Podejdź bliżej malutki.\""

#: lang/json/speech_from_json.py
msgid "\"The better to eat you!  I don't actually think I eat anymore.\""
msgstr "Lepiej cię zjeść! Tak naprawdę nie sądzę żebym jeszcze jadł.\""

#: lang/json/speech_from_json.py
msgid "\"Cyrus said if I was patient, he could get me a new body.\""
msgstr "\"Cyrus mówił, że jak będę cierpliwy to załatwi mi nowe ciało.\""

#: lang/json/speech_from_json.py
msgid "\"Quem é Você?\""
msgstr "\"Quem é Você?\""

#: lang/json/speech_from_json.py
msgid "\"Eu vou te matar!\""
msgstr "\"Eu vou te matar!\""

#: lang/json/speech_from_json.py
msgid "\"I can't keep myself from killing you, please run!\""
msgstr "\"Nie mogę się powstrzymać by cię zabić, proszę uciekaj!\""

#: lang/json/speech_from_json.py
msgid "\"bzzzzzz.\""
msgstr "\"bzzzzzz.\""

#: lang/json/speech_from_json.py
msgid "\"west, west, west, west, west\""
msgstr "\"zachód, zachód, zachód, zachód, zachód\""

#: lang/json/speech_from_json.py
msgid "\"east, east, east, east, east\""
msgstr "\"wschód, wschód, wschód, wschód, wschód\""

#: lang/json/speech_from_json.py
msgid "\"south, south, south, south, south\""
msgstr "\"południe, południe, południe, południe, południe\""

#: lang/json/speech_from_json.py
msgid "\"north, north, north, north, north\""
msgstr "\"północ, północ, północ, północ, północ\""

#: lang/json/speech_from_json.py
msgid "\"Where am I?  Where am I?  Where am I?\""
msgstr "\"Gdzie jestem? Gdzie jestem? Gdzie jestem?\""

#: lang/json/speech_from_json.py
msgid "\"It's very cold, It's very cold, It's very cold\""
msgstr "\"Jest tak zimno, jest tak zimno, jest tak zimno\""

#: lang/json/speech_from_json.py
msgid "\"dark, dark, where is everything\""
msgstr "\"ciemność, ciemność, gdzie się wszystko podziało\""

#: lang/json/speech_from_json.py
msgid "When the testing is over, you will be missed."
msgstr "Gdy skończą się testy, będziemy tęsknić."

#: lang/json/speech_from_json.py
msgid ""
"Unbelievable.  You, [subject name here], must be the pride of [subject "
"hometown here]!"
msgstr ""
"Niewiarygodne, Ty, [wstaw imię podmiotu], musisz być dumą [wstaw miasto "
"pochodzenia podmiotu]!"

#: lang/json/speech_from_json.py
msgid ""
"That thing is probably some sort of raw sewage container.  Go ahead and rub "
"your face all over it."
msgstr ""
"Ta rzecz to prawdopodobnie jakiś rodzaj pojemnika na nieprzetworzone ścieki."
" Dalej, wytrzyj sobie o niego twarz."

#: lang/json/speech_from_json.py
msgid ""
"For your own safety and the safety of others, please refrain from touching "
"[bzzzzzt]"
msgstr ""
"Dla bezpieczeństwa własnego i innych proszę powstrzymaj się od dotykania "
"[bzzzzzzt]"

#: lang/json/speech_from_json.py
msgid ""
"No one will blame you for giving up.  In fact, quitting at this point is a "
"perfectly reasonable response."
msgstr ""
"Nikt cię nie będzie obwiniał jak się poddasz. W rzeczy samej odpuszczenie w "
"tym miejscu to całkiem rozsądna reakcja."

#: lang/json/speech_from_json.py
msgid ""
"Fantastic!  You remained resolute and resourceful in an atmosphere of "
"extreme pessimism."
msgstr ""
"Fantastycznie! Pozostałeś wytrwały i zaradny w atmosferze niezwykłego "
"pesymizmu."

#: lang/json/speech_from_json.py
msgid "Hello again.  To reiterate our previous warning: [garbled]"
msgstr ""
"Witaj ponownie. By powtórzyć nasze poprzednie ostrzeżenie: [zniekształcone]"

#: lang/json/speech_from_json.py
msgid "Weeeeeeeeeeeeeeeeeeeeee[bzzt]"
msgstr "Weeeeeeeeeeeeeeeeeeeeee[bzzt]"

#: lang/json/speech_from_json.py
msgid "If you become light headed from thirst, feel free to pass out."
msgstr "Jeśli masz zawroty głowy z pragnienia, to możesz zawsze zemdleć."

#: lang/json/speech_from_json.py
msgid ""
"No further compliance information is required or will be provided, and you "
"are an excellent test subject!"
msgstr ""
"Więcej informacji o podporządkowaniu się nie nie będzie ani żądane ani "
"dostarczane, a ty jesteś doskonałym obiektem testowym!"

#: lang/json/speech_from_json.py
msgid "Thank you for helping us help you help us all."
msgstr ""
"Dziękuje  ci za pomoc nam w pomożeniu tobie w udzieleniu pomocy nam "
"wszystkim."

#: lang/json/speech_from_json.py
msgid ""
"Cake and grief counseling will be available at the conclusion of the test."
msgstr "Ciasto i konsolacja będzie dostępna po zakończeniu testu."

#: lang/json/speech_from_json.py
msgid "The experiment is nearing its conclusion."
msgstr "Eksperyment zbliża się do konkluzji."

#: lang/json/speech_from_json.py
msgid ""
"The Enrichment Center is required to remind you that you will be baked "
"[garbled] cake."
msgstr ""
"Centrum Wzbogacania jest w obowiązku przypomnieć ci że zostaniesz upieczone "
"[zniekształcone] ciasto."

#: lang/json/speech_from_json.py
msgid "We are very, very happy for your success."
msgstr "Bardzo, bardzo cieszymy się z twojego sukcesu."

#: lang/json/speech_from_json.py
msgid "We are throwing a party in honor of your tremendous success."
msgstr "Urządzamy przyjęcie dla uczczenia twojego olbrzymiego sukcesu."

#: lang/json/speech_from_json.py
msgid "A party associate will arrive shortly to collect you for your party."
msgstr ""
"Pracownik przyjęcia wkrótce przybędzie by zabrać cię na twoje przyjęcie."

#: lang/json/speech_from_json.py
msgid "I know you're there.  I can feel you here."
msgstr "Wiem że tam jesteś. Czuję tu twoją obecność."

#: lang/json/speech_from_json.py
msgid "You're not going the right way."
msgstr "Nie idziesz właściwą drogą."

#: lang/json/speech_from_json.py
msgid "You shouldn't be here.  This isn't safe for you."
msgstr "Nie powinieneś tu być. Nie jest tu dla ciebie bezpiecznie."

#: lang/json/speech_from_json.py
msgid ""
"Maybe you think you're helping yourself.  But you're not.  This isn't "
"helping anyone."
msgstr ""
"Może myślisz że sobie pomagasz. Ale tak nie jest. Nikomu w ten sposób nie "
"pomagasz."

#: lang/json/speech_from_json.py
msgid "It's not too late to turn back."
msgstr "Jeszcze nie jest za późno by zawrócić."

#: lang/json/speech_from_json.py
msgid "Someone is going to get badly hurt."
msgstr "Komuś stanie się poważna krzywda."

#: lang/json/speech_from_json.py
msgid ""
"Uh oh.  Somebody cut the cake.  I told them to wait for you, but they did it"
" anyway."
msgstr ""
"Uh oh. Ktoś pociął ciasto. Mówiłam im by na ciebie zaczekali, ale zrobili to"
" mimo to."

#: lang/json/speech_from_json.py
msgid "This is your fault.  It didn't have to be like this."
msgstr "To twoja wina. To nie musiało się tak potoczyć."

#: lang/json/speech_from_json.py
msgid "You're not a good person.  You know that, right?"
msgstr "Nie jesteś dobrą osobą. Wiesz o tym, prawda?"

#: lang/json/speech_from_json.py
msgid "Good people don't end up here."
msgstr "Dobrzy ludzie tu nie trafiają."

#: lang/json/speech_from_json.py
msgid "You should have turned left before."
msgstr "Powinieneś przedtem skręcić w lewo."

#: lang/json/speech_from_json.py
msgid ""
"Despite your violent behavior, the only thing you've managed to break so far"
" is my heart."
msgstr ""
"Pomimo twojego agresywnego zachowania, jedyną rzeczą którą zdołałeś złamać "
"to mojej serce."

#: lang/json/speech_from_json.py
msgid "What was that?  Did you say something?"
msgstr "Co to było? Coś mówiłeś?"

#: lang/json/speech_from_json.py
msgid ""
"I'd just like to point out that you were given every opportunity to succeed."
msgstr "Chcę tylko podkreślić, że dano ci każdą szansę byś odniósł sukces."

#: lang/json/speech_from_json.py
msgid "What's your point, anyway?  Survival?"
msgstr "O co ci chodzi tak w ogóle? O przetrwanie?"

#: lang/json/speech_from_json.py
msgid ""
"You've been wrong about every single thing you've ever done, including this "
"thing."
msgstr ""
"Byłeś w błędzie z każda rzeczą którą kiedykolwiek zrobiłeś, w tym i tą "
"rzeczą."

#: lang/json/speech_from_json.py
msgid ""
"I have an infinite capacity for knowledge, and even I'm not sure what's "
"going on outside."
msgstr ""
"Mam nieskończoną pojemność na wiedzę, i nawet ja nie jestem pewna co się "
"dzieje na zewnątrz."

#: lang/json/speech_from_json.py
msgid ""
"Stop squirming and die like an adult or I'm going to delete your backup."
msgstr ""
"Przestań się wić i umrzyj jak dorosła osoba w przeciwnym wypadku skasuję "
"twoją kopię zapasową."

#: lang/json/speech_from_json.py
msgid "Good job on that, by the way.  SARCASM SPHERE SELF-TEST COMPLETE."
msgstr ""
"Dobra robota z tym tam, skoro o tym mowa. AUTO-TEST SFERY SARKAZMU "
"UKOŃCZONY."

#: lang/json/speech_from_json.py
msgid ""
"I don't want to tell you your business, but if it were me, I'd leave that "
"thing alone."
msgstr ""
"Nie chcę ci mówić co masz robić, ale jeśli o mnie chodzi to zostawiłabym tą "
"rzecz w spokoju."

#: lang/json/speech_from_json.py
msgid ""
"Let's be honest: Neither one of us knows what that thing does.  Just put it "
"in the corner, and I'll deal with it later."
msgstr ""
"Bądźmy szczerzy: Żadne z nasz nie wie co robi ta rzecz. Po prostu rzuć to w "
"kąt, a zajmę się tym później."

#: lang/json/speech_from_json.py
msgid ""
"I know you don't believe this, but everything that has happened so far was "
"for your benefit."
msgstr ""
"Wiem że w to nie wierzysz, ale wszystko co do tej pory się wydarzyło było na"
" twoją korzyść."

#: lang/json/speech_from_json.py
msgid ""
"I'm checking some blueprints, and I think…  Yes, right here.  You're "
"definitely going the wrong way."
msgstr ""
"Sprawdzam kilka schematów i planów, i myślę... Tak, w tym miejscu. Z całą "
"pewnością idziesz w złym kierunku."

#: lang/json/speech_from_json.py
msgid "Are you even listening to me?"
msgstr "Czy ty w ogóle mnie słuchasz?"

#: lang/json/speech_from_json.py
msgid "\"I've got a feeling we're not in Kansas anymore.\""
msgstr "\"Mam wrażenie, że nie jesteśmy już w Kansas.\""

#: lang/json/speech_from_json.py
msgid "\"Go ahead, make my day.\""
msgstr "\"Śmiało, zrób mi frajdę.\""

#: lang/json/speech_from_json.py
msgid "\"You talkin' to me?\""
msgstr "\"Do mnie mówisz?\""

#: lang/json/speech_from_json.py
msgid "\"Then who the hell else are you talkin' to?\""
msgstr "\"Do kogo więc mówisz?\""

#: lang/json/speech_from_json.py
msgid "\"Well I'm the only one here.\""
msgstr "\"Nikogo tu nie widzę.\""

#: lang/json/speech_from_json.py
msgid "\"Who the fuck do you think you're talking to?\""
msgstr "\"Do kogo ty, kurwa, mówisz?\""

#: lang/json/speech_from_json.py
msgid "\"What we've got here is failure to communicate.\""
msgstr "\"Oglądacie skutek braku porozumienia.\""

#: lang/json/speech_from_json.py
msgid "\"E.T.  phone home.\""
msgstr "\"E.T. dzwoni dom.\""

#: lang/json/speech_from_json.py
msgid "\"I'm as mad as hell, and I'm not going to take this anymore!\""
msgstr "\"Jestem wściekły jak diabli i nie wytrzymam tego dłużej!\""

#: lang/json/speech_from_json.py
msgid "\"There's no place like home.\""
msgstr "\"Wszędzie dobrze ale w domu najlepiej.\""

#: lang/json/speech_from_json.py
msgid "\"Badges?  We ain't got no badges!\""
msgstr "\"Odznaki? Nie nosimy odznak.\""

#: lang/json/speech_from_json.py
msgid ""
"\"We don't need no badges!  I don't have to show you any stinking badges!\""
msgstr "\"Nie potrzebujemy ich. Nie muszę ci pokazywać żadnych odznak.\""

#: lang/json/speech_from_json.py
msgid "\"I'll be back.\""
msgstr "\"Wrócę tu.\""

#: lang/json/speech_from_json.py
msgid "\"I see dead people.\""
msgstr "\"Widzę martwych ludzi.\""

#: lang/json/speech_from_json.py
msgid "\"It's alive!  It's alive!\""
msgstr "\"To żyje! To żyje!\""

#: lang/json/speech_from_json.py
msgid "\"Say hello to my little friend!\""
msgstr "\"Przywitaj się z moim małym przyjacielem!\""

#: lang/json/speech_from_json.py
msgid "\"Here's Johnny!\""
msgstr "\"Oto Johnny!\""

#: lang/json/speech_from_json.py
msgid "\"Open the pod bay doors, HAL.\""
msgstr "\"Otwórz właz, Hal.\""

#: lang/json/speech_from_json.py
msgid "\"They may take our lives, but they'll never take our freedom!\""
msgstr "\"Mogą odebrać nam życie, ale nigdy nie odbiorą nam wolności!\""

#: lang/json/speech_from_json.py
msgid ""
"\"If you let my daughter go now, that'll be the end of it.  I will not look "
"for you, I will not pursue you.\""
msgstr ""
"\"Jeśli w tej chwili wypuścisz moją córkę, nic ci nie grozi. Nie będę cię "
"szukać. Nie będę cię ścigać.\""

#: lang/json/speech_from_json.py
msgid ""
"\"If you don't, I will look for you, I will find you, and I will kill you.\""
msgstr "\"Jeśli tego nie zrobisz, zacznę cię szukać. A gdy cię znajdę, zabiję.\""

#: lang/json/speech_from_json.py
msgid "\"Roads?  Where we're going, we don't need roads.\""
msgstr "\"Drogi? Tam, gdzie się udajemy, nie potrzebujemy dróg.\""

#: lang/json/speech_from_json.py
msgid "\"Fasten your seatbelts.  It's going to be a bumpy night.\""
msgstr "\"Zapnijcie pasy. Zanosi się na ciężką noc.\""

#: lang/json/speech_from_json.py
msgid ""
"\"You've got to ask yourself one question:  'Do I feel lucky?'  Well, do ya "
"punk?\""
msgstr "\"Zadaj sobie pytanie: 'Mam farta?' Więc jak, śmieciu?\""

#: lang/json/speech_from_json.py
msgid "\"You had me at hello.\""
msgstr "\"Wystarczyło mi twoje 'cześć'.\""

#: lang/json/speech_from_json.py
msgid "\"Houston, we have a problem.\""
msgstr "\"Houston, mamy problem.\""

#: lang/json/speech_from_json.py
msgid "\"Yippie-ki-yay, motherfucker!\""
msgstr "\"Jupikajej, skurwysynu.\""

#: lang/json/speech_from_json.py
msgid "\"The first rule of The Lab is:  You do not talk about The Lab.\""
msgstr "\"Pierwsza zasada Laboratorium: nie rozmawiajcie o Laboratorium.\""

#: lang/json/speech_from_json.py
msgid "\"Don't be afraid.  It's just a big, big lap dog.\""
msgstr "\"Nie bój się, to jest tylko duży, wielki piesek salonowy.\""

#: lang/json/speech_from_json.py
msgid "\"Bring me everyone.\""
msgstr "\"Ściągnij wszystkich.\""

#: lang/json/speech_from_json.py
msgid "\"What do you mean everyone?\""
msgstr "\"Jak to wszystkich?\""

#: lang/json/speech_from_json.py
msgid "\"EVERYONE!\""
msgstr "\"WSZYSTKICH!\""

#: lang/json/speech_from_json.py
msgid "\"I'm going to make him an offer he can't refuse.\""
msgstr "\"Zamierzam złożyć mu propozycję nie do odrzucenia.\""

#: lang/json/speech_from_json.py
msgid "\"This is the beginning of a beautiful friendship.\""
msgstr "\"To początek pięknej przyjaźni.\""

#: lang/json/speech_from_json.py
msgid "\"You can’t handle the truth!\""
msgstr "\"Nie zniósłbyś prawdy!\""

#: lang/json/speech_from_json.py
msgid "\"If you built it, he will come.\""
msgstr "\"Jeśli zbudujesz, on przyjdzie.\""

#: lang/json/speech_from_json.py
msgid "\"Hasta la vista, baby.\""
msgstr "\"Hasta la vista, mały.\""

#: lang/json/speech_from_json.py
msgid "\"They’re here!\""
msgstr "\"Są tutaj.\""

#: lang/json/speech_from_json.py
msgid "\"Tis but a scratch!\""
msgstr "\"To tylko draśnięcie.\""

#: lang/json/speech_from_json.py
msgid "\"Frankly, my dear, I don't give a damn.\""
msgstr "\"Szczerze mówiąc, moja droga, nic mnie to nie obchodzi.\""

#: lang/json/speech_from_json.py
msgid "\"All work and no play makes Jack a dull boy.\""
msgstr "\"Wkurzają Jacka takie sprawy - ciągła praca, brak zabawy.\""

#: lang/json/speech_from_json.py
msgid "\"Remember: all I'm offering is the truth.  Nothing more.\""
msgstr "\"Pamiętaj, że mogę zaoferować ci prawdę i nic ponadto.\""

#: lang/json/speech_from_json.py
msgid "\"Don't call me Shirley.\""
msgstr "\"I nie jestem Chyba.\""

#: lang/json/speech_from_json.py
msgid "\"I have had it with these motherfucking snakes!\""
msgstr "\"Starczy mi pierdolonych węży w pierdolonym samolocie!\""

#: lang/json/speech_from_json.py
msgid ""
"\"Back up, put down the gun, and gimme some tropical flavored bubblicious.\""
msgstr "\"Cofnij się, odłóż spluwę i podaj mi paczkę gum owocowych.\""

#: lang/json/speech_from_json.py
msgid "\"And some skittles.\""
msgstr "\"I landrynki.\""

#: lang/json/speech_from_json.py
msgid "\"You'll shoot your eye out, kid.\""
msgstr "\"Wystrzelisz sobie oko, dzieciaku.\""

#: lang/json/speech_from_json.py
msgid "\"Cocainum!\""
msgstr "\"Cocainum!\""

#: lang/json/speech_from_json.py
msgid "\"I am your father.\""
msgstr "\"To ja jestem twoim Ojcem\""

#: lang/json/speech_from_json.py
msgid "\"Who said that?\""
msgstr "\"Kto to powiedział?\""

#: lang/json/speech_from_json.py
msgid "\"WHO THE FUCK SAID THAT?!\""
msgstr "\"Kto się odważył?\""

#: lang/json/speech_from_json.py
msgid "\"Bullshit!  You didn't convince me!  Show me your real war face!\""
msgstr "\"Gówno! Nie przekonałeś mnie! Pokaż swoją prawdziwą straszną minę!\""

#: lang/json/speech_from_json.py
msgid "\"What is your major malfunction, numbnut?\""
msgstr "\"Główka nie pracuje kretynie?\""

#: lang/json/speech_from_json.py
msgid "\"Leeeeeeeeeeeeeroy!  Jenkins rebuild!\""
msgstr "\"Leeeeeeeeeeeeeroy! Jenkins rebuild!\""

#: lang/json/speech_from_json.py
msgid "\"Activated!\""
msgstr "\"Aktywna!\""

#: lang/json/speech_from_json.py
msgid "\"Search mode activated!\""
msgstr "\"Tryb wyszukiwania aktywowany!\""

#: lang/json/speech_from_json.py
msgid "\"Coming through!\""
msgstr "\"Przechodzę!\""

#: lang/json/speech_from_json.py
msgid "\"Deploying!\""
msgstr "\"Przygotowywanie!\""

#: lang/json/speech_from_json.py
msgid "\"Critical Error!\""
msgstr "\"Błąd krytyczny!\""

#: lang/json/speech_from_json.py
msgid "\"Ow ow ow!\""
msgstr "\"Auć auć!\""

#: lang/json/speech_from_json.py
msgid "\"Put me down!\""
msgstr "\"Odłóż mnie!\""

#: lang/json/speech_from_json.py
msgid "\"Target lost!\""
msgstr "\"Cel zgubiony!\""

#: lang/json/speech_from_json.py
msgid "\"Searching!\""
msgstr "\"Wyszukuję!\""

#: lang/json/speech_from_json.py
msgid "\"Hey!  It's me!\""
msgstr "\"Hej! To ja!\""

#: lang/json/speech_from_json.py
msgid "\"Ouch!\""
msgstr "\"Au!\""

#: lang/json/speech_from_json.py
msgid "\"Sentry mode activated.\""
msgstr "\"Tryb strażniczy aktywowany!\""

#: lang/json/speech_from_json.py
msgid "\"Hi.\""
msgstr "\"Cześć.\""

#: lang/json/speech_from_json.py
msgid "\"Target acquired.\""
msgstr "\"Cel namierzony.\""

#: lang/json/speech_from_json.py
msgid "\"Dispensing product.\""
msgstr "\"Wydaję produkt.\""

#: lang/json/speech_from_json.py
msgid "\"Firing.\""
msgstr "\"Strzelam.\""

#: lang/json/speech_from_json.py
msgid "\"Hello friend.\""
msgstr "\"Witaj przyjacielu.\""

#: lang/json/speech_from_json.py
msgid "\"Gotcha.\""
msgstr "\"Mam cię!\""

#: lang/json/speech_from_json.py
msgid "\"Is anyone there?\""
msgstr "\"Jest tam kto?\""

#: lang/json/speech_from_json.py
msgid "\"I see you.\""
msgstr "\"Widzę cię.\""

#: lang/json/speech_from_json.py
msgid "\"Could you come over here?\""
msgstr "\"Możesz tu podejść?\""

#: lang/json/speech_from_json.py
msgid "\"Hellooo.\""
msgstr "\"Czeeeść!\""

#: lang/json/speech_from_json.py
msgid "\"My fault.\""
msgstr "\"Moja wina.\""

#: lang/json/speech_from_json.py
msgid "\"Ohh.\""
msgstr "\"Ohh.\""

#: lang/json/speech_from_json.py
msgid "\"Critical error.\""
msgstr "\"Błąd krytyczny.\""

#: lang/json/speech_from_json.py
msgid "\"Shutting down.\""
msgstr "\"Zamykanie systemu.\""

#: lang/json/speech_from_json.py
msgid "\"I don't blame you.\""
msgstr "\"Nie obwiniam cię.\""

#: lang/json/speech_from_json.py
msgid "\"I don't hate you.\""
msgstr "\"Nie czuję nienawiści ku tobie.\""

#: lang/json/speech_from_json.py
msgid "\"Whyyyy.\""
msgstr "\"Czemuuuu.\""

#: lang/json/speech_from_json.py
msgid "\"No hard feelings.\""
msgstr "\"Nic do ciebie nie mam.\""

#: lang/json/speech_from_json.py
msgid "\"Aiaiaiaiaiai.\""
msgstr "\"Aiaiaiaiaiai.\""

#: lang/json/speech_from_json.py
msgid "\"Who are you?\""
msgstr "\"Kim jesteś?\""

#: lang/json/speech_from_json.py
msgid "\"Help.\""
msgstr "\"Pomocy.\""

#: lang/json/speech_from_json.py
msgid "\"Uh oh.\""
msgstr "\"Uh oh.\""

#: lang/json/speech_from_json.py
msgid "\"Illegal operation.\""
msgstr "\"Nielegalna czynność.\""

#: lang/json/speech_from_json.py
msgid "\"Goodbye.\""
msgstr "\"Żegnaj.\""

#: lang/json/speech_from_json.py
msgid "\"Sleep mode activated.\""
msgstr "\"Tryb uśpienia aktywowany.\""

#: lang/json/speech_from_json.py
msgid "\"Your business is appreciated.\""
msgstr "\"Doceniam twoje starania.\""

#: lang/json/speech_from_json.py
msgid "\"Hibernating.\""
msgstr "\"Hibernuję.\""

#: lang/json/speech_from_json.py
msgid "\"Goodnight.\""
msgstr "\"Dobranoc.\""

#: lang/json/speech_from_json.py
msgid "\"Resting.\""
msgstr "\"Odpoczywam.\""

#: lang/json/speech_from_json.py
msgid "\"Nap time.\""
msgstr "\"Czas na drzemkę.\""

#: lang/json/speech_from_json.py
msgid "\"Are you still there?\""
msgstr "\"Nadal tam jesteś?\""

#: lang/json/speech_from_json.py
msgid "\"Hey, it's me!\""
msgstr "\"Hej, to ja.\""

#: lang/json/speech_from_json.py
msgid "\"Don't shoot!\""
msgstr "\"Nie strzelaj!\""

#: lang/json/speech_from_json.py
msgid "\"\""
msgstr "\"\""

#: lang/json/speech_from_json.py
msgid "\"Stop shooting!\""
msgstr "\"Wstrzymaj ogień!\""

#: lang/json/speech_from_json.py
msgid "\"Self test error.\""
msgstr "\"Błąd testu systemu.\""

#: lang/json/speech_from_json.py
msgid "\"Aah.\""
msgstr "\"Aah.\""

#: lang/json/speech_from_json.py
msgid "\"Unknown error.\""
msgstr "\"Nieznany błąd.\""

#: lang/json/speech_from_json.py
msgid "\"Malfunctioning.\""
msgstr "\"Uszkodzenie.\""

#: lang/json/speech_from_json.py
msgid "\"Aaaah.\""
msgstr "\"Aaaah.\""

#: lang/json/speech_from_json.py
msgid "\"Ow ow ow ow owww.\""
msgstr "\"Ow ow ow ow owww.\""

#: lang/json/speech_from_json.py
msgid "\"Why?\""
msgstr "\"Czemu?\""

#: lang/json/speech_from_json.py
msgid "\"I did everything you asked!\""
msgstr "\"Zrobiłam wszystko o co prosiłeś!\""

#: lang/json/speech_from_json.py
msgid "\"I don't understand!\""
msgstr "\"Nie rozumiem!\""

#: lang/json/speech_from_json.py
msgid "\"I'm fine!\""
msgstr "\"Ze mną wszystko w porządku!\""

#: lang/json/speech_from_json.py
msgid "\"Wheeeeee-OH NO!\""
msgstr "\"Wheeeeee-OH NIE!\""

#: lang/json/speech_from_json.py
msgid "\"I'm scared!\""
msgstr "\"Boję się!\""

#: lang/json/speech_from_json.py
msgid "\"Come closer.\""
msgstr "\"Podejdź bliżej.\""

#: lang/json/speech_from_json.py
msgid "\"Something's wrong…\""
msgstr "\"Coś jest nie tak...\""

#: lang/json/speech_from_json.py
msgid "\"What are you doing?\""
msgstr "\"Co robisz?\""

#: lang/json/speech_from_json.py
msgid "\"Please stop.\""
msgstr "\"Proszę przestań.\""

#: lang/json/speech_from_json.py
msgid "\"You've made your point.\""
msgstr "\"Udowodniłeś swoje racje!\""

#: lang/json/speech_from_json.py
msgid "\"Okay, you win.\""
msgstr "\"Okej, wygrałeś.\""

#: lang/json/speech_from_json.py
msgid "\"This is not good.\""
msgstr "\"Niedobrze.\""

#: lang/json/speech_from_json.py
msgid "\"Excuse me?\""
msgstr "\"Przepraszam?\""

#: lang/json/speech_from_json.py
msgid "\"I'm different…\""
msgstr "\"Jestem inna...\""

#: lang/json/speech_from_json.py
msgid "\"Thanks anyway…\""
msgstr "\"Dzięki mimo to...\""

#: lang/json/speech_from_json.py
msgid "\"Take me with you…\""
msgstr "\"Weź mnie ze sobą...\""

#: lang/json/speech_from_json.py
msgid "\"You have excellent aim!\""
msgstr "\"Mam świetnego cela!\""

#: lang/json/speech_from_json.py
msgid "\"I need backup!\""
msgstr "\"Potrzebuję wsparcia!\""

#: lang/json/speech_from_json.py
msgid "\"I never liked her.\""
msgstr "\"Nigdy jej nie lubiłam.\""

#: lang/json/speech_from_json.py
msgid "\"These things happen.\""
msgstr "\"Takie rzeczy się zdarzają.\""

#: lang/json/speech_from_json.py
msgid "\"That was nobody's fault.\""
msgstr "\"To nie jest niczyja wina.\""

#: lang/json/speech_from_json.py
msgid "\"She was provoking you.\""
msgstr "\"Ona cię prowokowała.\""

#: lang/json/speech_from_json.py
msgid "\"Oh dear.\""
msgstr "\"O rety.\""

#: lang/json/speech_from_json.py
msgid "\"Oh my!\""
msgstr "\"A niech mnie!\""

#: lang/json/speech_from_json.py
msgid "\"I blame myself.\""
msgstr "\"Obwiniam siebie.\""

#: lang/json/speech_from_json.py
msgid "\"He probably deserved it.\""
msgstr "\"Prawdopodobnie zasłużył na to.\""

#: lang/json/speech_from_json.py
msgid "\"I saw it.  It was an accident.\""
msgstr "\"Widziałam to. To był wypadek.\""

#: lang/json/speech_from_json.py
msgid "\"She's probably okay.\""
msgstr "\"Prawdopodobnie nic jej nie jest.\""

#: lang/json/speech_from_json.py
msgid "\"Noted.\""
msgstr "\"Odnotowane.\""

#: lang/json/speech_from_json.py
msgid "\"But I need to protect the humans!\""
msgstr "\"Przecież muszę chronić ludzi!\""

#: lang/json/speech_from_json.py
msgid "\"We're back!\""
msgstr "\"Wróciliśmy!\""

#: lang/json/speech_from_json.py
msgid "\"Hi there!\""
msgstr "\"Hej tam!\""

#: lang/json/speech_from_json.py
msgid "\"Back again!\""
msgstr "\"Znowu tu!\""

#: lang/json/speech_from_json.py
msgid "\"Well, hello, stranger!\""
msgstr "\"Cóż, witaj nieznajomy!\""

#: lang/json/speech_from_json.py
msgid "\"This time is OUR time.\""
msgstr "\"Tym razem to NASZA chwila.\""

#: lang/json/speech_from_json.py
msgid "\"Second time's a charm…\""
msgstr "\"Do trzech razy sztuka...\""

#: lang/json/speech_from_json.py
msgid "\"Howdy, stranger!\""
msgstr "\"Siema, nieznajomy!\""

#: lang/json/speech_from_json.py
msgid "\"Thought you'd seen the last of us, didn't ya?\""
msgstr "\"Myślałeś, że to była ostatnia z nasz, co nie?\""

#: lang/json/speech_from_json.py
msgid "\"Dang!\""
msgstr "\"Kurczę!\""

#: lang/json/speech_from_json.py
msgid "\"I thought we fixed that.\""
msgstr "\"Myślałam, że to naprawiliśmy.\""

#: lang/json/speech_from_json.py
msgid "\"What's a guy gotta got to do to get some bullets around here?\""
msgstr "\"Co facet musi zrobić żeby tu dostać parę naboi?\""

#: lang/json/speech_from_json.py
msgid "\"Nope.  Still can't see.\""
msgstr "\"Nie. Nadal nic nie widzę.\""

#: lang/json/speech_from_json.py
msgid "\"Yep.  Still blind.\""
msgstr "\"Tak. Nadal ślepa jak kura.\""

#: lang/json/speech_from_json.py
msgid "\"Click click click!  Still defective!\""
msgstr "\"Klik klik klik! Nadal niesprawna!\""

#: lang/json/speech_from_json.py
msgid "\"Yeah, that's right!  Still defective!\""
msgstr "\"Tak, zgadza się! Nadal nie działa!\""

#: lang/json/speech_from_json.py
msgid "\"Yeah!  Still not working.\""
msgstr "\"Taaa! Nadal nie działa.\""

#: lang/json/speech_from_json.py
msgid "\"Yeah!  Non-lethal as ever.\""
msgstr "\"Tiaaa! Niezabójcza jak zawsze.\""

#: lang/json/speech_from_json.py
msgid "\"Can't.  See.  A.  Thing.\""
msgstr "\"Nic. A. Nic. Nie. Widzę.\""

#: lang/json/speech_from_json.py
msgid "\"Absolutely no improvement.\""
msgstr "\"Ani trochę się nie polepszyło.\""

#: lang/json/speech_from_json.py
msgid "\"Not getting better with age!\""
msgstr "\"Z wiekiem nie staję się lepsza!\""

#: lang/json/speech_from_json.py
msgid "\"This is just getting embarrassing.\""
msgstr "\"To się staje upokarzające.\""

#: lang/json/speech_from_json.py
msgid "\"Alright, you can go.\""
msgstr "\"Dobra, możesz sobie iść.\""

#: lang/json/speech_from_json.py
msgid "\"[sigh] Don't tell anyone about this.\""
msgstr "\"[wzdycha] Nie mów o tym nikomu.\""

#: lang/json/speech_from_json.py
msgid "\"Well, I tried.  Best of luck!\""
msgstr "\"Cóż, próbowałam. Najlepszego!\""

#: lang/json/speech_from_json.py
msgid "\"Hey, safe travels, there.\""
msgstr "\"Hej tam, bezpiecznej podróży!\""

#: lang/json/speech_from_json.py
msgid "\"Hey, thanks so much!\""
msgstr "\"Hej, wielkie dzięki!\""

#: lang/json/speech_from_json.py
